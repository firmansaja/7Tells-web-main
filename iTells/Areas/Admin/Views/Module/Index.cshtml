
@{
    ViewBag.Title = "Module List";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "";
}


<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header">
                <input type="button" class="btn-bootstrap-dialog btn btn-info pull-right" title="Add Module" data-url="/admin/module/create" value="Add Module" data-toggle="modal" />
            </div>
            <div id="divModule">
                @{Html.RenderAction("PopulateModule", "Module");}
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="bootstrapDialog" role="dialog" aria-labelledby="myModal-label" aria-hidden="true">

</div>
@section scripts{
    <script src="~/scripts/Common.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script>
        $(document).ready(function () {
            //$("#tblModule").DataTable();  
            Datatable();
        });

        //function DataTable() {
        //    $('#table').DataTable({
        //        "paging": true,
        //        "lengthChange": true,
        //        "searching": true,
        //        "ordering": true,
        //        "info": true,
        //        "autoWidth": false
        //    });
        //}
        function Datatable() {
            $("#tblModule").DataTable({
                destroy: true
            });
        }
        var datatable = $("#tblModule").DataTable({
            destroy: true
        });

        toastr.options = {
            "positionClass": "toast-top-center",
            "timeOut": "2000",
            "preventDuplicates": true,
            "closeButton": true,
            "progressBar": true
        }

        function CreateSuccess(data) {
            if (data.status == "1") {
                $('#bootstrapDialog').modal('hide');
                $('#divModule').load("/Admin/Module/PopulateModule")
                //$('#tblModule').Datatable().load(data.url);
                //$("#divModule").html(data.responseText);
                toastr.success(data.message);
                return Datatable();
            }
        }

        $(document).on('click', '.delete', function (e) {
            e.preventDefault();
            var url = $(this).data('url');
            $.get(url, function (data) {
                if (data.success == "0") {
                    //$('#tblModule').load(data.url);
                    //$("#tblModule").DataTable();
                    $('#divModule').load("/Admin/Module/PopulateModule")
                    toastr.success(data.message);
                    return Datatable()
                }
                else if (data.success == "3") {
                    toastr.success(data.message);
                }
            });
            return false;
        });

    </script>
}