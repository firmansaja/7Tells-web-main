@using iTells.Helpers
@{
    string pageUrl = Request.Url.PathAndQuery.ToString();
}
<aside class="main-sidebar">
    <!-- sidebar: style can be found in sidebar.less -->
    <section class="sidebar">
        <!-- Sidebar user panel -->
        <div class="user-panel">
            <div class="pull-left image">
                <img src="~/AdminLTE/dist/img/avatar5.png" err-src="~/AdminLTE/dist/img/avatar5.png" style="height:50px;" class="img-circle" alt="User Image">
            </div>
            <div class="pull-left info">
                @*<p>@ViewBag.UserName</p>*@
                <a href="#"><i class="fa fa-circle text-success"></i> Online</a>
            </div>
        </div>
        <div>
            <ul class="sidebar-menu">
                <li class="header">MAIN NAVIGATION</li>
                @Html.Raw(ViewBag.MenuList)
                @if (ViewBag.IsAdmin == true)
                {
                    <li class="header">ADMIN MENU</li>
                    @*<li id="user"><a href="/admin/user"><i class="fa fa-users"></i> <span>User</span></a></li>*@
                    <li class="@(pageUrl.ToLower().Contains("/admin/user/indexuser") ? "active" : string.Empty)"><a href="/admin/user/IndexUser"><i class="fa fa-user"></i> <span>User Role</span></a></li>
                    <li class="@(pageUrl.ToLower().Contains("/admin/role") ? "active" : string.Empty)"><a href="/admin/role"><i class="fa fa-registered"></i> <span>Role</span></a></li>
                    <li class="@(pageUrl.ToLower().Contains("/admin/module") ? "active" : string.Empty)"><a href="/admin/module"><i class="fa fa-server"></i> <span>Module</span></a></li>
                    <li class="@(pageUrl.ToLower().Contains("/admin/setting") ? "active" : string.Empty)"><a href="/admin/setting"><i class="fa fa-gear"></i> <span>Setting</span></a></li>
                    <li class="@(pageUrl.ToLower().Contains("/modules") ? "active" : string.Empty)"><a href="/modules"><i class="fa fa-folder-o"></i> <span>Module 1</span></a></li>
                    <li class="@(pageUrl.ToLower().Contains("/npp") ? "active" : string.Empty)"><a href="/npp"><i class="fa fa-folder-o"></i> <span>Module 1</span></a></li>
                }
            </ul>
        </div>
    </section>
    <!-- /.sidebar -->
</aside>