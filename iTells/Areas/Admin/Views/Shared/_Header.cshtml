<header class="main-header">
    <!-- Logo -->
    <a href="#" class="logo">
        <img src="~/images/7Tells.ico" err-src="~/images/7Tells.ico" class="user-image" alt="User Image" style="width:50px;height:50px;display: block;
                    margin-left: auto;
                    margin-right: auto;">
        <span class="logo-mini"></span>
    </a>
        @*@ViewBag.Name*@
        @*<span class="logo-mini"></span>
        <span class="logo-lg"><b>@ViewBag.Name</b></span>*@
    
    <nav class="navbar navbar-static-top" role="navigation">
        <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
            <span class="sr-only">Toggle navigation</span> &nbsp;&nbsp;&nbsp;<span style="font-size:medium; font-family: Helvetica Neue, Helvetica, Arial, sans-serif">@System.Configuration.ConfigurationManager.AppSettings["ReportTitle"]</span>
            @*<span class="sr-only">Toggle navigation</span> &nbsp;&nbsp;&nbsp;<span style="font-size:medium; font-family: Helvetica Neue, Helvetica, Arial, sans-serif">@System.Configuration.ConfigurationManager.AppSettings["ReportTitle"]</span>*@
        </a>
        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <img src="~/AdminLTE/dist/img/avatar5.png" err-src="~/AdminLTE/dist/img/avatar5.png" class="user-image" alt="User Image">
                        <span class="hidden-xs">@ViewBag.UserName</span>
                    </a>
                    <ul class="dropdown-menu">
                        <!-- User image -->
                        <li class="user-header">
                            <img src="~/AdminLTE/dist/img/avatar5.png" err-src="~/AdminLTE/dist/img/avatar5.png" class="img-circle" alt="User Image">
                            <p>
                                @ViewBag.UserName
                                <small>Member since @ViewBag.RegisterDate</small>
                            </p>
                        </li>
                        <!-- Menu Footer-->
                        <li class="user-footer">
                            <div class="pull-left">
                                <a href="/admin/user/profile?ID=@ViewBag.UserID" class="btn btn-default btn-flat">Profile</a>
                            </div>
                            <div class="pull-right">
                                <a href="/Account/LogOut" class="btn btn-default btn-flat">Sign Out</a>
                            </div>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>
    </nav>
</header>