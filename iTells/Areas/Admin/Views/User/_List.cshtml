@model IEnumerable<iTells.Models.tblUser>
@{
    iTells.Helper.GeneralHelper dHelper = new iTells.Helper.GeneralHelper();
}
<div class="box-body">
    <span id="message"></span>
    @Html.Raw(ViewBag.Message)
    <table id="tblUser" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>UserName</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Register Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.UserName</td>
                    <td>
                        @item.FirstName  @item.LastName
                    </td>
                    <td>@item.Email</td>
                    <td>@dHelper.GerRoleName(item.RoleID)</td>
                    <td>@item.InsertDate</td>
                    <td>
                        @if (item.IsActive == true)
                        {
                            <a id="@item.ID" href="" class="updateStatus btn label-success btn-xs" data-url="/admin/user/updateStatus/@item.ID">Active</a>
                        }
                        else
                        {
                            <a id="@item.ID" href="" class="updateStatus btn label-danger btn-xs" data-url="/admin/user/updateStatus/@item.ID">InActive</a>
                        }
                    </td>
                    <td>
                        @if (ViewBag.IsEdit == true)
                        {
                            <a href="/admin/user/edit?ID=@item.ID" class="btn btn-primary btn-xs">Edit</a>
                        }
                        @if (ViewBag.IsDelete == true)
                        {
                            <a data-url="/admin/user/delete/@item.ID" class="delete btn btn-warning btn-xs">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

