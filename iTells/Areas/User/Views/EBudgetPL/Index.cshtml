@using BusinessObjects;
@model List<BO_EBudgetPL>
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int i = 0;
}
<div class="box box-primary">
    <div class="box-body">
        <div class="row">
            <div class="col-md-12">
                @*<div class="box ">*@
                <table id="LB" class="table table-bordered">
                    <thead>
                        <tr>
                            <th width="50px"; class="text-center">ID</th>
                            <th width="50px";class="text-center">Urut</th>
                            <th width="100px"; class="text-center">No Acct</th>
                            <th class="text-center">Nama Account</th>
                            <th class="text-center">Tipe</th>
                            <th class="text-center" width="200px">Penjumlahan</th>
                            <th class="text-center" width="100px">Pengurangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            i++;
                            <tr>
                                @*<td class="text-center">  @i</td>*@
                                <td width="50px"; style="text-align:center; vertical-align:middle" > @item.No_Urut</td>
                                <td width="50px"; style="text-align:center; vertical-align:middle"> @item.Urut_Tampil</td>
                                <td width="100px"; style="text-align:center; vertical-align:middle"> @item.AcctID</td>
                                <td style="text-align:left; vertical-align:middle"> @item.Ket</td>
                                <td style="text-align:center; vertical-align:middle"> @item.Tipe</td>
                                <td width="200px"; style="word-wrap:break-word;white-space:pre-wrap"> @item.Tambah</td>
                                <td width="100px"; style="word-wrap:break-word;white-space:pre-wrap"> @item.Kurang</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

            $(document).ready(function () {
                $(document).ready(function () {
                    $('#LB').DataTable({
                        //"destroy": true,
                        //scrollY: "350px",
                        //scrollX: true,
                        //scrollCollapse: true,
                        //autoWidth: false,
                        //paging: false,
                        //search: false,
                        //responsive:true,
                        //columnDefs: [
                        //    { width: 200, targets: 0 }
                        //],
                        //fixedColumns: true,
                        //fixedColumns: {
                        //    leftColumns: 2
                        //}

                        scrollY: "700px",
                        scrollX: true,
                        scrollCollapse: true,
                        paging: false,
                        autoWidth: true,
                        filter: false,
                        info: false
                        //fixedColumns: true

                    });
                })
            })
    </script>
}




