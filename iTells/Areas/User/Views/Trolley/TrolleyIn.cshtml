        });

        $(document).on('keyup', '#txtBarcode', function (event) {
            event.preventDefault();
            //if ($('#txtBarcode').val() !== '' && this.value.length === 12) {
            //    AddTrolleyIn();

            //    $('#dtTgl').val(FormatDateTime('DD-MM-YYYY'));
            //    $('#txtJam').val(FormatDateTime('HH:mm:ss'));
            //}
        });

        $(document).on('keypress', '#txtBarcode', function () {                       
            if (event.key === "Enter") {
                event.preventDefault();
                AddTrolleyIn();

                $('#dtTgl').val(FormatDateTime('DD-MM-YYYY'));
                $('#txtJam').val(FormatDateTime('HH:mm:ss'));
            }
        });

        $("#tblTrolleyIn").on('click', '.btnHapus', function () {
            $(this).closest('tr').remove();
        });

        function AddTrolleyIn() {
            var barcode = $('#txtBarcode').val();

            if (barcode !== '') {
                $.ajax({
                    url: '@Url.Action("CheckTrolley", "Trolley", new { area ="User"})',
                    dataType: "json",
                    type: "GET",
                    data: { kodeTrolley: barcode },
                    async: false,
                    success: function (data) {
                        if (!data.success) {
                            //alert(data.message)
                            PopupMessage(false, data.message);
                        } else {
                            var table = document.getElementById("tblTrolleyIn").getElementsByTagName('tbody')[0];
                            var rowCount = table.rows.length;

                            var isReady = false;

                            for (var i = 0; i < rowCount; i++) {
                                var kodeTrolley = table.rows[i].cells[1].textContent.trim();
                                if (kodeTrolley === barcode) {
                                    alert(`Kode trolley ${barcode} sudah ada!`);
                                    //PopupMessage(false, `Kode trolley ${barcode} sudah ada!`);
                                    $('#txtBarcode').focus();
                                    isReady = true;
                                    break;
                                }
                            }

                            if (!isReady) {
                                var newRow = table.insertRow(rowCount);
                                newRow.setAttribute("style", "text-align:center;vertical-align:middle");

                                var cNo = newRow.insertCell(0);
                                var cKodeTrolley = newRow.insertCell(1);
                                var cJenisTrolley = newRow.insertCell(2);
                                var cPilihan = newRow.insertCell(3);
                                //cNo.innerHTML = rowCount + 1;
                                cKodeTrolley.innerHTML = barcode;
                                cJenisTrolley.innerHTML = data.jenisTrolley;
                                cPilihan.innerHTML = '<button class="btn btn-xs btn-danger btnHapus" title="Hapus" style="margin-right:5px">Hapus</button>';
                            }
                        }
                        $('#txtBarcode').val('');
                    },
                    error: function (xhr) {
                        alert(xhr.responseText);
                    }
                });
            }
        }

        function SimpanTrolleyIn() {
            var TerimaDari = $("#txtTerimaDari").val();
            var NoMobil = $("#txtNoMobil").val();
            var NamaSupir = $("#txtNamaSupir").val();
            var table = document.getElementById("tblTrolleyIn").getElementsByTagName('tbody')[0];;
            var rowCount = table.rows.length;

            if (TerimaDari == "") {
                alert("Terima dari tidak boleh kosong!")
            } else if (NoMobil == "") {
                alert("No Mobil tidak boleh kosong!")
            } else if (NamaSupir == "") {
                alert("Nama supir tidak boleh kosong!")
            } else if (rowCount == 0) {
                alert("Data trolley tidak boleh kosong!")
            } else {
                if (confirm('Yakin ingin simpan data?')) {

                    var Details = [];
                    $("#tblTrolleyIn tbody tr").each(function () {
                        var currentRow = $(this);
                        var KodeTrolley = currentRow.find("td:eq(1)").text();
                        var JenisTrolley = currentRow.find("td:eq(2)").text();
                        var obj = {};
                        obj.NoTrans = "";
                        obj.KodeTrolley = KodeTrolley;
                        obj.JenisTrolley = JenisTrolley;

                        Details.push(obj);
                    });

                    $.ajax({
                        url: '@Url.Action("SimpanTrolleyInOut", "Trolley", new { area ="User"})',
                        dataType: "json",
                        type: "POST",
                        cache: false,
                        data: {
                            NoTrans: $('#txtNoTrans').val(),
                            InOut: "IN",
                            TglTrans: new Date().toISOString(),
                            CustId: $('#txtTerimaDari').val(),
                            NoMobil: $('#txtNoMobil').val(),
                            NamaSupir: $('#txtNamaSupir').val(),
                            Details: Details,
                        },
                        success: function (data) {
                            if (data.success) {
                                $("#txtTerimaDari").val('');
                                $("#txtNoMobil").val('');
                                $("#txtNamaSupir").val('');
                                $("#tblTrolleyIn").find("tr:gt(0)").remove();
                                PopupMessage(true, data.message);
                            } else {
                                PopupMessage(false, data.message);
                            }
                        },
                        error: function (xhr) {
                            alert(xhr.responseText);
                        }
                    });
                } else {
                    return false;
                }
            }
        }

        function PopupMessage(success, msg) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            })

            //Toast.fire({
            //    icon: 'success',
            //    title: msg
            //})
            if (success) {
                Toast.fire({
                    icon: 'success',
                    title: msg
                })
            } else {
                Toast.fire({
                    icon: 'error',
                    title: msg
                })
            }
        }

        function FormatDateTime(format) {
            const today = new Date();

            var datetime = moment(today).format(format)
            return datetime
        }

    </script>
