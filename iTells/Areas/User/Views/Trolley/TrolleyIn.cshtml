                    $('#txtNamaSupir').focus();
                } else if ($('#txtBarcode').val() === '') {
                    $('#txtBarcode').focus();
                }
            }
        });

        // Input no mobil
        $(document).on('focus', '#txtNoMobil', function (event) {
            event.preventDefault();
            $('#txtNoMobil').val('');
        });

        $(document).on('keyup', '#txtNoMobil', function (event) {    
            event.preventDefault();
            //if (event.keyCode === 13) {                
            //    if ($('#txtTerimaDari').val() === '') {
            //        $('#txtTerimaDari').focus();
            //    } else if ($('#txtNamaSupir').val() === '') {
            //        $('#txtNamaSupir').focus();
            //    } else if ($('#txtBarcode').val() === '') {
            //        $('#txtBarcode').focus();
            //    }
            //}            
        });

        $(document).on('keypress', '#txtNoMobil', function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                if ($('#txtTerimaDari').val() === '') {
                    $('#txtTerimaDari').focus();
                } else if ($('#txtNamaSupir').val() === '') {
                    $('#txtNamaSupir').focus();
                } else if ($('#txtBarcode').val() === '') {
                    $('#txtBarcode').focus();
                }
            }
        });

        // Input nama supir
        $(document).on('focus', '#txtNamaSupir', function (event) {
            //event.preventDefault();
            $('#txtNamaSupir').val('');
        });

        $(document).on('keyup', '#txtNamaSupir', function (event) {
            event.preventDefault();
            //if (this.value.length === 5) {
            //    if ($('#txtTerimaDari').val() === '') {
            //        $('#txtTerimaDari').focus();
            //    } else if ($('#txtNoMobil').val() === '') {
            //        $('#txtNoMobil').focus();
            //    } else if ($('#txtBarcode').val() === '') {
            //        $('#txtBarcode').focus();
            //    }
            //}            
        });

        $(document).on('keypress', '#txtNamaSupir', function (event) {           
            if (event.key === "Enter") {
                event.preventDefault();
                if ($('#txtTerimaDari').val() === '') {
