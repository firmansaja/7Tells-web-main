@using BusinessObjects
@{
    ViewBag.Title = "TrolleyIn";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .grid_center {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-column-gap: 10px;
            grid-row-gap: 5px;
        }

        .container_barcode {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #CCCCCC;
            padding: 5px;
            margin: 5px 0px;
        }

        .form-group {
            margin-bottom: 0px;
        }

        .form-control {
            border-radius: 5px;
        }

        .box-header {
            padding: 10px 10px 0px 10px;
        }

        @@media only screen and (max-width:640px) {
            .c-header {
                font-size: 18px;
            }

            .grid_center {
                grid-gap: 5px;
                font-size: 12px;
            }

            .form-control {
                border-radius: 5px;
                padding: 2px 8px;
                font-size: 12px;
                height: 24px;
            }

            .btn {
                padding: 2px 8px;
                font-size: 12px;
            }

            h4.small {
                font-size: 12px;
            }

            .table-container {
                font-size: 12px;
            }

            .main-header .logo {
                display: none;
            }

            .fixed .content-wrapper, .fixed .right-side {
                padding-top: 50px;
            }
        }

        table {
            /*width: 50%;*/
            counter-reset: row-num;
        }

        table tbody tr {
            counter-increment: row-num;
        }

        table tbody tr td:first-child::before {
            content: counter(row-num) "";
        }
    </style>
</head>

<div class="box box-primary">
    <div class="box-header with-border header-font">
        <div class="col-xs-12">
            <div align="center" class="row">
                <h1 class="c-header" style="margin:0; font-weight:bold; color:#0288E1">TRANSAKSI TROLLEY MASUK</h1>
            </div>
        </div>
    </div>
    <div class="box-body">
        <div class="col-xs-12">
            <div class="grid_center">
                <div class="form-group">
                    <label style="margin:0">No. Trans</label>
                    <input type="text" class="form-control" value="" id="txtNoTrans" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">Tanggal</label>
                    <input type="text" class="form-control" value="" id="dtTgl" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">Jam</label>
                    <input type="text" class="form-control" value="" id="txtJam" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">Terima Dari</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtTerimaDari">
                </div>
                <div class="form-group">
                    <label style="margin:0">No. Mobil</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNoMobil">
                </div>
                <div class="form-group">
                    <label style="margin:0">Nama Supir</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNamaSupir">
                </div>
            </div>
            <div class="container_barcode">
                <h4 class="small" style="margin:0; font-weight:bold">BARCODE TROLLEY</h4>
                <input style="max-width:300px; margin:5px 0px" type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtBarcode">
                <button id="btnSubmit" class="btn btn-primary" onclick="return SimpanTrolleyIn()">Submit</button>
            </div>
            <div class="table-container">
                <table class="table" id="tblTrolleyIn" style="border-color:black;width:100%">
                    <thead>
                        <tr style="border-color:black">
                            <th style="text-align:center;vertical-align:middle;border-color:black">No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Kode Trolley</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jenis Trolley</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Pilihan</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            var menuItem = $('#trolley');
            menuItem.addClass('active');
            var subMenuItem = menuItem.find('#trolleyin');
            subMenuItem.addClass('active');

            $('#dtTgl').val(FormatDateTime('DD-MM-YYYY'));
            $('#txtJam').val(FormatDateTime('HH:mm:ss'));

            var msg = localStorage.getItem("message");
            var scs = localStorage.getItem("success");
            if (msg != null) {
                //var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                //$('#message').html(msg1);
                //$("#message").slideDown(1000).slideUp(2000);
                PopupMessage(scs, msg);
                localStorage.removeItem("message");
                localStorage.removeItem("success");
            }

            $('#txtTerimaDari').focus();
        })

        // Input terima dari
        $(document).on('focus', '#txtTerimaDari', function (event) {
            //event.preventDefault();
            $('#txtTerimaDari').val('');
        });

        $(document).on('keyup', '#txtTerimaDari', function (event) {
            event.preventDefault();

            //if (this.value.length === 5) {
            //    if ($('#txtNoMobil').val() === '') {
            //        $('#txtNoMobil').focus();
            //    } else if ($('#txtNamaSupir').val() === '') {
            //        $('#txtNamaSupir').focus();
            //    } else if ($('#txtBarcode').val() === '') {
            //        $('#txtBarcode').focus();
            //    }
            //}            
        });

        $(document).on('keypress', '#txtTerimaDari', function (event) {     
