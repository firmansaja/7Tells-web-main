<div id="message"></div>
<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header">
                <button type="button" class="btn btn-primary pull-right bottom" id="btnAdd"><span class="bold fa fa-plus"></span>&nbsp;&nbsp;Surat Masuk</button>
