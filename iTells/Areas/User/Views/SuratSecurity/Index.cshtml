                        <div class="col-sm-8 col-md-7">
                            <input id="security" class="form-control" equired placeholder="Siapa security penerima?" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Keterangan</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="ket" class="form-control" equired placeholder="Tulis keterangan" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tgl Ambil</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="tglAmbil" class="form-control" equired placeholder="Kapan tanggal ambil?" readonly />
