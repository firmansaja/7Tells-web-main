@using BusinessObjects;
@{
    ViewBag.Title = "BoM Calculate Detail";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "";
    List<MRPBoMCalculateDetail> ListBoMCalculateDetail = (List<MRPBoMCalculateDetail>)ViewData["ListBoMCalculateDetail"];
    int i = 0;
}

<style type="text/css">
    .header-font {
        font-size: 14px;
        padding: 5px;
    }

    .header-font p {
        font-size: 12px;
        margin: 0px;
    }

    table, th, td {
        font-size: 10px;
        border: 1px solid black;
        border-collapse: collapse;
    }

    th, td {
        padding: 5px;
    }
</style>

<div class="box box-primary" style="margin-bottom:5px">
    <div class="box-body header-font">
        <div class="row">
            <div class="col-lg-2">
                <h5 style="margin:0">Tahun : @ViewBag.Year</h5>
            </div>
            <div class="col-lg-2">
                <h5 style="margin:0">Site : @ViewBag.Site</h5>
            </div>
            <div class="col-lg-5">
                <h5 style="margin:0">Material : @ViewBag.MaterialID</h5>
            </div>
            @*<div class="col-lg-3">
                <button class="btn btn-success pull-right" id="btnExportBoM" onclick="ExportExcel()"><span class="bold fa fa-file-excel-o"></span>&nbsp;&nbsp;Export To Excel</button>
            </div>*@
        </div>
    </div>
</div>

<div class="box box-primary">
    <div class="box-header with-border header-font">
        <div class="col-xs-12">
            <div class="row">
                <p>List Quantity BoM Calculate Detail</p>
            </div>
        </div>
    </div>
    <div class="box-body header-font">
        <div class="row">
            <div class="col-xs-12">
                <table id="tblBoM" style="border-color:black;width:100%">
                    <thead>
                        <tr style="background-color:lightskyblue;border-color:black">
                            <th style="text-align:center;vertical-align:middle;border-color:black">No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Parent ID</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Parent Lvl 0</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Description</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jan</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Feb</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Mar</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Apr</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Mei</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jun</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jul</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Agt</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Sep</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Okt</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Nov</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Des</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in @ListBoMCalculateDetail)
                        {
                            i++;
                            <tr>
                                <td style="text-align:center;border-color:black; vertical-align:middle">@i</td>
                                <td style="vertical-align:middle;border-color:black">@item.ParentID</td>
                                <td style="vertical-align:middle;border-color:black">@item.ParentIDLvl0</td>
                                <td style="vertical-align:middle;border-color:black">@item.Desc</td>
                                @*--Bulan Januari*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCJan</td>
                                @*--Bulan Februari*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCFeb</td>
                                @*--Bulan Maret*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCMar</td>
                                @*--Bulan April*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCApr</td>
                                @*--Bulan Mei*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCMei</td>
                                @*--Bulan Juni*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCJun</td>
                                @*--Bulan Juli*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCJul</td>
                                @*--Bulan Agustus*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCAgt</td>
                                @*--Bulan September*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCSep</td>
                                @*--Bulan Oktober*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCOkt</td>
                                @*--Bulan November*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCNov</td>
                                @*--Bulan Desember*@
                                <td class="formatNum" style="text-align:right;border-color:black; vertical-align:middle">@item.FCDes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $('#tblBoM').DataTable({
                "destroy": true,
                scrollY: "600px",
                scrollX: true,
                scrollCollapse: true,
                paging: false,
                //search: true,
                bFilter: false,
                bInfo: false,
                fixedColumns: {
                    leftColumns: 3
                },
                //"aaSorting": [],
                columnDefs: [
                    { "width": "10px", "orderable": false, "targets": [0] },
                    //{ "visible": false, "targets": [0] },
                ],
            });

            $("td.formatNum").each(function () {
                $(this).html(formatNumber($(this).text()));
            })

        })

        $(function () {
            $(document).on('click', 'button[data-dismiss]', function (e) {
                location.reload();
            });
        });

        function ExportExcel(e) {
            $.ajax({
                url: '@Url.Action("ExportExcelBoMCalculateDetail", "MRP", new { area ="User"})',
                dataType: "JSON",
                type: "POST",
                data: {
                    Year: '@ViewBag.Year',
                    Site: '@ViewBag.Site',
                    MaterialID: '@ViewBag.MaterialID'
                },
                beforeSend: function () {
                    $('#btnExportBoM').attr('disabled', true);
                },
                success: function (data) {
                    if (data.success) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "MRP", Action = "Download" })/?fileName=" + "Report BoM Calculate Detail.xlsx";
                    }
                },
                complete: function () {
                    $('#btnExportBoM').attr('disabled', false);
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }

        function formatNumber(value) {
            let hasil = (Math.round(value * 1000) / 1000);
            return hasil.toString().replace(/\B(?<!\.\d*)(?=(\d{3})+(?!\d))/g, ",");
        }

    </script>
}

