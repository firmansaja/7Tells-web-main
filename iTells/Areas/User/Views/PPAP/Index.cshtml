
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Production Part Approval Process (e-PPAP)";
    ViewBag.SubTitle = "Home";
}

<div id="message"></div>
<div class="col-xs-12">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h4 class="col-sm-10">List PPAP</h4>
        </div>
        <div class="box-body">
            @Html.Partial("_PPAPHeader")
        </div>
    </div>
</div>

<div class="modal fade" id="_popUp" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h2 class="modal-title" id="_title"></h2>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group hidden">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">State</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="_inputState" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group hidden">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Id</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="id" class="form-control" equired placeholder="Id" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Judgment</label>
                        <select id="filterType" class="form-control select2">
                            <option value="Oke">Oke</option>
                            <option value="Cancel">Cancel</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>

                    @*<div class="form-group">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tanggal</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="tanggal" class="form-control" equired placeholder="Tanggal" readonly />
                        </div>
                    </div>*@
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSimpan" class="btn btn-primary" style="width:100px">Simpan</button>&nbsp;
                <button type="button" class="btn btn-primary" data-dismiss="modal" style="width:100px">Kembali</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bootstrapDialog" role="dialog" aria-labelledby="myModal-label" aria-hidden="true"></div>

