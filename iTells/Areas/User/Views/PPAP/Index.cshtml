        function GetSuratMasukById(Id) {
            $.ajax({
                type: "GET",
                url: '/getsuratmasuk',
                data: {
                    Id: Id
                },
                success: function (result) {
                    if (result.Id != 0) {
                        var dt = FormatDateTime(result.TglAmbil, 'DD-MM-YYYY HH:mm:ss');
                        if (new Date(dt) < new Date(1900, 0, 2)) {
                            dt = "";
                        }
                        //console.log(result);
                        $("#id").val(result.Id);
                        $('#tanggal').val(FormatDateTime(result.Tanggal, 'DD-MM-YYYY HH:mm:ss'));
                        $("#noUrut").val(result.NoUrut);
                        $("#flag").val(result.Flag);
                        $("#noSurat").val(result.NoSurat);
                        $("#dari").val(result.Dari);
                        $("#pengirim").val(result.Pengirim);
                        $("#tujuan").val(result.Tujuan);
                        $("#dept").val(result.Dept).trigger('change');
                        $("#security").val(result.Security);
                        $("#ket").val(result.Ket);
                        $('#tglAmbil').val(dt);
                        $("#kategori").val(result.IdKategori).trigger('change');
                        //$("#jenis").val(result.Jenis).trigger('change');
                        $("input[name=jenis][value=" + result.Jenis + "]").prop('checked', true);
                        $("#penerima").val(result.Penerima);
                        $("#deptTerima").val(result.DeptTerima).trigger('change');
                        //$("#media").val(result.Media).trigger('change');
                        $("input[name=media][value=" + result.Media + "]").prop('checked', true);
                        $("#perihal").val(result.Perihal);
                        //$("#akses").val(result.Akses).trigger('change');
                        $("input[name=akses][value=" + result.Akses + "]").prop('checked', true);
                        $('#isRahasia').prop('checked', result.IsRahasia).trigger('change');
                        //$("#rahasia").val(result.Rahasia).trigger('change');
                        $("input[name=rahasia][value=" + result.Rahasia + "]").prop('checked', true);
                        $("#fileName").text(result.FileName);
                        if (result.FileName) {
                            $("#downloadSuratMasuk").removeClass("hidden");
                            var link = '@Html.ActionLink("Download Surat Masuk", "DownloadFile", "SuratMasuk", new { FileName  = "_fileName_" }, null)';
                            link = link.replace('_fileName_', result.FileName);
                            $("#downloadSuratMasuk").html(link)
                        } else {
                            $("#downloadSuratMasuk").addClass("hidden");
                        }

                        if (result.Flag === 0) {
                            $("#securityGroup").removeClass("hidden");
                            $("#ketGroup").removeClass("hidden");
                            $("#tglAmbilGroup").removeClass("hidden");
                            $("#penerimaGroup").removeClass("hidden");
                            $("#deptTerimaGroup").removeClass("hidden");
                        }
                    }
                },
            });
        }

        toastr.options = {
