@using BusinessObjects.PPAP;
@{
    ViewBag.Title = "View PPAP";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "E-PPAP";
    ViewBag.Link = "/User/PPAP";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    PPAPHeaderModel PPAPHeader = (PPAPHeaderModel)ViewData["PPAPHeader"];
    List<PPAPAksesDeptModel> ListPPAPAksesDept = (List<PPAPAksesDeptModel>)ViewData["AksesDept"];
    List<PPAPApprovalDeptModel> ListPPAPApprovalDept = (List<PPAPApprovalDeptModel>)ViewData["PPAPApprovalDept"];
    List<PPAPDetailModel> ListPPAPDetail = (List<PPAPDetailModel>)ViewData["PPAPDetail"];
    List<PPAPToolingModel> ListPPAPTooling = (List<PPAPToolingModel>)ViewData["PPAPTooling"];
    List<PPAPQualityModel> ListPPAPQuality = (List<PPAPQualityModel>)ViewData["PPAPQuality"];
    List<PPAPPreparationModel> ListPPAPPreparation = (List<PPAPPreparationModel>)ViewData["PPAPPreparation"];
    List<PPAPDocumentModel> ListPPAPDocument = (List<PPAPDocumentModel>)ViewData["PPAPDocument"];
    List<PPAPSupplierModel> ListPPAPSupplier = (List<PPAPSupplierModel>)ViewData["PPAPSupplier"];
    List<PPAPPackingModel> ListPPAPPacking = (List<PPAPPackingModel>)ViewData["PPAPPacking"];
    List<PPAPComparationModel> ListPPAPComparation = (List<PPAPComparationModel>)ViewData["PPAPComparation"];
    List<PPAPPaintingModel> ListPPAPPainting = (List<PPAPPaintingModel>)ViewData["PPAPPainting"];
    List<PPAPAssemblyModel> ListPPAPAssembly = (List<PPAPAssemblyModel>)ViewData["PPAPAssembly"];
    string Dept = ViewBag.Dept;
    int Level = ViewBag.Level;
}

<style type="text/css">
    table, th, td {
        font-size: 12px;
    }

    .col-view {
        width: 1%;
        white-space: nowrap;
        text-align: center;
    }

    #detailScroll {
        max-height: 500px;
        overflow-y: auto;
        border: 1px solid #ddd;
    }

    #detailScroll thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 1;
    }

    .tr-disabled {
        background-color: #f2f2f2;
        /*color: #999;*/
    }

    .text-kanan {
        text-align: right;
        vertical-align: middle;
    }

    .text-tengah {
        text-align: center;
        vertical-align: middle;
    }
</style>

<div id="message"></div>
<div class="box box-primary">
    <div class="box-body" style="overflow-x:auto">
        <div class="row">
            <div class="col-xs-12">
                <table style="width:100%">
                    <tr style="border-bottom:2px solid black">
                        <td colspan="6" style="width:100%;text-align:center;vertical-align:middle;font-size:20px"><b>PRODUCTION PART APPROVAL PROCESS</b></td>
                    </tr>
                    <tr>
                        <td style="width:15%;vertical-align:middle"><h5>Status&nbsp:&nbsp<b><span id="ppapStatus">@PPAPHeader.Status</span></b></h5></td>
                        <td style="width:20%;vertical-align:middle"><h5>Customer&nbsp:&nbsp<b><span id="ppapCustID">@PPAPHeader.CustID</span></b></h5></td>
                        <td style="width:20%;vertical-align:middle"><h5>Project Name&nbsp:&nbsp<b><span id="ppapProjectName">@PPAPHeader.ProjectName</span></b></h5></td>
                        <td style="width:20%;vertical-align:middle"><h5>Confirmation Date&nbsp:&nbsp<b><span id="ppapConfirmationDate">@String.Format("{0:dd-MMM-yy}", @PPAPHeader.ConfirmationDate)</span></b></h5></td>
                        <td style="width:15%;vertical-align:middle"><h5>Production Date&nbsp:&nbsp<b><span id="ppapConfirmationDate">@String.Format("{0:MMM-yy}", @PPAPHeader.MassproductionDate)</span></b></h5></td>
                        <td style="width:10%;vertical-align:middle"><h5>Overall Judgment&nbsp:&nbsp<b><span id="ppapOverallJudgment">@PPAPHeader.OverallJudgment</span></b></h5></td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle"><h5 style="margin:0">Overall Comment&nbsp:&nbsp</h5></td>
                    </tr>
                    <tr>
                        <td colspan="6" style="width:100%;vertical-align:middle;white-space: pre-line"><h5 style="margin-top:2px">@PPAPHeader.OverallComment</h5></td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <table id="tblPPAPDetail" style="border-color:black" class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="width:20%;text-align:center;vertical-align:middle;border-color:black">Parts No.</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Part Name</th>
                            <th style="width:10%;text-align:center;vertical-align:middle;border-color:black">Forecast / Month</th>
                            <th style="width:30%;text-align:center;vertical-align:middle;border-color:black">Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in @ListPPAPDetail)
                        {
                            <tr>
                                @if (@item.Level == 1)
                                {
                                    <td style="vertical-align:middle;border-color:black"><b>@item.PartNumber</b></td>
                                    <td style="vertical-align:middle;border-color:black"><b>@item.PartName</b></td>
                                }
                                else
                                {
                                    <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartNumber</td>
                                    <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartName</td>
                                }
                                <td style="text-align:center; vertical-align:middle;border-color:black">@item.Forecast</td>
                                <td style="vertical-align:middle;border-color:black">@item.Remark</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <ul id="tabStatus" class="nav nav-tabs">
                    <li id="tabTooolingStatus" data-value="1"><a data-toggle="tab" href="#toolingStatus">Tooling Status</a></li>
                    <li id="tabQualityStatus" data-value="2"><a data-toggle="tab" href="#qualityStatus">Quality Status</a></li>
                    <li id="tabPreparationStatus" data-value="3"><a data-toggle="tab" href="#preparationStatus">Preparation Status</a></li>
                    <li id="tabDocumentStatus" data-value="4"><a data-toggle="tab" href="#documentStatus">Document Status</a></li>
                    <li id="tabDocumentSupplier" data-value="5"><a data-toggle="tab" href="#supplier">Document Supplier</a></li>
                    <li id="tabPackingStatus" data-value="6"><a data-toggle="tab" href="#packingStatus">Packing Status</a></li>
                    <li id="tabComparationStatus" data-value="7"><a data-toggle="tab" href="#comparationStatus">Comparation Status</a></li>
                    <li id="tabConsumtionCat" data-value="8"><a data-toggle="tab" href="#consumtionCat">Consumtion Cat & Assembly</a></li>
                    <li id="tabApprovalDept" data-value="0"><a data-toggle="tab" href="#approvalDept">Approval Dept</a></li>
                </ul>

                <div class="tab-content">
                    <div id="toolingStatus" class="tab-pane fade" style="padding-top:5px">
                        <table id="tblPPAPToolingStatus" style="border-color:black" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Parts Name</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Part No</th>
                                    <th colspan="3" style="text-align:center;vertical-align:middle;border-color:black">Data</th>
                                    <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black">Die/Mold</th>
                                    <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black">Equipment Tools</th>
                                    <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black">C/F</th>
                                </tr>
                                <tr>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">2D</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">RN-ECI</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Grain</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Fabrication Location</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Problem</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Status</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Target Data To Complete</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Fabrication Location</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Problem</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Status</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Target Data To Complete</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Fabrication Location</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Problem</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Status</th>
                                    <th style="word-wrap:break-word;white-space:pre-wrap;text-align:center;vertical-align:middle;border-color:black">Target Data To Complete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ListPPAPTooling)
                                {
                                    <tr>
                                        @if (@item.Level == 1)
                                        {
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartName</b></td>
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartNumber</b></td>
                                        }
                                        else
                                        {
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartName</td>
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartNumber</td>
                                        }
                                        <td style="text-align:center; vertical-align:middle;border-color:black">@item.Data2D</td>
                                        <td style="vertical-align:middle;border-color:black">@item.DataRNECI</td>
                                        <td style="vertical-align:middle;border-color:black">@item.DataGrain</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MoldFabricationLocation</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MoldProblem</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MoldStatus</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.MoldTargetComplete)</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ETFabricationLocation</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ETProblem</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ETStatus</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.ETTargetComplete)</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CFFabricationLocation</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CFProblem</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CFStatus</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.CFTargetComplete)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="qualityStatus" class="tab-pane fade" style="padding-top:5px">
                        <table id="tblPPAPQualityStatus" style="border-color:black" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Parts Name</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Part No</th>
                                    <th colspan="3" style="text-align:center;vertical-align:middle;border-color:black">Capability</th>
                                    <th colspan="2" style="text-align:center;vertical-align:middle;border-color:black">Data</th>
                                    <th colspan="2" style="text-align:center;vertical-align:middle;border-color:black">Limit Sample</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Problem Part</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Remark</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Target Date<br />To Complete</th>
                                </tr>
                                <tr>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Injection</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Painting</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Assembling</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Accuracy</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">N-1 Data</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Status</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Keterangan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ListPPAPQuality)
                                {
                                    <tr>
                                        @if (@item.Level == 1)
                                        {
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartName</b></td>
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartNumber</b></td>
                                        }
                                        else
                                        {
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartName</td>
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartNumber</td>
                                        }
                                        <td style="text-align:center; vertical-align:middle;border-color:black">@item.CapabilityInjection</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CapabilityPainting</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CapabilityAssembling</td>
                                        <td style="vertical-align:middle;border-color:black">@item.DataAccuracy</td>
                                        <td style="vertical-align:middle;border-color:black">@item.DataN1</td>
                                        <td style="vertical-align:middle;border-color:black">@item.LimitSampleStatus</td>
                                        <td style="vertical-align:middle;border-color:black">@item.LimitSampleKeterangan</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ProblemPart</td>
                                        <td style="vertical-align:middle;border-color:black">@item.Remark</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.TargetComplete)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="preparationStatus" class="tab-pane fade" style="padding-top:5px">
                        <table id="tblPPAPPreparationStatus" style="border-color:black" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Parts Name</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Part No</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Material</th>
                                    <th colspan="3" style="text-align:center;vertical-align:middle;border-color:black">Process Plan</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Machine</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Chuck<br />Robot</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Tools</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Jig Painting</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Jig Assy</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Meja Kerja</th>
                                    <th colspan="3" style="text-align:center;vertical-align:middle;border-color:black">Mapping Skill</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Remark</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Target Date<br />To Complete</th>
                                </tr>
                                <tr>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Injection</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Painting</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Assembling</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Injection</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Painting</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Assembling</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ListPPAPPreparation)
                                {
                                    <tr>
                                        @if (@item.Level == 1)
                                        {
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartName</b></td>
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartNumber</b></td>
                                        }
                                        else
                                        {
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartName</td>
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartNumber</td>
                                        }
                                        <td style="text-align:center; vertical-align:middle;border-color:black">@item.Material</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ProsesPlanInjection</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ProsesPlanPainting</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ProsesPlanAssembling</td>
                                        <td style="vertical-align:middle;border-color:black">@item.Machine</td>
                                        <td style="vertical-align:middle;border-color:black">@item.ChuckRobot</td>
                                        <td style="vertical-align:middle;border-color:black">@item.Tools</td>
                                        <td style="vertical-align:middle;border-color:black">@item.JigPainting</td>
                                        <td style="vertical-align:middle;border-color:black">@item.JigAssy</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MejaKerja</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MappingSkillInjection</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MappingSkillPainting</td>
                                        <td style="vertical-align:middle;border-color:black">@item.MappingSkillAssembling</td>
                                        <td style="vertical-align:middle;border-color:black">@item.Remark</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.TargetComplete)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="documentStatus" class="tab-pane fade" style="padding-top:5px">
                        <table id="tblPPAPDocumentStatus" style="border-color:black" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th class="col-view" style="text-align:center;vertical-align:middle;border-color:black"></th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Part No</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Part Name</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Invt ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ListPPAPDocument)
                                {
                                    <tr>
                                        <td class="col-view" style="border-color:black"><button class="btn btn-xs btn-info btnView" data-row='@Html.Raw(Json.Encode(item))' title="View" style="margin-right:5px"><i class="fa fa-eye"></i></button></td>
                                        @if (@item.Level == 1)
                                        {
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartNumber</b></td>
                                            <td style="vertical-align:middle;border-color:black"><b>@item.PartName</b></td>
                                        }
                                        else
                                        {
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartNumber</td>
                                            <td style="padding-left:@(item.Level * 20)px;vertical-align:middle;border-color:black">@item.PartName</td>
                                        }
                                        <td style="vertical-align:middle;border-color:black">@item.InvtID</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="supplier" class="tab-pane fade" style="padding-top:5px">
                        <table id="tblPPAPSupplier" style="border-color:black" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Parts Name</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Part No</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">PIS</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Control Plan &<br />Flow Process</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">IRD Check Sheet</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">N1 Data</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Limit Sample</th>
                                    <th colspan="2" style="text-align:center;vertical-align:middle;border-color:black">Packing</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Remark</th>
                                    <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black">Target Date<br />To Complete</th>
                                </tr>
                                <tr>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Packing Spec (L x W x H)</th>
                                    <th style="text-align:center;vertical-align:middle;border-color:black">Qty /Packing</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ListPPAPSupplier)
                                {
                                    <tr>
                                        <td style="vertical-align:middle;border-color:black">@item.PartName</td>
                                        <td style="vertical-align:middle;border-color:black">@item.PartNumber</td>
                                        <td style="vertical-align:middle;border-color:black">@item.PIS</td>
                                        <td style="vertical-align:middle;border-color:black">@item.CPFP</td>
                                        <td style="vertical-align:middle;border-color:black">@item.IRDCheckSheet</td>
                                        <td style="vertical-align:middle;border-color:black">@item.N1Data</td>
                                        <td style="vertical-align:middle;border-color:black">@item.LimitSample</td>
                                        <td style="vertical-align:middle;border-color:black">@item.PackingSpec</td>
                                        <td style="vertical-align:middle;border-color:black">@item.PackingQty</td>
                                        <td style="vertical-align:middle;border-color:black">@item.Remark</td>
                                        <td style="vertical-align:middle;border-color:black">@String.Format("{0:dd-MMM-yy}", @item.TargetComplete)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
