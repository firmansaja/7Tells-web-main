@section scripts {
    <script src="~/Scripts/aes.js"></script>
    <script type="text/javascript">
        var listApprovalDept = @Html.Raw(Json.Encode(ListPPAPApprovalDept));
        var listAksesDept = @Html.Raw(Json.Encode(ListPPAPAksesDept));
        $(document).ready(function () {
            $("#message").slideDown(0).slideUp(0);
            var msg = localStorage.getItem("message");
            if (msg != null) {
                var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                $('#message').html(msg1);
                $("#message").slideDown(1000).slideUp(2000);
                localStorage.removeItem("message");
            }

            $("#btnAssign").each(function () {
                var data = listApprovalDept.find(x => x.Dept === '@Dept');

                if ((@PPAPHeader.IdStatus === 4 && @Level === 1) || !data || !data.IsCheck) {
                    $(this)
                        .prop("disabled", true)
                        .addClass("btn-default")
                        .removeClass("btn-primary")
                        .attr("title", "Tidak ada akses approval");
                }
            });

            $(".btnAssign").each(function () {
                var data = JSON.parse($(this).attr("data-row"));
                var dataAkses = listAksesDept.find(x => x.Dept === data.Dept);

                if (!dataAkses || !data.IsCheck || (@PPAPHeader.IdStatus === 4 && dataAkses.Level === 1)) {
                    $(this).prop("disabled", true);
                } else {
                    $(this).prop("disabled", false);
                }
            });

            $("#tabTooolingStatus").each(function () {
                aksesDept(this);
            });

            $("#tabQualityStatus").each(function () {
                aksesDept(this);
            });

            $("#tabPreparationStatus").each(function () {
                aksesDept(this);
            });

            $("#tabDocumentSupplier").each(function () {
                aksesDept(this);
            });

            $("#tabPackingStatus").each(function () {
                aksesDept(this);
            });

            $("#tabComparationStatus").each(function () {
                aksesDept(this);
            });

            var $activeTab = $('.nav-tabs li.active:not(.hidden)');
            if ($activeTab.length === 0) {                
                var $firstVisibleTab = $('.nav-tabs li:not(.hidden)').first();
                if ($firstVisibleTab.length > 0) {
                    $firstVisibleTab.find('a').tab('show');
                }
            }
        });

        $("#comment").on("input", function () {
            autoResizeTextarea(this);
        });

        @*$(document).on('click', '#btnAssign', function (event) {
            event.preventDefault();
            var data = listApprovalDept.find(x => x.Dept === '@Dept');

            if (!data) {
                alert("Data tidak ditemukan");
                return;
            }

            if (data.IsCheck === false) {
                alert("Tidak bisa melakukan assign");
                return;
            }

            $("#_popUp").modal({ backdrop: 'static' });
            $("#_title").text("Approval Dept");
            $("#_inputState").val("Update");

            $("#judgment").val(data.Judgment).trigger('change');
            $("#comment").val(data.Comment);

            $('#_popUp').on('shown.bs.modal', function () {
                $('#judgment').focus();
                autoResizeTextarea(document.getElementById("comment"));
            })

        });*@

        $(document).on('click', '.btnAssign', function (event) {
            event.preventDefault();
            var data = JSON.parse($(this).attr("data-row"));

            $("#_popUp").modal({ backdrop: 'static' });
            $("#_title").text("Approval Dept");
            $("#_inputState").val("Update");

            $("#dept").val(data.Dept);
            $("#deptDescr").val(data.Descr);
            $("#judgment").val(data.Judgment).trigger('change');
            $("#comment").val(data.Comment);

            $('#_popUp').on('shown.bs.modal', function () {
                $('#judgment').focus();
                autoResizeTextarea(document.getElementById("comment"));
            })

        });

        $(document).on('click', '.btnView', function () {
            var data = JSON.parse($(this).attr("data-row"));

            $.get("/PPAP/GetDocumentDetail", { noPPAP: data.NoPPAP, idStatus: data.IdStatus, code: data.Code })
                .done(function (res) {
                    if (!res.success) {
                        alert(data.message);
                        return;
                    }

                    $("#dPartNo").text(data.PartNumber);
                    $("#dPartName").text(data.PartName);

                    var tbody = $("#tblDetail tbody").empty();

                    if (res.data.length === 0) {
                        tbody.append("<tr><td colspan='2'>No Data</td></tr>");
                    } else {                        
                        var isFileAkses = @Level == 1 ? 'hidden' : '';
                        $("#hFile").addClass(isFileAkses);
                        $.each(res.data, function (i, item) {
                            var rowClass = getRowClass(item);
                            var isDownload = item.IsEdit ? '' : 'hidden';
                            var disable = item.FileName == null ? 'disabled' : '';
                            tbody.append(`
                                <tr class="${rowClass}">
                                    <td style="text-align:center;vertical-align:middle">${safeText(item.No)}</td>
                                    <td>${safeText(item.Item)}</td>
                                    <td>${safeText(item.Status)}</td>
                                    <td></td>
                                    <td>${safeText(item.DueDate)}</td>
                                    <td class="col-view ${isFileAkses}"><button class="btn btn-xs btn-info btnDownload ${isDownload}" data-noppap="${item.NoPPAP}" data-idstatus="${item.IdStatus}" data-filename="${item.FileName}" ${disable} title="Download"><i class="fa fa-download"></i></button></td>
                                </tr>
                            `);
                        });
                    }

                    $("#modalDetail").modal("show");
                })
                .fail(function () {
                    alert("Gagal mengambil data");
                });
        });

        $(document).on('click', '.btnViewPainting', function () {
            var data = JSON.parse($(this).attr("data-row"));
            $.get("/PPAP/GetPaintingDetail", { noPPAP: data.NoPPAP, idStatus: data.IdStatus, code: data.Code })
                .done(function (res) {
                    if (!res.success) {
                        alert(data.message);
                        return;
                    }

                    $("#paintingPartNo").text(data.PartNumber);
                    $("#paintingPartName").text(data.PartName);

                    var tbody = $("#tblPaintingDetail tbody").empty();

                    if (res.data.length === 0) {
                        tbody.append("<tr><td colspan='2'>No Data</td></tr>");
                    } else {
                        $.each(res.data, function (i, item) {
                            const selisih = item.SubItem == null || item.Spec == null ? null : item.Spec - item.Actual;
                            const persen = selisih == null || item.Actual == null ? null : selisih / item.Actual;
                            tbody.append(`
                                <tr class="${item.SubItem == null ? 'tr-disabled' : ''}"">
                                    <td>${safeText(item.Item)}</td>
                                    <td>${safeText(item.SubItem)}</td>
                                    <td>${safeText(item.ProductName)}</td>
                                    <td class="text-kanan">${safeText(item.Spec)}</td>
                                    <td class="text-kanan">${safeText(item.Actual)}</td>
                                    <td class="text-kanan">${formatDecimal(selisih, 2)}</td>
                                    <td class="text-kanan">${formatPercent(persen, 2)}</td>
                                </tr>
                            `);
                        });
                    }

                    $("#modalPaintingDetail").modal("show");
                })
                .fail(function () {
                    alert("Gagal mengambil data");
                });
        });

        $(document).on('click', '.btnViewAssembly', function () {
            var data = JSON.parse($(this).attr("data-row"));
            $.get("/PPAP/GetAssemblyDetail", { noPPAP: data.NoPPAP, idStatus: data.IdStatus, code: data.Code })
                .done(function (res) {
                    if (!res.success) {
                        alert(data.message);
                        return;
                    }

                    $("#assemblyPartNo").text(data.PartNumber);
                    $("#assemblyPartName").text(data.PartName);

                    var tbody = $("#tblAssemblyDetail tbody").empty();

                    if (res.data.length === 0) {
                        tbody.append("<tr><td colspan='2'>No Data</td></tr>");
                    } else {
                        $.each(res.data, function (i, item) {
                            tbody.append(`
                                <tr>
                                    <td>${safeText(item.ComponentPart)}</td>
                                    <td>${safeText(item.Qty)}</td>
                                    <td>${safeText(item.ProcessName)}</td>
                                    <td class="text-kanan">${safeText(item.ManPower)}</td>
                                    <td class="text-kanan">${safeText(item.Actual)}</td>
                                    <td class="text-kanan">${safeText(item.Spec)}</td>
                                </tr>
                            `);
                        });
                    }

                    $("#modalAssemblyDetail").modal("show");
                })
                .fail(function () {
                    alert("Gagal mengambil data");
                });
        });               

        $(document).on('click', '.btnDownload', function () {
            var noPPAP = $(this).data('noppap');
            var idStatus = $(this).data('idstatus');
            var fileName = $(this).data('filename');

            if (!fileName) {
                alert('File tidak ditemukan');
                return;
            }

            var url = `/PPAP/DownloadDocument?noPPAP=${encodeURIComponent(noPPAP)}&idStatus=${idStatus}&fileName=${encodeURIComponent(fileName)}`;
            window.location.href = url;
        });

        $(document).on('click', '#btnSimpan', function (event) {
            event.preventDefault();

            if (confirm('Apakah Yakin Ingin Approve ?')) {
                var approvalDept = {
                    NoPPAP : '@PPAPHeader.NoPPAP',
                    IdStatus : '@PPAPHeader.IdStatus',
                    Dept: $("#dept").val(),
                    Username : "",
                    Judgment : $("#judgment").val(),
                    Comment : $("#comment").val()
                };

                $.ajax({
                    url: '@Url.Action("UpdateApprovalDept", "PPAP", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: { data: approvalDept} ,
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            $("#_popUp").modal('hide');
                            location.reload();
                        } else {
                            toastr.error(res.message);
                            $("#_popUp").modal('hide');
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
            } else {
                return;
            }
        });

        $(document).on('click', '#btnViewReport', function (event) {
            event.preventDefault();
            var noPPAP = '@PPAPHeader.NoPPAP';
            var idStatus = @PPAPHeader.IdStatus;
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewReportPPAP", "PPAP", new { area ="User"})',
                data: { noPPAP: noPPAP, idStatus: idStatus },
                success: function (data) {
                    if (!data.result) {
                        alert("Error");
                    }
                    else {
                        window.open("/Reports/ReportPPAP.aspx", '_blank');
                    }
                }
            });

        });

        $('.percent').each(function () {
            const spec = parseFloat($(this).data('spec'));
            const actual = parseFloat($(this).data('actual'));

            const val = spec ? (spec - actual) / spec : null;
            $(this).text(formatPercent(val));
        });

        toastr.options = {
            "positionClass": "toast-top-center",
            "timeOut": "1000",
            "preventDuplicates": true,
            "closeButton": true,
            "progressBar": true
        }

        function aksesDept(el) {
            var items = '@PPAPHeader.Item';
            var value = $(el).attr("data-value");
            var itemText = $(el).find("a").text().trim();

            var ada = items
                .split(",")
                .map(x => x.trim())
                .includes(value);
            
            var data = listAksesDept.find(x => x.Item === itemText);

            if (!ada || !data || !data.Flag) {
                $(el)
                    .addClass("hidden")
            }
        };

        function autoResizeTextarea(el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        };

        function formatDecimal(val, dec = 2) {
            if (val == null || isNaN(val) || !isFinite(val)) return '';

            return Number(val)
                .toFixed(dec)
                .replace(/\.?0+$/, '');
        }

        function formatPercent(val, dec = 0) {
            if (val == null || isNaN(val) || !isFinite(val)) return '';

            return new Intl.NumberFormat('id-ID', {
                style: 'percent',
                minimumFractionDigits: dec,
                maximumFractionDigits: dec
            }).format(val);
        }

        function getRowClass(item) {
            return item.IsEdit === false ? 'tr-disabled' : '';
        }

        function safeText(val) {
            return val === null || val === undefined ? '' : val;
        }

        function formatDate(date, format) {
            const map = {
                mm: date.getMonth() + 1,
                dd: date.getDate(),
                yy: date.getFullYear().toString().slice(-2),
                yyyy: date.getFullYear()
            }
            return format.replace(/mm|dd|yy|yyy/gi, matched => map[matched])
        }
    </script>
}
