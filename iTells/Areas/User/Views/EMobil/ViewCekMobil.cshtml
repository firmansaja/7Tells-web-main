@using BusinessObjects;
@{
    ViewBag.Title = "ViewCekMobil";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "Cek Surat Jalan Kendaraan";
    ViewBag.Link = "/User/EMobil";
    MobilAksesUser AkseUser = (MobilAksesUser)ViewData["AksesUser"];
    EMobilCek CekHeader = (EMobilCek)ViewData["CekHeader"];
    List<EMobilCekDetail> ListCekDetail = (List<EMobilCekDetail>)ViewData["ListCekDetail"];
    var Dept = @AkseUser.Dept;
    string Site = @AkseUser.Site;
    int Level = @AkseUser.Level;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="box box-primary">
    <div class="box-body" style="overflow-x:auto">
        <div class="row">
            <div class="col-xs-12">
                <table style="width:100%">
                    <tr>
                        <td style="width:10%;vertical-align:middle"><h5>No Surat Jalan</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="width:15%;vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.NoSuratJalan</b></h5></td>
                        <td style="width:10%;vertical-align:middle"><h5>No Mobil</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="width:15%;vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.NoMobil</b></h5></td>
                        <td style="width:10%;vertical-align:middle"><h5>Berangkat Tgl</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.BerangkatTgl.ToShortDateString()</b></h5></td>
                        <td style="width:10%;vertical-align:middle"><h5>Kembali Tgl</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle"><h5><b>@CekHeader.KembaliTgl.ToShortDateString()</b></h5></td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle"><h5>Tanggal Buat</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.Tanggal.ToShortDateString()</b></h5></td>
                        <td style="vertical-align:middle"><h5>Pakai Supir</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="text-align:center;vertical-align:middle;border-color:black;padding-right:10px"><input type="checkbox" class="singlechkbox" name="singlechkbox" value="1" @CekHeader.PakaiSupir onclick="return false;" /></td>
                        <td style="vertical-align:middle"><h5>Berangkat Jam</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.BerangkatTgl.ToLongTimeString()</b></h5></td>
                        <td style="vertical-align:middle"><h5>Kembali Jam</h5></td>
                        <td style="width:10px;width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle"><h5><b>@CekHeader.KembaliTgl.ToLongTimeString()</b></h5></td>
                    </tr>
                    <tr>
                        <td style="vertical-align:middle"><h5>Status Mobil</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.StatusMobil</b></h5></td>
                        <td style="vertical-align:middle"><h5>Nama Supir</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.NamaSupir</b></h5></td>
                        <td style="vertical-align:middle"><h5>KM Awal</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle;padding-right:10px"><h5><b>@CekHeader.KMAwal</b></h5></td>
                        <td style="vertical-align:middle"><h5>KM Akhir</h5></td>
                        <td style="width:10px;vertical-align:middle">:</td>
                        <td style="vertical-align:middle"><h5><b>@CekHeader.KMAkhir</b></h5></td>
                    </tr>
                </table>
                <br />
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <table id="tblPRDetail" style="border-color:black" class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="text-align:center;vertical-align:middle;border-color:black">No Pengajuan</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Dept</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">NIK</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Nama</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Tujuan</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Keperluan</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Berangkat Dari</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Berangkat Tgl</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Kembali Di</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Kembali Tgl</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Catatan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ListCekDetail)
                        {                            
                            <tr>
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black">@item.NoTrans</td>
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black">@item.Dept</td>
                                <td style="vertical-align:middle;border-color:black">@item.NIK</td>
                                <td style="vertical-align:middle;border-color:black">@item.Nama</td>
                                <td style="vertical-align:middle;border-color:black">@item.Tujuan</td>
                                <td style="vertical-align:middle;border-color:black">@item.Keperluan</td>
                                <td style="vertical-align:middle;border-color:black">@item.BerangkatDari</td>
                                <td style="vertical-align:middle;border-color:black">@item.BerangkatTgl</td>
                                <td style="vertical-align:middle;border-color:black">@item.KembaliDi</td>
                                <td style="vertical-align:middle;border-color:black">@item.KembaliTgl</td>
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black">@item.Catatan</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
        <div class="row no-print">
            <div class="col-xs-12">
                <button class="btn btn-primary pull-left margin" id="btnApproveCek">Approve</button>
                <button class="btn btn-danger pull-left margin" id="btnRejectCek">Reject</button>
                <button class="btn btn-primary pull-right margin" id="btnViewReport">View Report</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
<script>

        $(document).ready(function () {
            if (@Level == 1) {
                if (@CekHeader.Status == "MENUNGGU" || @CekHeader.Status == "SELESAI") {
                    $("#btnViewReport").addClass('hidden');
                }

                if (@CekHeader.CurrLvlApv == (@Level - 1)) {
                    $("#btnRejectCek").addClass('hidden');
                } else {
                    $("#btnApproveCek").addClass('hidden');
                    $("#btnRejectCek").addClass('hidden');
                }
            } else if (@Level == 2 || @Level == 3) {
                $("#btnViewReport").addClass('hidden');
                if (@CekHeader.CurrLvlApv != (@Level - 1)) {
                    $("#btnApproveCek").addClass('hidden');
                    $("#btnRejectCek").addClass('hidden');
                }
		    }
        });

        $(document).on('click', '#btnApproveCek', function (event) {
            event.preventDefault();
            if (confirm('Apakah Yakin Ingin Approve ?')) {
                var comment = "";
                let approve = "APPROVED";
                let status = "SUBMIT";
                if (@Level == 1) {
                    approve = "SUBMITED";
                } else {
                    comment = prompt("Input Comment:", "");
                    status = "MENUNGGU";
                }

                var mobilCek = {
                    NoSuratJalan: '@CekHeader.NoSuratJalan',
                    CurrLvlApv: '@Level',
                    Status: status,
                    Approved: approve ,
                    Comment: comment
                };

                $.ajax({
                    url: '@Url.Action("ApproveCek", "EMobil", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: mobilCek ,
                    success: function (data) {
                        if (data.success) {
                            window.location = "/cekKendaraan";
                            localStorage.setItem("message", data.message)
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
            } else {
                return false;
            }
        });

        $(document).on('click', '#btnRejectCek', function (event) {
            event.preventDefault();
            if (confirm('Apakah Yakin Ingin Reject ?')) {
                var comment = prompt("Input Comment:", "");
                let approve = "REJECTED";

                var mobilCek = {
                    NoSuratJalan: '@CekHeader.NoSuratJalan',
                    CurrLvlApv: "",
                    Status: "CREATE",
                    Approved: approve ,
                    Comment: comment
                };

                $.ajax({
                    url: '@Url.Action("RejectCek", "EMobil", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: mobilCek ,
                    success: function (data) {
                        if (data.success) {
                            window.location = "/cekKendaraan";
                            localStorage.setItem("message", data.message)
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
            } else {
                return false;
            }
        });

        $(document).on('click', '#btnViewReport', function (event) {
            event.preventDefault();
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewReportMbl", "EMobil", new { area ="User"})',
                data: { NoSuratJalan: '@CekHeader.NoSuratJalan' },
                success: function (data) {
                    if (!data.result) {
                        alert("Error");
                    }
                    else {
                        window.open("/Reports/ReportMbl.aspx", '_blank');
                    }
                }
            });
        });

</script>
}
