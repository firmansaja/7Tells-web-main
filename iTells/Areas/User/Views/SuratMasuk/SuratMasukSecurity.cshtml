@using BusinessObjects;
@{
    ViewBag.Title = "Surat Masuk Security";
    ViewBag.SubTitle = "Home";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    List<ComboList> Kategori = (List<ComboList>)ViewData["Kategori"];
    List<ComboList> Dept = (List<ComboList>)ViewData["Dept"];
}

<div id="message"></div>
<div class="col-xs-12">
    <div class="box box-primary">
        <div class="box-header with-border">
            <h4 class="col-sm-10">List Surat Masuk Security</h4>
            <button type="button" class="btn btn-primary pull-right bottom" id="btnAdd"><span class="bold fa fa-plus"></span>&nbsp;&nbsp;Surat Masuk</button>
        </div>
        <div class="box-body">
            <ul id="tabStatus" class="nav nav-tabs">
                <li class="active"><a data-toggle="tab" href="#belumAmbil">Belum Diambil</a></li>
                <li><a data-toggle="tab" href="#sudahAmbil">Sudah Diambil</a></li>
            </ul>

            <div class="tab-content">
                <div id="belumAmbil" class="tab-pane fade in active">
                    @Html.Partial("_SuratHeader")
                </div>
                <div id="sudahAmbil" class="tab-pane fade">
                    @Html.Partial("_SuratHeaderDiambil")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="_popUp" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content modal-lg panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h2 class="modal-title" id="_title"></h2>
            </div>

            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group hidden">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">id</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="_inputState" class="form-control" />
                            <input id="id" class="form-control" equired placeholder="Id" readonly />
                            <input id="flag" class="form-control hidden" equired placeholder="Flag" readonly />
                            <input id="status" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tanggal</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="tanggal" class="form-control" equired placeholder="Tanggal" readonly />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">No. Urut Security</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="noUrut" class="form-control" equired placeholder="Otomatis" readonly />
                                </div>
                            </div>

                            <div class="form-group hidden">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">No. Surat</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="noSurat" class="form-control text-uppercase" equired placeholder="No. Surat" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Instansi/Perusahaan</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="dari" class="form-control text-uppercase" equired />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Pengirim</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="pengirim" class="form-control text-uppercase" equired />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Untuk</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="tujuan" class="form-control text-uppercase" equired />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Dept</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <select id="dept" class="form-control select2" style="width:100%">
                                        <option value="-">-</option>
                                        @foreach (var item in Dept)
                                        {
                                            <option value="@item.Value">@item.Value</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Nama Security</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="security" class="form-control text-uppercase" equired />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Keterangan</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="ket" class="form-control" equired />
                                </div>
                            </div>

                            <div id="tglAmbilGroup" class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tgl Ambil</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <div class="input-group date" id="tglAmbil">
                                        <input type="text" class="form-control" />
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </span>
                                    </div>
                                    <div class="input-group bootstrap-timepicker" style="margin-top:2px">
                                        <input id="timeAmbil" type="text" class="form-control input-small">
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-time"></span>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div id="penerimaGroup" class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Pengambil</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <input id="penerima" class="form-control text-uppercase" required />
                                </div>
                            </div>

                            <div id="deptTerimaGroup" class="form-group">
                                <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Dept Pengambil</label>
                                <label class="col-sm-1 col-md-1 control-label">:</label>
                                <div class="col-sm-8 col-md-7">
                                    <select id="deptTerima" class="form-control select2" style="width:100%">
                                        <option value="-">-</option>
                                        @foreach (var item in Dept)
                                        {
                                            <option value="@item.Value">@item.Value</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Kategori Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <select id="kategori" class="form-control select2" style="width:100%">
                                    <option value="-">-</option>
                                    @foreach (var item in Kategori)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Jenis Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="jenis" id="internal" value="Internal">Internal</label>
                                <label class="radio-inline"><input type="radio" name="jenis" id="ekternal" value="Eksternal">Eksternal</label>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Media Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="media" id="hardcopy" value="Hardcopy">Hardcopy</label>
                                <label class="radio-inline"><input type="radio" name="media" id="softcopy" value="Softcopy">Softcopy</label>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Perihal</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="perihal" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Akses</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="akses" id="all" value="All" checked>All</label>
                                <label class="radio-inline"><input type="radio" name="akses" id="tangerang" value="Tng">Tng</label>
                                <label class="radio-inline"><input type="radio" name="akses" id="cikarang" value="Ckr">Ckr</label>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Rahasia</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input style="margin-right:15px" id="isRahasia" type="checkbox" />
                                <label class="radio-inline" id="lblPribadi"><input type="radio" name="rahasia" id="pribadi" value="Pribadi">Pribadi</label>
                                <label class="radio-inline" id="lblPerusahaan"><input type="radio" name="rahasia" id="perusahaan" value="Perusahaan">Perusahaan</label>
                            </div>
                        </div>

                        <div class="form-group hidden">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Upload Surat Masuk</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="file" class="form-control" type="file" placeholder="Upload Surat Masuk" , required />
                                <div id="downloadSuratMasuk" class="hidden" />
                                <span id="fileName" class="hidden" />
                            </div>
                        </div>
                    </div>   
                </div>
                </div>

            <div class="modal-footer">
                <button type="button" id="btnSimpan" class="btn btn-primary" style="width:100px">Simpan</button>&nbsp;
                <button type="button" id="btnAmbil" class="btn btn-info" style="width:100px">Ambil</button>&nbsp;
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="width:100px">Kembali</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            DataTableSuratMasuk();

            DataTableSuratMasukDiambil();

            $('#timeAmbil').timepicker({
                minuteStep: 1,
                showSeconds: true,
                showMeridian: false,
                snapToStep: true
            });

            $('#tglAmbil').datepicker({
                useCurrent: false,
                autoclose: true,
                format: 'dd/mm/yyyy',
                startDate: new Date(2023, 0, 1),
            });

            $('#tanggal').val(FormatDateTime(new Date(), 'DD-MM-YYYY HH:mm:ss'));

            $("#message").slideDown(0).slideUp(0);
            var msg = localStorage.getItem("message");
            if (msg != null) {
                var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                $('#message').html(msg1);
                $("#message").slideDown(1000).slideUp(2000);
                localStorage.removeItem("message");
            }
        })

        function Init() {
            $("#id").val(0);
            $('#tanggal').val(FormatDateTime(new Date(), 'DD-MM-YYYY HH:mm:ss'));
            $("#noUrut").val("");
            $("#flag").val(0);
            $("#noSurat").val("");
            $("#dari").val("");
            $("#pengirim").val("");
            $("#tujuan").val("");
            $("#dept").val("-").trigger('change');
            $("#security").val('@ViewBag.UserName');
            $("#ket").val("");
            //var dt = new Date();
            $('#tglAmbil').datepicker("setDate", "");
            //var time = String(dt.getHours()).padStart(2, '0') + ":" + String(dt.getMinutes()).padStart(2, '0') + ":" + String(dt.getSeconds()).padStart(2, '0');
            $("#timeAmbil").val("");
            $("#kategori").val("-").trigger('change');
            //$("#jenis").val("-").trigger('change');
            $('input[name=jenis][value=Eksternal]').prop('checked', true);
            $("#penerima").val("");
            $("#deptTerima").val("-").trigger('change');
            //$("#media").val("-").trigger('change');
            $('input[name=media][value=Hardcopy]').prop('checked', true);
            $("#perihal").val("");
            //$("#akses").val("-").trigger('change');
            $('input[name=akses][value=All]').prop('checked', true);
            //$("#rahasia").val("-").trigger('change');
            $('#isRahasia').prop('checked', false);
            $('input[name=rahasia][value=Perusahaan]').prop('checked', true);
            $("#file").val("");
            $("#fileName").val("");
            $("#status").val("Baru");
        }

        var List = null;
        var dtSuratMasuk;
        function DataTableSuratMasuk() {
            List = {
                init: function () {
                    dtSuratMasuk = $('#tbSuratMasuk').DataTable({
                        "serverSide": true,
                        "processing": true,
                        "autoWidth": false,
                        "bInfo": false,
                        "ajax": {
                            "url": "/getlistsuratmasuk",
                            "data": {
                                flag: 0,
                                status: "Baru"
                            },
                            "type": 'POST',
                        },
                        "columns": [
                            { "title": "Id", "data": "Id" },
                            {
                                "title": "No",
                                "data": "Id",
                                "orderable": false,
                                "width": "30px",
                                render: function (data, type, row, meta) {
                                    return meta.row + meta.settings._iDisplayStart + 1;
                                }
                            },
                            { "title": "No Urut", "data": "NoUrut"},
                            {
                                "title": "Tanggal", "data": "Tanggal",
                                "render": function (value) {
                                    if (value === null) return "";
                                    return moment(value).format('DD/MM/YYYY HH:mm:ss');
                                }
                            },
                            { "title": "Dari", "data": "Dari" },
                            { "title": "Pengirim", "data": "Pengirim" },
                            { "title": "Untuk", "data": "Tujuan" },
                            { "title": "Dept", "data": "Dept" },
                            { "title": "Security", "data": "Security" },
                            {
                                "title": "Tgl Ambil", "data": "TglAmbil",
                                "render": function (value) {
                                    if (value === null || new Date(FormatDateTime(value, 'YYYY-MM-DD HH:mm:ss')) < new Date(1900, 0, 2)) return "";
                                    return moment(value).format('DD/MM/YYYY HH:mm:ss');
                                }
                            },
                            { "title": "Pengambil", "data": "Penerima" },
                            {
                                data: "id", "width": "70px", title: "Action", "orderable": false, "render": function (data) {
                                    return '<button class="btn btn-xs btn-primary" title="Edit" id="btnEdit" style="margin-right:5px"> <span class="fa fa-pencil"></span></button>' +
                                        '<button class="btn btn-xs btn-danger" title="Delete" id="btnDelete" style="margin-right:5px"><span class="fa fa-trash"></span></button>';
                                }
                            },
                        ],
                        "columnDefs": [
                            { "width": "20px", "searchable": false, "orderable": false, "targets": [0] },
                            { "className": "text-center custom-middle-align", "targets": [0, 1] },
                            { "visible": false, "targets": [0] },
                        ],
                        "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]]
                    });
                }
            }
            List.init();
        }

        var ListAmbil = null;
        var dtSuratMasukDiambil;
        function DataTableSuratMasukDiambil() {
            ListAmbil = {
                init: function () {
                    dtSuratMasukDiambil = $('#tbSuratMasukDiambil').DataTable({
                        "serverSide": true,
                        "processing": true,
                        "autoWidth": false,
                        "bInfo": false,
                        "ajax": {
                            "url": "/getlistsuratmasuk",
                            "data": {
                                flag: 0,
                                status: "Diambil"
                            },
                            "type": 'POST',
                        },
                        "columns": [
                            { "title": "Id", "data": "Id" },
                            {
                                "title": "No",
                                "data": "Id",
                                "orderable": false,
                                "width": "30px",
                                render: function (data, type, row, meta) {
                                    return meta.row + meta.settings._iDisplayStart + 1;
                                }
                            },
                            { "title": "No Urut", "data": "NoUrut" },
                            {
                                "title": "Tanggal", "data": "Tanggal",
                                "render": function (value) {
                                    if (value === null) return "";
                                    return moment(value).format('DD/MM/YYYY HH:mm:ss');
                                }
                            },
                            { "title": "Dari", "data": "Dari" },
                            { "title": "Pengirim", "data": "Pengirim" },
                            { "title": "Untuk", "data": "Tujuan" },
                            { "title": "Dept", "data": "Dept" },
                            { "title": "Security", "data": "Security" },
                            {
                                "title": "Tgl Ambil", "data": "TglAmbil",
                                "render": function (value) {
                                    if (value === null || new Date(FormatDateTime(value, 'YYYY-MM-DD HH:mm:ss')) < new Date(1900, 0, 2)) return "";
                                    return moment(value).format('DD/MM/YYYY HH:mm:ss');
                                }
                            },
                            { "title": "Pengambil", "data": "Penerima" },
                            {
                                data: "id", "width": "70px", title: "Action", "orderable": false, "render": function (data) {
                                    return '<button class="btn btn-xs btn-primary" title="Edit" id="btnView" style="margin-right:5px"> <span class="fa fa-eye"></span></button>';
                                }
                            },
                        ],
                        "columnDefs": [
                            { "width": "20px", "searchable": false, "orderable": false, "targets": [0] },
                            { "className": "text-center custom-middle-align", "targets": [0, 1] },
                            { "visible": false, "targets": [0] },
                        ],
                        "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]]
                    });
                }
            }
            ListAmbil.init();
        }

        $("#isRahasia").change(function () {
            if (this.checked) {
                $("#lblPribadi").removeClass('hidden');
                $("#lblPerusahaan").removeClass('hidden');
            } else {
                $("#lblPribadi").addClass("hidden");
                $("#lblPerusahaan").addClass("hidden");
            }
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href")
            if (target == '#belumAmbil') {
                $('#tbSuratMasuk').DataTable().ajax.reload();
            } else {
                $('#tbSuratMasukDiambil').DataTable().ajax.reload();
            }
        });

        $(document).on('click', '#btnAdd', function (event) {
            event.preventDefault();
            Init();
            GetNoUrut();

            $("#_popUp").modal({ backdrop: 'static' });
            $("#_title").text("Surat Masuk Security Baru");
            $("#_inputState").val("Create");

            $("#tglAmbilGroup").addClass("hidden");
            $("#penerimaGroup").addClass("hidden");
            $("#deptTerimaGroup").addClass("hidden");

            $("#btnSimpan").removeClass("hidden");
            $("#btnSimpan").html("Simpan");
            $("#btnAmbil").addClass("hidden");
            $('#_popUp').on('shown.bs.modal', function () {
                $('#dari').focus();
            })
        });

        $(document).on('click', '#btnEdit', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');

            Init();
            var data = $('#tbSuratMasuk').dataTable().fnGetData(row);

            var Id = data.Id;

            $("#_popUp").modal({ backdrop: 'static' });
            $('#_title').text("Edit Surat Masuk Security");

            GetSuratMasukById(Id);

            $("#_inputState").val("Edit");

            $("#tglAmbilGroup").removeClass("hidden");
            $("#penerimaGroup").removeClass("hidden");
            $("#deptTerimaGroup").removeClass("hidden");

            $("#btnSimpan").removeClass("hidden");
            $("#btnSimpan").html("Update");
            $("#btnAmbil").removeClass("hidden");
            $('#_popUp').on('shown.bs.modal', function () {
                $('#dari').focus();
            })
        });

        $(document).on('click', '#btnDelete', function (event) {
            event.preventDefault();

            var row = $(this).closest('tr');
            var data = $('#tbSuratMasuk').dataTable().fnGetData(row);

            var Id = data.Id;

            if (confirm('Anda yakin ingin hapus data ?')) {
                $.ajax({
                    type: "DELETE",
                    url: '/deletesuratmasuk',
                    cache: false,
                    data: {
                        Id: Id
                    },
                    success: function (data) {
                        if (data.success) {
                            toastr.success(data.message);
                            $('#tbSuratMasuk').DataTable().ajax.reload();
                        } else {
                            toastr.error(data.message);
                        }
                    },
                });
            } else {
                return false;
            }
        });

        $(document).on('click', '#btnSimpan', function (event) {
            event.preventDefault();          

            SimpanData();
        });

        $(document).on('click', '#btnView', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');

            Init();
            var data = $('#tbSuratMasukDiambil').dataTable().fnGetData(row);

            var Id = data.Id;

            $("#_popUp").modal({ backdrop: 'static' });
            $('#_title').text("View Surat Masuk Security");

            GetSuratMasukById(Id);

            $("#_inputState").val("Edit");

            $("#tglAmbilGroup").removeClass("hidden");
            $("#penerimaGroup").removeClass("hidden");
            $("#deptTerimaGroup").removeClass("hidden");

            $("#btnSimpan").addClass("hidden");
            $("#btnAmbil").addClass("hidden");
        });

        $(document).on('click', '#btnAmbil', function (event) {
            event.preventDefault();

            $("#status").val("Diambil");

            SimpanData();
        });

        function SimpanData() {
            var inputState = $("#_inputState").val();
            var id = $("#id").val();
            var tanggal = $("#tanggal").val();
            var noUrut = $("#noUrut").val();
            var flag = $("#flag").val();
            var noSurat = $("#noSurat").val();
            var dari = $("#dari").val();
            var pengirim = $("#pengirim").val();
            var tujuan = $("#tujuan").val();
            var dept = $("#dept").val();
            var security = $("#security").val();
            var ket = $("#ket").val();
            var tglAmbil = $('#tglAmbil').datepicker("getDate");
            var timeAmbil = $("#timeAmbil").val();            
            var idKategori = $("#kategori").val();
            var kategori = $("#kategori option:selected").text();
            //var jenis = $("#jenis").val();
            var jenis = $("input[name='jenis']:checked").val();
            var penerima = $("#penerima").val();
            var deptTerima = $("#deptTerima").val();
            //var media = $("#media").val();
            var media = $("input[name='media']:checked").val();
            var perihal = $("#perihal").val();
            //var akses = $("#akses").val();
            var akses = $("input[name='akses']:checked").val();
            //var rahasia = $("#rahasia").val();
            var isRahasia = $("#isRahasia").is(":checked");
            var rahasia = $("input[name='rahasia']:checked").val();
            var fileName = $("#fileName").val();
            var status = $("#status").val();

            if ($("#status").val() == "Baru") {
                //$("#tglAmbil").datepicker("setDate", "");
                //$("#timeAmbil").val("");
                tglAmbil = "";
                timeAmbil = "";
            }

            if (dari == "") {
                toastr.error("Input Dari.")
                $("#dari").focus();
            } else if (tujuan == "") {
                toastr.error("Input Tujuan.")
                $("#tujuan").focus();
            } else if (dept == "-") {
                toastr.error("Pilih Dept.")
                $("#dept").focus();
            } else if (security == "") {
                toastr.error("Input Security.")
                $("#security").focus();
            } else if (status == "Diambil" && penerima == "") {
                toastr.error("Input Pengambil.")
                $("#penerima").focus();
            } else {
                if (confirm('Anda yakin ingin simpan data?')) {
                    var tgl = null;
                    if (tglAmbil instanceof Date && !isNaN(tglAmbil)) {
                        tgl = `${tglAmbil.getFullYear()}-${String(tglAmbil.getMonth() + 1).padStart(2, '0')}-${String(tglAmbil.getDate()).padStart(2, '0')}` + " " + timeAmbil
                    };
                    
                    var formData = new FormData();
                    formData.append("file", $("#file")[0].files[0]);
                    formData.append("Id", id);
                    formData.append("Tanggal", new Date(tanggal.substring(6, 10), tanggal.substring(3, 5) - 1, tanggal.substring(0, 2), tanggal.substring(11, 13), tanggal.substring(14, 16)).toISOString());
                    formData.append("NoUrut", noUrut);
                    formData.append("Flag", flag);
                    formData.append("NoSurat", noSurat);
                    formData.append("Dari", dari);
                    formData.append("Pengirim", pengirim);
                    formData.append("Tujuan", tujuan);
                    formData.append("Dept", dept);
                    formData.append("Security", security);
                    formData.append("Ket", ket);
                    formData.append("TglAmbil", tgl);
                    formData.append("Penerima", penerima);
                    formData.append("DeptTerima", deptTerima);
                    formData.append("IdKategori", idKategori);
                    formData.append("Kategori", kategori);
                    formData.append("Jenis", jenis);
                    formData.append("Media", media);
                    formData.append("Perihal", perihal);
                    formData.append("Akses", akses);
                    formData.append("IsRahasia", isRahasia);
                    formData.append("Rahasia", rahasia);
                    formData.append("FileName", fileName);
                    formData.append("Status", status);

                    $.ajax({
                        type: inputState == 'Create' ? "POST" : "PUT",
                        url: inputState == 'Create' ? '/postsuratmasuk' : '/putsuratmasuk',
                        data: formData,
                        cache: false,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            if (data.success) {
                                toastr.success(data.message);
                                $("#_popUp").modal('hide');
                                Init();
                                $('#tbSuratMasuk').DataTable().ajax.reload();
                                $('#tbSuratMasukDiambil').DataTable().ajax.reload();
                            } else {
                                toastr.error(data.message);
                                $("#_popUp").modal('hide');
                                Init();
                            }
                        },
                    });
                }
            }
        }

        function GetNoUrut() {
            $.ajax({
                type: "GET",
                url: '/getnourutsuratmasuk',
                data: {
                    Flag: $("#flag").val()
                },
                success: function (result) {
                    if (result != "") {
                        $("#noUrut").val(result);
                    } else {
                        $("#noUrut").val("");
                    }
                },
            });
        }

        function GetSuratMasukById(Id) {
            $.ajax({
                type: "GET",
                url: '/getsuratmasuk',
                data: {
                    Id: Id
                },
                success: function (result) {
                    if (result.Id != 0) {
                        var dt = new Date(FormatDateTime(result.TglAmbil, 'YYYY-MM-DD HH:mm:ss'));
                        var time = String(dt.getHours()).padStart(2, '0') + ":" + String(dt.getMinutes()).padStart(2, '0') + ":" + String(dt.getSeconds()).padStart(2, '0');

                        if (dt <= new Date(1900, 0, 2)) {
                            dt = new Date();
                            time = String(dt.getHours()).padStart(2, '0') + ":" + String(dt.getMinutes()).padStart(2, '0') + ":" + String(dt.getSeconds()).padStart(2, '0');
                        }

                        $("#id").val(result.Id);
                        $('#tanggal').val(FormatDateTime(result.Tanggal, 'DD-MM-YYYY HH:mm:ss')); 
                        $("#noUrut").val(result.NoUrut);
                        $("#noSurat").val(result.NoSurat);
                        $("#dari").val(result.Dari);
                        $("#pengirim").val(result.Pengirim);
                        $("#tujuan").val(result.Tujuan);
                        $("#dept").val(result.Dept).trigger('change');
                        $("#security").val(result.Security);
                        $("#ket").val(result.Ket);
                        $('#tglAmbil').datepicker("setDate", dt);
                        $("#timeAmbil").val(time);
                        $("#kategori").val(result.IdKategori).trigger('change');
                        $("input[name=jenis][value=" + result.Jenis + "]").prop('checked', true);
                        $("#penerima").val(result.Penerima);
                        $("#deptTerima").val(result.DeptTerima).trigger('change');
                        $("input[name=media][value=" + result.Media + "]").prop('checked', true);
                        $("#perihal").val(result.Perihal);
                        $("input[name=akses][value=" + result.Akses + "]").prop('checked', true);
                        $('#isRahasia').prop('checked', result.IsRahasia).trigger('change');
                        $("input[name=rahasia][value=" + result.Rahasia + "]").prop('checked', true);
                        $("#fileName").val(result.FileName);
                        $("#status").val(result.Status);
                    }
                },
            });
        }

        toastr.options = {
            "positionClass": "toast-top-center",
            "timeOut": "1000",
            "preventDuplicates": true,
            "closeButton": true,
            "progressBar": true
        }

        function FormatDateTime(date, format) {
            var datetime = moment(date).format(format)
            return datetime
        }

        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }

    </script>
}
