@using BusinessObjects;
@{
    ViewBag.Title = "Surat Keluar";
    ViewBag.SubTitle = "Home";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    List<ComboList> Kategori = (List<ComboList>)ViewData["Kategori"];
    List<ComboList> Dept = (List<ComboList>)ViewData["Dept"];
    List<ComboList> AksesDept = (List<ComboList>)ViewData["AksesDept"];
    string DeptId = ViewBag.DeptId;
}

<div id="message"></div>
<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header">
                <button type="button" class="btn btn-primary pull-right bottom" id="btnAdd"><span class="bold fa fa-plus"></span>&nbsp;&nbsp;Surat Keluar</button>
            </div>
            @Html.Partial("_SuratHeader")
        </div>
    </div>
</div>

<div class="modal fade" id="_popUp" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content modal-lg panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h2 class="modal-title" id="_title"></h2>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group hidden">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">id</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="_inputState" class="form-control" />
                            <input id="id" class="form-control" equired readonly />
                        </div>
                    </div>

                    <div class="col-sm-6 col-md-6">
                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tanggal</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="tanggal" class="form-control" equired readonly />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">No. Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="noSurat" class="form-control" equired readonly value="@ViewBag.NoSurat" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Pengirim</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="pengirim" class="form-control" equired />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Dept</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <select id="dept" class="form-control select2" style="width:100%">
                                    <option value="-">-</option>
                                    @foreach (var item in Dept)
                                    {
                                        <option value="@item.Value">@item.Value</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Instansi</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="instansi" class="form-control" equired />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Tujuan</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="tujuan" class="form-control" equired />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Kategori Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <select id="kategori" class="form-control select2" style="width:100%">
                                    <option value="-">-</option>
                                    @foreach (var item in Kategori)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <div id="downloadTemplate" class="hidden">
                                    <span>Tidak ada template</span>
                                </div>
                            </div>
                        </div>
                    </div>  

                    <div class="col-lg-6">
                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Jenis Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="jenis" id="internal" value="Internal">Internal</label>
                                <label class="radio-inline"><input type="radio" name="jenis" id="ekternal" value="Eksternal">Eksternal</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Media Surat</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="media" id="hardcopy" value="Hardcopy">Hardcopy</label>
                                <label class="radio-inline"><input type="radio" name="media" id="softcopy" value="Softcopy">Softcopy</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Perihal</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input id="perihal" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Akses</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <label class="radio-inline"><input type="radio" name="akses" id="all" value="All">All</label>
                                <label class="radio-inline"><input type="radio" name="akses" id="tangerang" value="Tng">Tng</label>
                                <label class="radio-inline"><input type="radio" name="akses" id="cikarang" value="Ckr">Ckr</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Akses Dept</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                @Html.DropDownList("Akses Dept", new SelectList(AksesDept, "Value", "Text"), new { multiple = "true", id = "aksesDept", @class = "form-control select2", style = "width:100%" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Rahasia</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <input style="margin-right:15px" id="isRahasia" type="checkbox" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Upload Surat Keluar</label>
                            <label class="col-sm-1 col-md-1 control-label">:</label>
                            <div class="col-sm-8 col-md-7">
                                <div>
                                    <input id="file" class="form-control" type="file" placeholder="Upload Surat Keluar" , required />
                                    <span id="fileName" class="hidden"/>
                                </div>
                                <div id="downloadSuratKeluar" class="hidden" />                                
                            </div>
                        </div>
                    </div>                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSimpan" class="btn btn-primary" style="width:100px">Simpan</button>&nbsp;
                <button type="button" class="btn btn-primary" data-dismiss="modal" style="width:100px">Kembali</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bootstrapDialog" role="dialog" aria-labelledby="myModal-label" aria-hidden="true"></div>

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {                                
            DataTableSuratKeluar();
            $('#aksesDept').select2();

            $('#tanggal').val(FormatDateTime('DD-MM-YYYY HH:mm:ss'));

            $("#message").slideDown(0).slideUp(0);
            var msg = localStorage.getItem("message");
            if (msg != null) {
                var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                $('#message').html(msg1);
                $("#message").slideDown(1000).slideUp(2000);
                localStorage.removeItem("message");
            }
        })

        function Init() {
            $("#id").val(0);
            $('#tanggal').val(FormatDateTime('DD-MM-YYYY HH:mm:ss'));
            //$("#noSurat").val("");
            $("#pengirim").val("");
            $("#dept").val("-").trigger('change');
            $("#instansi").val("");
            $("#tujuan").val("");
            $("#kategori").val("-").trigger('change');
            $('input[name=jenis][value=Eksternal]').prop('checked', true);
            //$("#jenis").val("-").trigger('change');
            //$("#media").val("-").trigger('change');
            $('input[name=media][value=Hardcopy]').prop('checked', true);
            $("#perihal").val("");
            //$("#akses").val("-").trigger('change');
            $('input[name=akses][value=All]').prop('checked', true);
            $("#aksesDept").val("").trigger('change');
            $('#isRahasia').prop('checked', false);
            //$("#rahasia").val("-").trigger('change');
            $("#file").val("");
            $("#fileName").text("");
            $("#downloadTemplate").addClass("hidden");
            $("#downloadSuratKeluar").addClass("hidden");
        }

        var List = null;
        var dtSuratKeluar;
        function DataTableSuratKeluar() {
            List = {
                init: function () {
                    dtSuratKeluar = $('#tbSuratKeluar').DataTable({
                        "serverSide": true,
                        "processing": true,
                        "autoWidth": false,
                        "bInfo": false,
                        "ajax": {
                            "url": "/getlistsuratkeluar",
                            "data": {},
                            "type": 'POST',
                        },
                        "columns": [
                            { "title": "Id", "data": "Id" },
                            {
                                "title": "No",
                                "data": "Id",
                                "orderable": false,
                                "width": "40px",
                                render: function (data, type, row, meta) {
                                    return meta.row + meta.settings._iDisplayStart + 1;
                                }
                            },
                            { "title": "NoSurat", "data": "NoSurat" },
                            {
                                "title": "Tanggal", "data": "Tanggal",
                                "render": function (value) {
                                    if (value === null) return "";
                                    return moment(value).format('DD/MM/YYYY');
                                }
                            },
                            { "title": "Dept", "data": "Dept" },
                            { "title": "Kategori", "data": "Kategori" },
                            { "title": "Dari", "data": "Tujuan" },
                            { "title": "Pengirim", "data": "Pengirim" },
                            { "title": "Perihal", "data": "Perihal" },
                            {
                                data: "NoSurat", "width": "70px", title: "Action", "orderable": false, "render": function (data) {
                                    if (data.substring(8,13) !== '@DeptId.Substring(0, 1)' +'/'+ '@DeptId.Substring(1, 3)') return '<button class="btn btn-xs btn-info" title="View" id="btnView" style="margin-right:5px"> <span class="fa fa-eye"></span></button>'                                  
                                    return '<button class="btn btn-xs btn-primary" title="Edit" id="btnEdit" style="margin-right:5px"> <span class="fa fa-pencil"></span></button>' +
                                            '<button class="btn btn-xs btn-danger" title="Delete" id="btnDelete" style="margin-right:5px"><span class="fa fa-trash"></span></button>';
                                }
                            },
                        ],
                        "columnDefs": [
                            { "width": "20px", "searchable": false, "orderable": false, "targets": [0] },
                            { "className": "text-center custom-middle-align", "targets": [0, 1] },
                            { "visible": false, "targets": [0] },
                        ],
                        "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]]
                    });
                }
            }
            List.init();
        };

        $(document).on('click', '#btnAdd', function (event) {
            event.preventDefault();
            Init();
            GetNoSurat();

            $("#_popUp").modal({ backdrop: 'static' });
            $("#_title").text("Surat Keluar Baru");
            $("#_inputState").val("Create");

            $("#btnSimpan").removeClass("hidden");
            $("#btnSimpan").html("Simpan");
            $('#_popUp').on('shown.bs.modal', function () {
                $('#pengirim').focus();
            })
        });

        $(document).on('click', '#btnEdit', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');

            Init();
            var data = $('#tbSuratKeluar').dataTable().fnGetData(row);

            var Id = data.Id;

            $("#_popUp").modal({ backdrop: 'static' });
            $('#_title').text("Edit Surat Keluar");

            GetSuratKeluarById(Id);

            $("#_inputState").val("Edit");

            $("#btnSimpan").removeClass("hidden");
            $("#btnSimpan").html("Update");
            $('#_popUp').on('shown.bs.modal', function () {
                $('#order').focus();
            })
        });

        $(document).on('click', '#btnView', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');

            Init();
            var data = $('#tbSuratKeluar').dataTable().fnGetData(row);

            var Id = data.Id;

            $("#_popUp").modal({ backdrop: 'static' });
            $('#_title').text("View Surat Keluar");

            GetSuratKeluarById(Id);

            $("#_inputState").val("View");


            $("#btnSimpan").addClass("hidden");
        });

        $(document).on('click', '#btnDelete', function (event) {
            event.preventDefault();

            var row = $(this).closest('tr');
            var data = $('#tbSuratKeluar').dataTable().fnGetData(row);

            var Id = data.Id;

            if (confirm('Anda yakin ingin hapus data ?')) {
                $.ajax({
                    type: "DELETE",
                    url: '/deletesuratkeluar',
                    cache: false,
                    data: {
                        Id: Id
                    },
                    success: function (data) {
                        if (data.success) {
                            toastr.success(data.message);
                            $('#tbSuratKeluar').DataTable().ajax.reload();
                        } else {
                            toastr.error(data.message);
                        }
                    },
                });
            } else {
                return false;
            }
        });

        $(document).on('click', '#btnSimpan', function (event) {
            event.preventDefault();
            var inputState = $("#_inputState").val();
            var id = $("#id").val();
            var tanggal = $("#tanggal").val();
            var instansi = $("#instansi").val();
            var dept = $("#dept").val();
            var noSurat = $("#noSurat").val();
            var tujuan = $("#tujuan").val();
            var idKategori = $("#kategori").val();
            var kategori = $("#kategori option:selected").text();
            var pengirim = $("#pengirim").val();
            var jenis = $("input[name='jenis']:checked").val();
            //var jenis = $("#jenis").val();
            var penerima = $("#penerima").val();
            //var media = $("#media").val();
            var media = $("input[name='media']:checked").val();
            var perihal = $("#perihal").val();
            //var akses = $("#akses").val();
            var akses = $("input[name='akses']:checked").val();
            var aksesDept = $("#aksesDept").val();
            //var rahasia = $("#rahasia").val();
            var isRahasia = $("#isRahasia").is(":checked");
            //var rahasia = $("#isRahasia").is(":checked");
            var fileName = $("#fileName").text();
            //console.log(fileName);
            if (noSurat != "" && pengirim == "") {
                toastr.error("Input Pengirim.")
                $("#pengirim").focus();
            } else if (noSurat != "" && tujuan == "") {
                toastr.error("Input Tujuan.")
                $("#tujuan").focus();
            } else if (noSurat != "" && penerima == "") {
                toastr.error("Input Penerima.")
                $("#penerima").focus();
            } else {
                if (confirm('Anda yakin ingin simpan data?')) {
                    var formData = new FormData();
                    formData.append("file", $("#file")[0].files[0]);
                    formData.append("Id", id);
                    formData.append("Tanggal", new Date(tanggal.substring(6, 10), tanggal.substring(3, 5) - 1, tanggal.substring(0, 2), tanggal.substring(11, 13), tanggal.substring(14, 16)).toISOString());
                    formData.append("NoSurat", noSurat);
                    formData.append("Pengirim", pengirim);
                    formData.append("Dept", dept);
                    formData.append("Instansi", instansi);
                    formData.append("Tujuan", tujuan);
                    formData.append("IdKategori", idKategori);
                    formData.append("Kategori", kategori);
                    formData.append("Jenis", jenis);
                    formData.append("Media", media);
                    formData.append("Perihal", perihal);
                    formData.append("Akses", akses);
                    formData.append("AksesDept", aksesDept);
                    formData.append("IsRahasia", isRahasia);
                    //formData.append("Rahasia", rahasia);
                    formData.append("FileName", fileName);

                    $.ajax({
                        type: inputState == 'Create' ? "POST" : "PUT",
                        url: inputState == 'Create' ? '/postsuratkeluar' : '/putsuratkeluar',
                        data: formData,
                        cache: false,
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            if (data.success) {
                                toastr.success(data.message);
                                $("#_popUp").modal('hide');
                                Init();
                                $('#tbSuratKeluar').DataTable().ajax.reload();
                            } else {
                                toastr.error(data.message);
                                $("#_popUp").modal('hide');
                                Init();
                            }
                        },
                    });
                }
            }
        });

        function GetSuratKeluarById(Id) {
            $.ajax({
                type: "GET",
                url: '/getsuratkeluar',
                data: {
                    Id: Id
                },
                success: function (result) {
                    if (result.Id != 0) {
                        $("#id").val(result.Id);
                        $("#tanggal").val(moment(result.Tanggal).format('DD-MM-YYYY HH:mm:ss'));
                        $("#noSurat").val(result.NoSurat);
                        $("#pengirim").val(result.Pengirim);
                        $("#dept").val(result.Dept);
                        $("#instansi").val(result.Instansi);
                        $("#tujuan").val(result.Tujuan);
                        $("#kategori").val(result.IdKategori).trigger('change');
                        //$("#jenis").val(result.Jenis).trigger('change');
                        $("input[name=jenis][value=" + result.Jenis + "]").prop('checked', true);
                        //$("#media").val(result.Media).trigger('change');
                        $("input[name=media][value=" + result.Media + "]").prop('checked', true);
                        $("#perihal").val(result.Perihal);
                        //$("#akses").val(result.Akses).trigger('change');
                        $("input[name=akses][value=" + result.Akses + "]").prop('checked', true);
                        $("#aksesDept").val(result.AksesDept.split(",")).trigger('change');
                        //console.log(result.AksesDept.split(","));
                        $('#isRahasia').prop('checked', result.IsRahasia).trigger('change');;
                        //$("#rahasia").val(result.Rahasia).trigger('change');
                        $("#fileName").text(result.FileName);
                        if (result.FileName) {
                            $("#downloadSuratKeluar").removeClass("hidden");
                            var link = '@Html.ActionLink("Download Surat Keluar", "DownloadFile", "SuratKeluar", new { FileName  = "_fileName_" }, null)';
                            link = link.replace('_fileName_', result.FileName);
                            $("#downloadSuratKeluar").html(link)
                        } else {
                            $("#downloadSuratKeluar").addClass("hidden");
                        }

                    }
                },
            });
        }

        function GetNoSurat() {
            $.ajax({
                type: "GET",
                url: '/getnosuratkeluar',
                data: {},
                success: function (result) {
                    if (result != "") {
                        $("#noSurat").val(result);
                    } else {
                        $("#noSurat").val("");
                    }
                },
            });
        }

        $(document).on('change', '#kategori', function (event) {
            event.preventDefault();
            var IdKategori = $("#kategori").val();
            if (IdKategori !== "-") {
                $.ajax({
                    type: "GET",
                    url: '/getkategorikode',
                    data: {
                        IdKategori: IdKategori
                    },
                    success: function (result) {
                        if (result.Id != 0) {
                            if (result.FileName) {
                                $("#downloadTemplate").removeClass("hidden");
                                var link = '@Html.ActionLink("Download template", "DownloadFile", "KategoriSurat", new { FileName  = "_fileName_" }, null)';
                                link = link.replace('_fileName_', result.FileName);
                                $("#downloadTemplate").html(link)
                            } else {
                                $("#downloadTemplate").addClass("hidden");
                            }
                        }
                    },
                });
            }

        });

        toastr.options = {
            "positionClass": "toast-top-center",
            "timeOut": "1000",
            "preventDuplicates": true,
            "closeButton": true,
            "progressBar": true
        }

        function FormatDateTime(format) {
            const today = new Date();

            var datetime = moment(today).format(format);
            return datetime
        }

        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }

    </script>
}
