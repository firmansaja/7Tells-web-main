@using BusinessObjects;
@{
    ViewBag.Title = "PR Detail";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "E-PR";
    ViewBag.Link = "/User/PR";
    PR PRHeader = (PR)ViewData["PRHeader"];
    List<PRDetail> ListPRDetail = (List<PRDetail>)ViewData["ListPRDetail"];
    List<PRApproval> ListApproval = (List<PRApproval>)ViewData["ListApproval"];
    PRAksesUser AkseUser = (PRAksesUser)ViewData["AksesUser"];
    var Dept = @AkseUser.Dept;
    int Kol = @AkseUser.Kol;
    string Site = @AkseUser.Site;
    int cek = 0;
}

<div class="box box-primary" style="overflow-x:auto">
    <div class="box-body">
        <div class="row">
            <div class="col-xs-12">
                <table style="width:100%">
                    <tr>
                        <td colspan="2" rowspan="2" style="width:30%;text-align:center"><img class="rounded float-left" width="150" height="100" src="/Images/Logo.png" alt="Image"></td>
                        <td colspan="3" style="width:60%;vertical-align:middle"><h3>PERMOHONAN PEMBELIAN BARANG / PURCHASE REQUEST</h3></td>
                    </tr>
                    <tr>
                        <td style="width:20%;vertical-align:middle"><h5>Bagian&nbsp:&nbsp<b><span id="prBagian">@PRHeader.Description</span></b></h5></td>
                        <td style="width:20%;vertical-align:middle"><h5>No&nbsp:&nbsp<b><span id="prNo">@PRHeader.PRNo</span></b></h5></td>
                        <td style="width:20%;vertical-align:middle"><h5>Tanggal&nbsp:&nbsp<b><span id="prDate">@String.Format("{0:dd/MM/yyyy}", @PRHeader.PRDate)</span></b></h5></td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <table id="tblPRDetail" style="width:100%;border-color:black;overflow-x:auto;overflow-y:auto" class="table table-bordered">
                    <thead>
                        <tr>
                            <th style="text-align:center;vertical-align:middle;border-color:black"><input type="checkbox" class="select-all checkbox" id="selectall" /></th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Informasi / Supplier</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Harga</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Nama Barang</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">InvtID</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jumlah</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Unit<br />Price (Rp)</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Dipergunakan Untuk</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Account</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Sub<br />Account</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Terakhir<br />Beli</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Tanggal Kirim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ListPRDetail)
                        {
                            if (@item.Cek2 == "checked")
                            {
                                cek++;
                            }
                            <tr>
                                <td style="text-align:center; vertical-align:middle;border-color:black"><input type="checkbox" class="singlechkbox" name="singlechkbox" value="1" @item.Cek2 /></td>
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black"><textarea class="komen" rows="1" oninput="AutoGrow(this)" id="txtComment_@item.No" style="width:100%;resize:none">@item.Komentar2</textarea></td>
                                <td style="vertical-align:middle;border-color:black"><input style="width:100%;text-align:right" type="text" onkeypress="myFunction(event)" id="txtHarga_@item.No" value=@item.Harga></td>
                                @if (@item.Qty == @item.QtyPO)
                                {
                                    <td style="text-align:center;vertical-align:middle;border-color:black;background-color:#FFCC00">@item.No</td>
                                }
                                else
                                {
                                    <td style="text-align:center;vertical-align:middle;border-color:black">@item.No</td>
                                }
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black">@item.NamaBarang<br />@item.InvtSpec</td>
                                <td style="vertical-align:middle;border-color:black">@item.InvtID</td>
                                @*<td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black">@item.Qty&nbsp @item.UnitQty</td>*@
                                <td style="word-wrap:break-word;white-space:pre-wrap;vertical-align:middle;border-color:black"><input style="width:100%" type="text" onkeyup="validasiMax(@item.No, @item.Qty)" onkeypress="myFunction(event)" id="txtQty_@item.No" value=@item.Qty><br />@item.UnitQty</td>
                                <td style="text-align:right;vertical-align:middle;border-color:black">@String.Format("{0,14:n0}", @item.Price)</td>
                                <td style="word-wrap: break-word;white-space: pre-wrap;vertical-align:middle;border-color:black">@item.Remark<br />@item.AccountDesc</td>
                                <td style="vertical-align:middle;border-color:black">@item.Account</td>
                                <td style="vertical-align:middle;border-color:black">@item.SubAccount</td>
                                <td style="vertical-align:middle;border-color:black">@item.PODate</td>
                                <td style="vertical-align:middle;border-color:black">@item.DelDate</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="5" style="text-align:center; vertical-align:middle;border-color:black">Diminta :</td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black">Diketahui :</td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black">Disetujui :</td>
                        </tr>
                        <tr>
                            <td colspan="5" style="text-align:center; vertical-align:middle;border-color:black" height="70px"><span id="prApproveBy1">By :</span></td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black" height="70px"><span id="prApproveBy2">By :</span></td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black" height="70px"><span id="prApproveBy3">By :</span></td>
                        </tr>
                        <tr>
                            <td colspan="5" style="text-align:center; vertical-align:middle;border-color:black"><span id="prApproveAt1">Tanggal :</span></td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black"><span id="prApproveAt2">Tanggal :</span></td>
                            <td colspan="4" style="text-align:center; vertical-align:middle;border-color:black"><span id="prApproveAt3">Tanggal :</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-11">
                <h5 class="pull-right">Tanggal Cetak : <span id="dtCetak"></span></h5>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-1">
            </div>
            @if (@PRHeader.OverBudget == "")
            {
                <div class="col-xs-11">
                    <h5>-</h5>
                </div>
            }
            else
            {
                <div class="col-xs-11">
                    <h5>Over budget Account No : <span>@PRHeader.OverBudget</span></h5>
                </div>
            }
        </div>
        <div class="row">
            <div class="col-xs-1">
            </div>
            <div class="col-xs-11">
                <h6 style="font-style: italic">@PRHeader.Remark</h6>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <h6 style="font-style: italic">NB : Dokumen elektronik ini sudah merupakan bukti yang sah sebagai Permohonan Pembelian Barang / Purchase Request</h6>
            </div>
        </div>
        <div class="row no-print">
            <div class="col-xs-12">
                <button class="btn btn-primary pull-left margin" id="btnUpdatePR">Update</button>
                <button class="btn btn-primary pull-right margin" id="btnViewReport">View Report</button>
                <button class="btn btn-primary pull-right margin" id="btnViewReportAll">View Report All</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
	    $(document).ready(function () {
		    SetFooter();
            (function ($) {
                $.fn.autogrow = function () {
                    return this.each(function () {
                        AutoGrow(this);
                    });
                };
            })(jQuery);
            var xData = @Html.Raw(Json.Encode(@ListPRDetail));
            if (xData.length > 0) {
                for (var i = 0; i < xData.length; i++) {
                    var no = xData[i].No.toString();
                    $('#txtComment_' + no).autogrow();
                }
            }

            if (xData.length == @cek && xData.length != 0) {
                $('#selectall').prop('checked', true);
            }
	    });

	    $("#selectall").click(function () {
		    $('.singlechkbox').prop('checked', this.checked);
	    });

	    $(".singlechkbox").click(function () {
		    if ($('.singlechkbox').length == $('.singlechkbox:checked').length) {
			    $('#selectall').prop('checked', true);
                } else {
			    $("#selectall").prop('checked', false);
		    }
        });

        function AutoGrow(obj) {
		    $(obj).css('height', 'auto').css('height', obj.scrollHeight + (obj.offsetHeight - obj.clientHeight));
	    }

	    function SetFooter() {
            const today = new Date();
            var TglCetak = ((today.getMonth() > 8) ? (today.getMonth() + 1) : ('0' + (today.getMonth() + 1))) + '-' + ((today.getDate() > 9) ? today.getDate() : ('0' + today.getDate())) + '-' + today.getFullYear();
            $("#dtCetak").html(TglCetak);

		    var xValue = @Html.Raw(Json.Encode(@ListApproval));
		    for (var i = 0; i < xValue.length; i++) {
			    if (xValue[i].Kol == 1) {
				    $("#prApproveBy1").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt1").html("Tanggal : " + xValue[i].Tanggal);
                    } else if (xValue[i].Kol == 2) {
				    $("#prApproveBy2").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt2").html("Tanggal : " + xValue[i].Tanggal);
                    } else if (xValue[i].Kol == 3) {
				    $("#prApproveBy3").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt3").html("Tanggal : " + xValue[i].Tanggal);
			    }
		    }
        }

        function myFunction(evt) {
            //var verified = (e.which == 8 || e.which == undefined || e.which == 0) ? null : String.fromCharCode(e.which).match(/[.],[^0-9]/);
            //if (verified) {
            //    e.preventDefault();
            //}
            var theEvent = evt || window.event;

            // Handle paste
            if (theEvent.type === 'paste') {
                key = event.clipboardData.getData('text/plain');
            } else {
                // Handle key press
                var key = theEvent.keyCode || theEvent.which;
                key = String.fromCharCode(key);
            }
            var regex = /[0-9]|\./;
            if (!regex.test(key)) {
                theEvent.returnValue = false;
                if (theEvent.preventDefault) theEvent.preventDefault();
            }
        }

        function validasiMax(i, max) {
            if (max < $('#txtQty_' + i.toString()).val()) {
                alert("Qty tidak boleh lebih besar dari current Qty nya!");
                $('#txtQty_' + i.toString()).val(max)
            }

        }

        $(document).on('click', '#btnUpdatePR', function (event) {
            event.preventDefault();
            if (confirm('Apakah Yakin Ingin Update Komentar ?')) {
                var PRDetail = [];
                $("#tblPRDetail tr").each(function () {
                    var currentRow = $(this);
                    var No = currentRow.find("td:eq(3)").text();
                    var obj = {};
                    obj.PRNo = '@PRHeader.PRNo';
                    obj.No = No;
                    obj.Komentar2 = "";
                    obj.Harga = "";
                    obj.Qty = "";

                    PRDetail.push(obj);
                });
                PRDetail.splice((PRDetail.length - 3), 3);
                PRDetail.splice(0, 1);
                for (var i = 0; i < PRDetail.length; i++) {
                    PRDetail[i].Komentar2 = $('#txtComment_' + PRDetail[i].No).val();
                    PRDetail[i].Harga = $('#txtHarga_' + PRDetail[i].No).val();
                    PRDetail[i].Qty = $('#txtQty_' + PRDetail[i].No).val();
                }

                PRDetail = JSON.stringify({ 'PRDetail': PRDetail });

                $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    type: 'POST',
                    url: '@Url.Action("UpdateInfoHargaPR", "PR", new { area ="User"})',
                    data: PRDetail ,
                    success: function (data) {
                        if (data.success) {
                            window.location = "/user/pr";
                            localStorage.setItem("message", data.message)
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
            } else {
                return false
            }
        });

        $(document).on('click', '#btnViewReport', function (event) {
            event.preventDefault();

            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewReportPR", "PR", new { area ="User"})',
                data: { PRNo: '@PRHeader.PRNo', Year: '', RptName: 'RptPRDetailPur' },
                success: function (data) {
                    if (!data.result) {
                        alert("Error");
                    }
                    else {
                        window.open("/Reports/ReportPR.aspx", '_blank');
                    }
                }
            });
        });

        $(document).on('click', '#btnViewReportAll', function (event) {
            event.preventDefault();

            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewReportPR", "PR", new { area ="User"})',
                data: { PRNo: '@PRHeader.PRNo', Year: '', RptName: 'RptPRDetailAll' },
                success: function (data) {
                    if (!data.result) {
                        alert("Error");
                    }
                    else {
                        window.open("/Reports/ReportPR.aspx", '_blank');
                    }
                }
            });
        });

    </script>
}
