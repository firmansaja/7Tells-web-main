@using BusinessObjects;
@{
    List<ComboList> ListDept = (List<ComboList>)ViewData["ListDept"];
}

<div id="cprogress" class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">PR PROGRESS</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-xs-12">
                        <table>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Dari Tanggal</label>
                                        <div class="input-group date" id="dtDariP">
                                            <input type="text" class="form-control" />
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>Sampai</label>
                                        <div class="input-group date" id="dtSampaiP">
                                            <input type='text' class="form-control" />
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Cabang</label>
                                        <select id="txtCabangP" class="form-control select2" style="width:100%">
                                            <option value="All">-- All --</option>
                                            <option value="1">TNG</option>
                                            <option value="2">CMG</option>
                                            <option value="3">TSC3</option>
                                            <option value="4">TSC3A</option>
                                        </select>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>Purchase Type</label>
                                        <select id="txtPurTypeP" class="form-control select2" style="width:100%">
                                            <option value="All">-- All --</option>
                                            <option value="GI">Production Item</option>
                                            <option value="GN">Non Production Item</option>
                                            <option value="SE">Non PO</option>
                                        </select>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Department</label>
                                        <select id="txtDeptP" class="form-control select2" style="width:100%">
                                            <option value="All">-- All --</option>
                                            @foreach (var item in ListDept)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>File Name</label>
                                        <input type="text" class="form-control" value="PR-Excel" id="txtFileNameP">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><button type="button" class="btn btn-primary" id="BtnViewProgress"><span class="bold fa fa-eye"></span>&nbsp;&nbsp;Preview</button>&nbsp;&nbsp<button type="button" class="btn btn-success" id="BtnDownloadProgress" onclick="ExportExcelProgress()"><span class="bold fa fa-download"></span>&nbsp;&nbsp;Download</button></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="box-footer" style="overflow-x:auto">
                <div class="row">
                    <div class="col-xs-12">
                        <table class="table table-bordered table-striped table-condensed table-responsive table-hover" id="tbPRProgress"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function ExportExcelProgress(e) {
        var stDate = $('#dtDariP').datepicker("getDate");
        var enDate = $('#dtSampaiP').datepicker("getDate");
        $.ajax({
            url: '@Url.Action("ExportExcelProgress", "PR", new { area ="User"})',
            //contentType: "application/json; charset=utf-8",
            dataType: "JSON",
            type: "POST",
            data: {
                DTDari: stDate.toISOString(),
                DTSampai: enDate.toISOString(),
                Cabang: $('#txtCabangP').val(),
                Dept: $('#txtDeptP').val(),
                PurchaseType: $('#txtPurTypeP').val(),
                FileName: $('#txtFileNameP').val()
            },
            beforeSend: function () {
                $('#BtnDownloadProgress').attr('disabled',true);
            },
            success: function (data) {
                if (data.success) {
                    window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "Download" })/?fileName=" + $('#txtFileNameP').val() + ".xlsx";
                }
            },
            complete: function () {
                $('#BtnDownloadProgress').attr('disabled', false);
            },
            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }
</script>
