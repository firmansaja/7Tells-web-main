                        ],
                        //"lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]]
                    });
                }
            }
            ListPRByUser.init();
        }

        $(document).on('click', '#btnPRNoUser', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbPRByUser').dataTable().fnGetData(row);
            var _PRNo = EncryptURL(data.PRNo)
            //var _PRNo = data.PRNo;
            var url = "/viewpruser/" + _PRNo;
            window.location.href = url;
        });

        $(document).on('click', '#BtnRejectUser', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbPRByUser').dataTable().fnGetData(row);
            var _PRNo = data.PRNo;
            if (confirm('Anda yakin akan Reject PR ?')) {
                UpdateReject(_PRNo);
                $('#tbPRByUser').DataTable().ajax.reload();
            } else {
                return false;
            }
        });

        // List PR Approved By All
        var ListPRByAll;
        var dtPRByAll;
        function DataTablePRByAll() {
            ListPRByAll = {
                dtPRByAll: null,
                init: function () {
                    dtPRByAll = $('#tbPRByAll').DataTable({
                        "serverSide": true,
