            } else {
                if (confirm('Anda Yakin Ingin Over Budget ?')) {
                    $.ajax({
                        url: '@Url.Action("UpdateOverBudgetPR", "PR", new { area ="User"})',
                        dataType: "json",
                        type: "POST",
                        cache: false,
                        data: { PRNo: PRNo} ,
                        success: function (data) {
                            $("#txtPRNo").val("");
                            $("#_popUp").modal('hide');
                            if (data.success) {
                                //$('#tbPRPur').DataTable().ajax.reload();
