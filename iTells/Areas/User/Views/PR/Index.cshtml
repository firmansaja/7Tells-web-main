                dataType: "json",
                type: "POST",
                cache: false,
                data: { Action: _Action, PRNo: __prno} ,
                success: function (data) {
                    if (data.success) {
                        $('#tbPRPur').DataTable().ajax.reload();
                        //var message = '<h3 class=\"alert alert-success fade in\">' + data.message + '</h3>';
                        //$('#message').html(message);
                        //$("#message").slideDown(1000).slideUp(2000);

                        PopupMessage(true, data.message);
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }

