        $(document).on('click', '#btnPRNoAll', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbPRByAll').dataTable().fnGetData(row);
            var _PRNo = EncryptURL(data.PRNo);
            //var _PRNo = data.PRNo;
            if ('@Dept'.substring(1, 4) == "PUR" || '@Dept'.substring(1, 4) == "PVM") {
                var url = "/viewprpurchase/" + _PRNo;
            } else {
