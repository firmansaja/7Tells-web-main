            }
            //window.location.href = url;
            window.open(url, '_blank');
        });

        // List PR Purchasing Area
        var ListPRPur = null;
        var dtPRPur;
        function DataTablePRPur() {
            ListPRPur = {
                dtPRPur: null,
                init: function () {
                    dtPRPur = $('#tbPRPur').DataTable({
                        "serverSide": true,
                        "processing": true,
                        "autoWidth": false,
                        "bInfo": false,
                        "bPaginate": false,
                        "ajax": {
                            "url": "/getmodelprpur",
                            "type": 'POST',
                        },
                        "columns": [
                            {
                                "data": "null", "title": "Action", "render": function (data) {
                                    return '<button class="btn btn-xs btn-info" title="Edit" id="BtnEditPR" style="margin-right:5px"> <span class="fa fa-eye"></span></button>';
