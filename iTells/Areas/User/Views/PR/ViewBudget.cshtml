@section scripts{
    <script>
        $(document).ready(function () {
            $('#tblBudget').DataTable({
                "destroy": true,
                scrollY: "400px",
                scrollX: true,
                scrollCollapse: true,
                paging: false,
                search: false,
                bFilter: false,
                bInfo: false,
                fixedColumns: {
                    leftColumns: 3
                },
                "aaSorting": [],
                columnDefs: [
                    { "width": "10px", "orderable": false, "targets": [0] },
                ],
            });

        })

        $(function () {
            $(document).on('click', 'button[data-dismiss]', function (e) {
                location.reload();
            });
        });

        function ExportExcel(e) {
            $.ajax({
                url: '@Url.Action("ExportExcelBudget", "PR", new { area ="User"})',
                dataType: "JSON",
                type: "POST",
                data: {
                    Dept: '@ViewBag.Sub',
                    Year: '@ViewBag.Year'
                },
                beforeSend: function () {
                    $('#btnExportBudget').attr('disabled', true);
                },
                success: function (data) {
                    if (data.success) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "Download" })/?fileName=" + "Report Budget.xlsx";
                    }
                },
                complete: function () {
                    $('#btnExportBudget').attr('disabled', false);
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }

        function ExportBudgetDetail(Month) {
            $.ajax({
                url: '@Url.Action("ExportExcelBudgetDetail", "PR", new { area ="User"})',
                dataType: "JSON",
                type: "POST",
                data: {
                    Year: '@ViewBag.Year',
                    Month: Month,
                    Sub: '@ViewBag.Sub',
                    Acct: $('#txtAccount').html()
                },
                beforeSend: function () {
                    $('#btnExportBudgetDetail').attr('disabled',true);
                },
                success: function (data) {
                    if (data.success) {
                        window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "Download" })/?fileName=" + "Report Budget Detail.xlsx";
                    }
                },
                complete: function () {
                    $('#btnExportBudgetDetail').attr('disabled', false);
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }
    </script>
}

