
@using BusinessObjects;

@{
    CRAkses _cRAkses = (CRAkses)ViewData["AksesUser"];
    List<BO_ECirculation> list = (List<BO_ECirculation>)ViewData["ListCRHeadDetail"];

    ViewBag.Title = "CIRCULATION OPINION";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var Group = "";

}

<head>


    <style>

        * {
            margin: 0;
            padding: 0;
        }

        .pencarian {
            display: grid;
            grid-template-columns: 80px 1.5fr 100px 1.5fr 0.8fr;
            grid-template-areas: 'lb1 tg1 lb2 tg2 cari';
            margin-bottom: 5px;
            border: 2px;

        }

        .lb1 {
            grid-area: lb1;
            padding-left: 6px;
            display: flex;
            align-items: center;
 
        }

        .lb2 {
            grid-area: lb2;
            padding-left: 6px;
            display: flex;
            align-items: center;
    
        }

        .tg1 {
            grid-area: tg1;
            display: flex;
            align-items: center;
        }

        .tg2 {
            grid-area: tg2;
            display: flex;
            align-items: center;
        }

        .cari {
            grid-area: cari;
            padding-left: 6px;
            align-items: center;
        }



        @@media (max-width:600px) {
            .pencarian { display: grid; grid-template-columns: 80px 1fr; grid-template-areas: 'lb1 tg1' 'lb2 tg2' 'a cari'; grid-gap: 5px; }

            .cari {
                grid-area: cari;
                padding-left: 0px;
                align-items: center;
            }

            .tg1 {
                margin-right: 6px
            }

            .tg2 {
                margin-right: 6px
            }
        }
    </style>
</head>


