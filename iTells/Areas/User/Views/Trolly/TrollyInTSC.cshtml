
@{
    ViewBag.Title = "Trolly In TSC";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .grid_center {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-column-gap: 10px;
            grid-row-gap: 5px;
        }

        .container_barcode {
            display: grid;
            justify-content: center;
            align-items: center;
            grid-auto-flow: row;
            grid-row-gap: 5px;
            background-color: #CCCCCC;
            padding: 5px;
            margin: 5px 0px;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 0px;
        }

        .form-control {
            border-radius: 5px;
        }

        .box-header {
            padding: 10px 10px 0px 10px;
        }

        @@media only screen and (max-width:640px) {
            .box-header {
                padding: 5px 5px 0px 5px;
            }

            .c-header {
                font-size: 14px;
            }

            .col-xs-12 {
                padding: 0px;
            }

            .grid_center {
                grid-gap: 5px;
                font-size: 10px;
            }

            .form-control {
                border-radius: 5px;
                padding: 2px 8px;
                font-size: 10px;
                height: 20px;
            }

            .btn {
                padding: 2px 8px;
                font-size: 10px;
            }

            h4.small {
                font-size: 10px;
            }

            .container_barcode {
                display: grid;
                grid-auto-flow: column;
                grid-gap: 5px;
                align-items: center;
                justify-content: space-around;
            }

            .table-container {
                font-size: 10px;
            }

            .main-header .logo {
                display: none;
            }

            .fixed .content-wrapper, .fixed .right-side {
                padding-top: 50px;
            }
        }

        table {
            /*width: 50%;*/
            counter-reset: row-num;
        }

            table tbody tr {
                counter-increment: row-num;
            }

                table tbody tr td:first-child::before {
                    content: counter(row-num) "";
                }
    </style>
</head>

<div class="box box-primary">
    <div class="box-header with-border header-font">
        <div class="col-xs-12">
            <div align="center" class="row">
                <h1 class="c-header" style="margin:0; font-weight:bold; color:#0288E1">TROLLY MASUK TSC</h1>
            </div>
        </div>
    </div>
    <div class="box-body">
        <div class="col-xs-12">
            <div class="grid_center">
                <div class="form-group">
                    <label style="margin:0">No Surat Jalan</label>
                    <input type="text" class="form-control" value="" id="txtNoTransDepo">
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">No. Trans</label>
                    <input type="text" class="form-control" value="" id="txtNoTrans" disabled>
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">Tanggal</label>
                    <input type="text" class="form-control" value="" id="dtTgl" disabled>
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">Jam</label>
                    <input type="text" class="form-control" value="" id="txtJam" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">No. Mobil</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNoMobil">
                </div>
                <div class="form-group">
                    <label style="margin:0">Nama Supir</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNamaSupir">
                </div>
            </div>
            <div class="container_barcode">
                <div align="center">
                    <h4 class="small" style="margin:0; font-weight:bold">QR TROLLY</h4>
                </div>
                <div>
                    <input style="max-width:300px;" type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtKodeQR">
                </div>
                <div align="center">
                    <button id="btnSubmit" class="btn btn-primary" onclick="return SimpanTrollyInTSC()">Submit</button>
                </div>
            </div>
            <div class="table-container" style="overflow-x:auto">
                <table class="table" id="tblTrollyInTSC" style="border-color:black;width:100%">
                    <thead>
                        <tr style="border-color:black">
                            <th style="text-align:center;vertical-align:middle;border-color:black">No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">QR Trolly</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Project</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jenis Trolly</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        let listTrolly = [];
        $(document).ready(function () {
            var menuItem = $('#trolly');
            menuItem.addClass('active');
            var subMenuItem = menuItem.find('#trollyin');
            subMenuItem.addClass('active');

            $('#dtTgl').val(FormatDateTime('DD-MM-YYYY'));
            $('#txtJam').val(FormatDateTime('HH:mm:ss'));

            var msg = localStorage.getItem("message");
            var scs = localStorage.getItem("success");
            if (msg != null) {
                //var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                //$('#message').html(msg1);
                //$("#message").slideDown(1000).slideUp(2000);
                PopupMessage(scs, msg);
                localStorage.removeItem("message");
                localStorage.removeItem("success");
            }

            $('#txtNoTransDepo').focus();
        })

        // Input no surat jalan
        $(document).on('focus', '#txtNoTransDepo', function (event) {
            //event.preventDefault();
            $('#txtNoTransDepo').val('');
        });

        $(document).on('keypress', '#txtNoTransDepo', function (event) {
            if (event.which === 32) {
                event.preventDefault();
            }

            if (event.key === "Enter") {
                event.preventDefault();
                CheckSuratJalan($('#txtNoTransDepo').val());
            }
        });

        // Input no mobil
        $(document).on('focus', '#txtNoMobil', function (event) {
            //event.preventDefault();
            $('#txtNoMobil').val('');
        });

        $(document).on('keypress', '#txtNoMobil', function (event) {
            if (event.which === 32) {
                event.preventDefault();
            }

            if (event.key === "Enter") {
                event.preventDefault();
                if ($('#txtNoTransDepo').val() === '') {
                    $('#txtNoTransDepo').focus();
                } else if ($('#txtNamaSupir').val() === '') {
                    $('#txtNamaSupir').focus();
                } else if ($('#txtKodeQR').val() === '') {
                    $('#txtKodeQR').focus();
                } else {
                    CheckSuratJalan($('#txtNoTransDepo').val());
                }
            }
        });

        // Input nama supir
        $(document).on('focus', '#txtNamaSupir', function (event) {
            //event.preventDefault();
            $('#txtNamaSupir').val('');
        });

        $(document).on('keypress', '#txtNamaSupir', function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                if ($('#txtNoTransDepo').val() === '') {
                    $('#txtNoTransDepo').focus();
                } else if ($('#txtNoMobil').val() === '') {
                    $('#txtNoMobil').focus();
                } else if ($('#txtKodeQR').val() === '') {
                    $('#txtKodeQR').focus();
                } else {
                    CheckSuratJalan($('#txtNoTransDepo').val());
                }
            }
        });

        // Input barcode
        $(document).on('focus', '#txtKodeQR', function (event) {
            //event.preventDefault();
            $('#txtKodeQR').val('');
        });

        $(document).on('keypress', '#txtKodeQR', function (event) {
            var kodeQR = $('#txtKodeQR').val();
            var noSuratJalan = $('#txtNoTransDepo').val();

            if (kodeQR !== '' && event.key === "Enter") {
                if (noSuratJalan === '') {
                    alert('No surat jalan harus diisi!')
                    $('#txtNoTransDepo').focus();
                } else {
                    event.preventDefault();
                    CheckSuratJalan(noSuratJalan);
                }
            }
        });

        // Hapus trolly
        $("#tblTrollyInTSC").on('click', '.btnHapus', function () {
            $(this).closest('tr').remove();
        });

        @*function CheckMobil(noMobil) {
            $.ajax({
                url: '@Url.Action("CheckNoMobil", "Trolly", new { area ="User"})',
                dataType: "json",
                type: "GET",
                data: { noMobil: noMobil },
                async: false,
                success: function (data) {
                    if (!data.success) {
                        alert(data.message)
                        //PopupMessage(false, data.message);
                        $('#txtNoMobil').focus();
                    } else {
                        $('#txtNoMobil').prop('disabled', true);
                        noTransDepo = data.dataTrolly[0].NoTrans;
                        listTrolly = data.dataTrolly;
                        AddTrollyIn();
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }*@

        function CheckSuratJalan(noMobil) {
            $.ajax({
                url: '@Url.Action("CheckSuratJalan", "Trolly", new { area ="User"})',
                dataType: "json",
                type: "GET",
                data: { noTransDepo: noMobil },
                async: false,
                success: function (data) {
                    if (!data.success) {
                        alert(data.message)
                        //PopupMessage(false, data.message);
                        $('#txtNoTransDepo').focus();
                    } else {
                        $('#txtNoTransDepo').prop('disabled', true);
                        $('#txtNoMobil').val(data.dataTrolly[0].NoMobil);
                        $('#txtNamaSupir').val(data.dataTrolly[0].NamaSupir);
                        listTrolly = data.dataTrolly;
                        if ($('#txtNoMobil').val() === '') {
                            $('#txtNoMobil').focus();
                        } else if ($('#txtNamaSupir').val() === '') {
                            $('#txtNamaSupir').focus();
                        } else if ($('#txtKodeQR').val() === '') {
                            $('#txtKodeQR').focus();
                        } else {
                            AddTrollyIn();
                        }                             
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }

        function AddTrollyIn() {
            var kodeQR = $('#txtKodeQR').val();
            let listPart = listTrolly.filter(obj => obj.KodeQR === kodeQR);

            if (listPart.length === 0) {
                alert(`Kode QR ${kodeQR} tidak ditemukan!`);
                //PopupMessage(false, `Kode QR ${kodeQR} tidak ditemukan!`);
                $('#txtKodeQR').focus();
            } else {
                var table = document.getElementById("tblTrollyInTSC").getElementsByTagName('tbody')[0];
                var rowCount = table.rows.length;

                var isReady = false;

                for (var i = 0; i < rowCount; i++) {
                    var kodeTrolley = table.rows[i].cells[1].textContent.trim();
                    if (kodeTrolley === kodeQR) {
                        alert(`Kode trolly ${kodeQR} sudah ada!`);
                        //PopupMessage(false, `Kode trolley ${barcode} sudah ada!`);
                        $('#txtKodeQR').focus();
                        isReady = true;
                        break;
                    }
                }

                if (!isReady) {
                    var newRow = table.insertRow(rowCount);
                    newRow.setAttribute("style", "text-align:center;vertical-align:middle");

                    newRow.insertCell(0);
                    var cKodeTrolley = newRow.insertCell(1);
                    var cProject = newRow.insertCell(2);
                    var cJenisTrolley = newRow.insertCell(3);
                    var cPilihan = newRow.insertCell(4);
                    cKodeTrolley.innerHTML = kodeQR;
                    cProject.innerHTML = listPart[0].Project;
                    cJenisTrolley.innerHTML = listPart[0].TypeTrolly;
                    cPilihan.innerHTML = '<button class="btn btn-xs btnHapus" title="Hapus" style="color:red"><span class="fa fa-trash"></span></button>';
                }
            }
            $('#txtKodeQR').val('');
        }

        function SimpanTrollyInTSC() {
            var NoMobil = $("#txtNoMobil").val();
            var NamaSupir = $("#txtNamaSupir").val();
            var table = document.getElementById("tblTrollyInTSC").getElementsByTagName('tbody')[0];;
            var rowCount = table.rows.length;

            if (NoMobil == "") {
                alert("No Mobil tidak boleh kosong!")
            } else if (NoMobil.length > 9) {
                alert("Cek nomor mobil!")
            } else if (NamaSupir == "") {
                alert("Nama supir tidak boleh kosong!")
            } else if (rowCount == 0) {
                alert("Data trolley tidak boleh kosong!")
            } else {
                if (cekTrollyTSCvsDepo()) {
                    simpanData();
                } else {
                    let confirm = prompt("Data trolly tidak sesuai, masukkan password:");
                    if (confirm == null || confirm == "") {
                        return false;
                    } else {

                        if (confirm === "ScaninTSC") {
                            simpanData();
                        } else {
                            alert("Password tidak valid")
                        }
                    }
                }         
            }
        }

        function simpanData() {
            if (confirm('Yakin ingin simpan data?')) {

                $('#btnSubmit').prop('disabled', true);

                var Details = [];
                $("#tblTrollyInTSC tbody tr").each(function () {
                    var currentRow = $(this);
                    var kodeQR = currentRow.find("td:eq(1)").text();
                    var project = currentRow.find("td:eq(2)").text();
                    var typeTrolly = currentRow.find("td:eq(3)").text();

                    var obj = {};
                    obj.NoTrans = "";
                    obj.KodeQR = kodeQR;
                    obj.Project = project;
                    obj.TypeTrolly = typeTrolly;
                    obj.Qty = 1;
                    obj.Satuan = 'Unit';

                    Details.push(obj);
                });

                $.ajax({
                    url: '@Url.Action("SimpanTrollyInOutTSC", "Trolly", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: {
                        NoTrans: $('#txtNoTrans').val(),
                        NoTransDepo: $('#txtNoTransDepo').val(),
                        InOut: "IN",
                        TglTrans: new Date().toISOString(),
                        CustId: 'TSC',
                        NoMobil: $('#txtNoMobil').val(),
                        NamaSupir: $('#txtNamaSupir').val(),
                        Details: Details,
                    },
                    success: function (data) {
                        if (data.success) {
                            $("#txtNoMobil").val('');
                            $("#txtNamaSupir").val('');
                            $("#tblTrollyInTSC").find("tr:gt(0)").remove();
                            alert(data.message);
                            //PopupMessage(true, data.message);
                            $('#btnSubmit').prop('disabled', false);
                            $('#txtNoTransDepo').prop('disabled', false);
                            $('#txtNoTransDepo').focus();
                        } else {
                            alert(data.message);
                            $('#btnSubmit').prop('disabled', false);
                            //PopupMessage(false, data.message);
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseText);
                        $('#btnSubmit').prop('disabled', false);
                        //PopupMessage(false, "Terjadi kesalahan server");
                    }
                });
            } else {
                return false;
            }
        }

        function cekTrollyTSCvsDepo() {
            let totalSama = 0;
            for (let i = 0; i < listTrolly.length; i++) {
                $("#tblTrollyInTSC tbody tr").each(function () {
                    var currentRow = $(this).closest("tr");
                    var kodeQR = currentRow.find("td:eq(1)").text();
                    if (kodeQR === listTrolly[i].KodeQR) {
                        totalSama++;
                    }
                });
            }

            return totalSama === listTrolly.length;
        }

        function PopupMessage(success, msg) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            })

            //Toast.fire({
            //    icon: 'success',
            //    title: msg
            //})
            if (success) {
                Toast.fire({
                    icon: 'success',
                    title: msg
                })
            } else {
                Toast.fire({
                    icon: 'error',
                    title: msg
                })
            }
        }

        function FormatDateTime(format) {
            const today = new Date();

            var datetime = moment(today).format(format)
            return datetime
        }

    </script>
}