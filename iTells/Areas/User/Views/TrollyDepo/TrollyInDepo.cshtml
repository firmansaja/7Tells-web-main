        function CheckSuratJalan(noTrans) {
            $.ajax({
                url: '@Url.Action("CheckNoTransTSC", "TrollyDepo", new { area ="User"})',
                dataType: "json",
                type: "GET",
                data: { noTrans: noTrans },
                //async: false,
                success: function (data) {
                    if (!data.success) {
                        //alert(`Data surat jalan ${data.message}`);
                        if (data.errorCode === 401) {
                            window.location.href = data.redirectUrl;
                        } else {
                            alert(data.message);
                            $('#txtNoTransTSC').focus();
                        }
                        //PopupMessage(false, data.message);
                    } else {
                        $('#txtNoTransTSC').prop('disabled', true);
                        $('#txtNoMobil').val(data.dataTrolly[0].NoMobil);
                        $('#txtNamaSupir').val(data.dataTrolly[0].NamaSupir);
                        listTrolly = data.dataTrolly;
                        if ($('#txtNoMobil').val() === '') {
                            $('#txtNoMobil').focus();
                        } else if ($('#txtNamaSupir').val() === '') {
                            $('#txtNamaSupir').focus();
                        } else if ($('#txtBarcode').val() === '') {
                            $('#txtBarcode').focus();
                        } else {
                            CheckTrolly();
                        }                        
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        }

        function CheckTrolly() {
            let kodeQR = $('#txtBarcode').val();
            listPart = listTrolly.filter(obj => obj.KodeQR === kodeQR);
            
            if (listPart.length === 0) {
                alert(`Kode QR ${kodeQR} tidak ditemukan!`);
                //PopupMessage(false, `Kode QR ${kodeQR} tidak ditemukan!`);
                $('#txtBarcode').focus();
            } else {
                var table = document.getElementById("tblTrollyInDepo").getElementsByTagName('tbody')[0];
                var rowCount = table.rows.length;

                var isReady = false;

                for (var i = 0; i < rowCount; i++) {
                    let kodeQR_ = table.rows[i].cells[1].textContent.trim();
                    if (kodeQR_ === kodeQR) {
                        alert(`Kode QR ${kodeQR} sudah ada!`);
                        $('#txtBarcode').focus();
                        isReady = true;
                        break;
                    }
                }

                if (!isReady) {
                    $("#_popUp").modal({ backdrop: 'static' });
                    $('#_title').text("Scan Passcard");

                    let qtyTotal = 0;
                    for (let i = 0; i < listPart.length; i++) {
                        qtyTotal += listPart[i].Qty;
                    }

                    $('#_popUp').on('shown.bs.modal', function () {
                        $('#txtInvtId').focus();
                        $('#txtKodeQR').val(kodeQR);
                        $('#txtTypeTrolly').val(listPart[0].TypeTrolly);
                        $('#txtProject').val(listPart[0].Project);
                        $('#txtQty').val(qtyTotal);
                        $("#tblTrollyPasscard").find("tr:gt(0)").remove();
                    })
                }
            }
        }       

        function CheckPart() {
            var passcard = $('#txtInvtId').val()
            //var invtId = $('#txtInvtId').val().substring(0, 14);
            var invtId = getInvtIdByIndex($('#txtInvtId').val(), "-", 1);

            if (invtId !== '') {
                //event.preventDefault();
                
                let dataPart = listPart.find(obj => obj.InvtId === invtId);
                if (typeof dataPart === "undefined") {
                    alert(`Invt Id ${invtId} tidak ditemukan!`);
                } else {
                    var table = document.getElementById("tblTrollyPasscard").getElementsByTagName('tbody')[0];
                    var rowCount = table.rows.length;

                    var isReady = false;

                    //for (var i = 0; i < rowCount; i++) {
                    //    var invtId_ = table.rows[i].cells[1].textContent.trim();
                    //    if (invtId_ === invtId) {
                    //        alert(`Invt Id ${invtId} sudah ada!`);
                    //        $('#txtInvtId').focus();
                    //        isReady = true;
                    //        break;
                    //    }
                    //}

                    var passcard_ = listPasscard.find((e) => e === passcard);

                    if (passcard_ === passcard) {
                        alert(`Passcard ${passcard} sudah discan!`);
                        $('#txtInvtId').focus();
                        isReady = true;
                    } else {
                        listPasscard.push(passcard);
                    }

                    if (!isReady) {
                        for (var i = 0; i < rowCount; i++) {
                            var invtId_ = table.rows[i].cells[1].textContent.trim();
                            var Qty = table.rows[i].cells[4].textContent.trim();
                            if (invtId_ === invtId) {
                                table.rows[i].cells[4].innerHTML = parseInt(Qty) + 1;
                                $('#txtInvtId').focus();
                                isReady = true;
                                break;
                            } else {
                                isReady = false;
                            }
                        }
                    }

                    if (!isReady) {
                        var newRow = table.insertRow(rowCount);
                        newRow.setAttribute("style", "text-align:center;vertical-align:middle");

                        var cNo = newRow.insertCell(0);
                        var cInvtID = newRow.insertCell(1);
                        var cPartNo = newRow.insertCell(2);
                        var cPartName = newRow.insertCell(3);
                        var cQty = newRow.insertCell(4);
                        var cPilihan = newRow.insertCell(5);
                        cNo.setAttribute("style", "display:none");
                        cInvtID.innerHTML = invtId;
                        cPartNo.setAttribute("style", "display:none");
                        cPartNo.innerHTML = dataPart.PartNo;
                        cPartName.innerHTML = dataPart.PartName;
                        cQty.innerHTML = 1;
                        //cQty.innerHTML = `<input style="min-width:50px; width:100%" type="number" id="txtQty_${rowCount}" onkeypress="handlePressQty(event, ${dataPart.Qty}, ${rowCount})">`
                        cPilihan.innerHTML = '<button class="btn btn-xs btnHapus" title="Hapus" style="color:red"><span class="fa fa-trash"></span></button>';
                        $('#txtInvtId').focus();
                    }
                    //$(`#txtQty_${rowCount}`).focus();
                }
            }
        }

        function getInvtIdByIndex(input, delimiter, posisi) {
            let parts = input.split(delimiter);

            if (posisi <= 0 || posisi > parts.length) {
                return "";
            }

            return parts[posisi - 1].trim();
        }

        function SimpanTrollyInDepo() {
            var NoMobil = $("#txtNoMobil").val();
            var NamaSupir = $("#txtNamaSupir").val();
            var table = document.getElementById("tblTrollyInDepo").getElementsByTagName('tbody')[0];;
            var rowCount = table.rows.length;

            if (NoMobil == "") {
                alert("No Mobil tidak boleh kosong!")
            } else if (NoMobil.length > 9) {
                alert("Cek nomor mobil!")
            } else if (NamaSupir == "") {
                alert("Nama supir tidak boleh kosong!")
            } else if (rowCount == 0) {
                alert("Data trolley tidak boleh kosong!")
            } else {
                if (cekTrollyTSCvsDepo()) {
                    simpanData();
                } else {
                    let confirm = prompt("Data trolly tidak sesuai, masukkan password:");
                    if (confirm == null || confirm == "") {
                        return false;
                    } else {
                        if (confirm === "Scanindepo") {
                            simpanData();
                        } else {
                            alert("Password tidak valid")
                        }
                    }
                }                
            }
        }

        function simpanData() {
            if (confirm('Yakin ingin simpan data?')) {

                $('#btnSubmit').prop('disabled', true);

                var Details = [];
                $("#tblTrollyInDepo tbody tr").each(function () {
                    var currentRow = $(this);
                    var kodeQR = currentRow.find("td:eq(1)").text();
                    var project = currentRow.find("td:eq(2)").text();
                    var typeTrolly = currentRow.find("td:eq(3)").text();
                    var invtId = currentRow.find("td:eq(4)").text();
                    var partNo = currentRow.find("td:eq(5)").text();
                    var partName = currentRow.find("td:eq(6)").text();
                    var qty = currentRow.find("td:eq(7)").text();
                    var obj = {};
                    obj.NoTrans = "";
                    obj.KodeQR = kodeQR;
                    obj.Project = project;
                    obj.TypeTrolly = typeTrolly;
                    obj.InvtId = invtId;
                    obj.PartNo = partNo;
                    obj.PartName = partName;
                    obj.Qty = qty;
                    obj.Satuan = 'PCS';

                    Details.push(obj);
                });

                $.ajax({
                    url: '@Url.Action("SimpanTrollyInOutDepo", "TrollyDepo", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: {
                        NoTrans: $('#txtNoTrans').val(),
                        NoTransTSC: $('#txtNoTransTSC').val(),
                        InOut: "IN",
                        TglTrans: new Date().toISOString(),
                        CustId: 'DEPO',
                        NoMobil: $('#txtNoMobil').val(),
                        NamaSupir: $('#txtNamaSupir').val(),
                        Details: Details,
                    },
                    success: function (data) {
                        if (data.success) {
                            $("#txtNoTransTSC").val('');
                            $("#txtNoMobil").val('');
                            $("#txtNamaSupir").val('');
                            $("#tblTrollyInDepo").find("tr:gt(0)").remove();
                            alert(data.message);
                            //PopupMessage(true, data.message);
                            $('#btnSubmit').prop('disabled', false);
                            $('#txtNoTransTSC').prop('disabled', false);
                            $('#txtNoTransTSC').focus();
                        } else {
                            alert(`Data gagal disimpan "${data.message}"`);
                            //alert(data.message);
                            $('#btnSubmit').prop('disabled', false);
                            //PopupMessage(false, data.message);
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseText);
                        $('#btnSubmit').prop('disabled', false);
                        //PopupMessage(false, "Terjadi kesalahan server");
                    }
                });
            } else {
                return false;
            }
        }

        function handlePressQty(evt, qty, index) {
            var theEvent = evt || window.event;

            // Handle paste
            if (theEvent.type === 'paste') {
                var key = theEvent.clipboardData.getData('text/plain');
            } else {
                // Handle key press
                var key = theEvent.keyCode || theEvent.which;
                key = String.fromCharCode(key);
            }

            if (theEvent.keyCode === 13) {                
                if (getnum($(`#txtQty_${index}`).val()) !== getnum(qty)) {
                    alert('Qty tidak sama dengan data out TSC!');
                } else {
                    if (cekTSCvsDepo()) {
                        AddPartToTrolly();
                    } else {
                        $('#txtInvtId').focus();
                    }
                }               
            } else {
                var regex = /[0-9]|\./;
                if (!regex.test(key)) {
                    theEvent.returnValue = false;
                    if (theEvent.preventDefault) theEvent.preventDefault();
                }
            }
        }

        function Proses() {
            if (cekTSCvsDepo()) {
                AddPartToTrolly();
            } else {
                let confirm = prompt("Data part tidak sesuai, masukkan password:");
                if (confirm == null || confirm == "") {
                    return false;
                } else {
                    if (confirm === "Scanindepo") {
                        AddPartToTrolly();
                    } else {
                        alert("Password tidak valid")
                    }
                }
            }
        }

        function cekTSCvsDepo() {
            let totalSama = 0;
            for (let i = 0; i < listPart.length; i++) {
                $("#tblTrollyPasscard tbody tr").each(function () {
                    var currentRow = $(this).closest("tr");
                    var invtId = currentRow.find('td:eq(1)').text();
                    var qty = currentRow.find('td:eq(4)').text();
                    if (invtId === listPart[i].InvtId && getnum(qty) === listPart[i].Qty) {
                        totalSama++;
                    }
                });
            }

            return totalSama === listPart.length;
        }

        function cekTrollyTSCvsDepo() {
            let totalSama = 0;
            for (let i = 0; i < listTrolly.length; i++) {
                $("#tblTrollyInDepo tbody tr").each(function () {
                    var currentRow = $(this).closest("tr");
                    var kodeQR = currentRow.find("td:eq(1)").text();
                    var invtId = currentRow.find("td:eq(4)").text();
                    var qty = currentRow.find("td:eq(7)").text();
                    if (kodeQR === listTrolly[i].KodeQR && invtId === listTrolly[i].InvtId && getnum(qty) === listTrolly[i].Qty) {
                        totalSama++;
                    }
                });
            }

            return totalSama === listTrolly.length;
        }

        function AddPartToTrolly() {
            $("#tblTrollyPasscard tbody tr").each(function () {
                var currentRow = $(this).closest("tr");
                var invtId = currentRow.find('td:eq(1)').text();
                var partNo = currentRow.find('td:eq(2)').text();
                var partName = currentRow.find('td:eq(3)').text();
                var qty = currentRow.find('td:eq(4)').text();
                //var qty = currentRow.find('td:eq(4) input[type=number]').val();

                var table = document.getElementById("tblTrollyInDepo").getElementsByTagName('tbody')[0];
                var rowCount = table.rows.length;

                var newRow = table.insertRow(rowCount);
                newRow.setAttribute("style", "text-align:center;vertical-align:middle");

                newRow.insertCell(0);
                var cKodeTrolley = newRow.insertCell(1);
                var cProject = newRow.insertCell(2);
                var cJenisTrolley = newRow.insertCell(3);
                var cInvtId = newRow.insertCell(4);
                var cPartNo = newRow.insertCell(5);
                var cPartName = newRow.insertCell(6);
                var cQty = newRow.insertCell(7);
                var cPilihan = newRow.insertCell(8);
                cKodeTrolley.innerHTML = $('#txtKodeQR').val();
                cProject.innerHTML = $('#txtProject').val();
                cProject.setAttribute("style", "display:none");
                cJenisTrolley.innerHTML = $('#txtTypeTrolly').val();;
                cInvtId.innerHTML = invtId;
                cPartNo.innerHTML = partNo;
                cPartNo.setAttribute("style", "display:none");
                cPartName.innerHTML = partName;
                cPartName.setAttribute("style", "display:none");
                cQty.innerHTML = qty
                cPilihan.innerHTML = '<button class="btn btn-xs btnHapus" title="Hapus" style="color:red"><span class="fa fa-trash"></span></button>';

                $("#tblTrollyPasscard").find("tr:gt(0)").remove();

                $("#_popUp").modal('hide');

                $('#txtBarcode').focus();
            });
        }

        function PopupMessage(success, msg) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            })

            //Toast.fire({
            //    icon: 'success',
            //    title: msg
            //})
            if (success) {
                Toast.fire({
                    icon: 'success',
                    title: msg
                })
            } else {
                Toast.fire({
                    icon: 'error',
                    title: msg
                })
            }
        }

        function getnum(t) {
            if (isNumeric(t)) {
                return parseInt(t, 10);
            }
            return 0;
            function isNumeric(n) {
                return !isNaN(parseFloat(n)) && isFinite(n);
            }
        }

        function FormatDateTime(date, format) {
            var datetime = moment(date).format(format)
            return datetime
        }

    </script>
}