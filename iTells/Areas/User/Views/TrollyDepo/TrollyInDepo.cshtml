
@{
    ViewBag.Title = "Trolly In Depo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .grid_center {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-column-gap: 10px;
            grid-row-gap: 5px;
        }

        .container_barcode {
            display: grid;
            justify-content: center;
            align-items: center;
            grid-auto-flow: row;
            grid-row-gap: 5px;
            background-color: #CCCCCC;
            padding: 5px;
            margin: 5px 0px;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 0px;
        }

        .form-control {
            border-radius: 5px;
        }

        .box-header {
            padding: 10px 10px 0px 10px;
        }

        @@media only screen and (max-width:640px) {
            .box-header {
                padding: 5px 5px 0px 5px;
            }

            .c-header {
                font-size: 14px;
            }

            .col-xs-12 {
                padding: 0px;
            }

            .grid_center {
                grid-gap: 5px;
                font-size: 10px;
            }

            .form-control {
                border-radius: 5px;
                padding: 2px 8px;
                font-size: 10px;
                height: 20px;
            }

            .btn {
                padding: 2px 8px;
                font-size: 10px;
            }

            h4.small {
                font-size: 10px;
            }

            .container_barcode {
                display: grid;
                grid-auto-flow: column;
                grid-gap: 5px;
                align-items: center;
                justify-content: space-around;
            }

            .table-container {
                font-size: 10px;
            }

            .main-header .logo {
                display: none;
            }

            .fixed .content-wrapper, .fixed .right-side {
                padding-top: 50px;
            }
        }

        table {
            /*width: 50%;*/
            counter-reset: row-num;
        }

            table tbody tr {
                counter-increment: row-num;
            }

                table tbody tr td:first-child::before {
                    content: counter(row-num) "";
                }
    </style>
</head>

<div class="box box-primary">
    <div class="box-header with-border header-font">
        <div class="col-xs-12">
            <div align="center" class="row">
                <h1 class="c-header" style="margin:0; font-weight:bold; color:#0288E1">TROLLY MASUK DEPO</h1>
            </div>
        </div>
    </div>
    <div class="box-body">
        <div class="col-xs-12">
            <div class="grid_center">
                <div class="form-group">
                    <label style="margin:0">No Surat Jalan</label>
                    <input type="text" class="form-control" value="" id="txtNoTransTSC">
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">No. Trans</label>
                    <input type="text" class="form-control" value="" id="txtNoTrans" disabled>
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">Tanggal</label>
                    <input type="text" class="form-control" value="" id="dtTgl" disabled>
                </div>
                <div class="form-group" hidden>
                    <label style="margin:0">Jam</label>
                    <input type="text" class="form-control" value="" id="txtJam" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">No. Mobil</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNoMobil">
                </div>
                <div class="form-group">
                    <label style="margin:0">Nama Supir</label>
                    <input type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtNamaSupir">
                </div>
            </div>
            <div class="container_barcode">
                <div align="center">
                    <h4 class="small" style="margin:0; font-weight:bold">QR TROLLY</h4>
                </div>
                <div>
                    <input style="max-width:300px;" type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtBarcode">
                </div>
                <div align="center">
                    <button id="btnSubmit" class="btn btn-primary" onclick="return SimpanTrollyInDepo()">Submit</button>
                </div>
            </div>
            <div class="table-container" style="overflow-x:auto">
                <table class="table" id="tblTrollyInDepo" style="border-color:black;width:100%">
                    <thead>
                        <tr style="border-color:black">
                            <th style="text-align:center;vertical-align:middle;border-color:black">No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">QR Trolly</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Project</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Jenis Trolly</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Invt Id</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Part No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Part Name</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Qty</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="_popUp" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h2 class="modal-title" id="_title"></h2>
            </div>
            <div class="modal-body">
                <div style="display: grid; grid-auto-flow: column; grid-gap: 5px;">
                    <div class="form-group">
                        <label style="text-align:left;">QR Trolly</label>
                        <input id="txtKodeQR" class="form-control" readonly />
                    </div>
                    <div class="form-group" hidden>
                        <label style="text-align:left;">Type Trolly</label>
                        <input id="txtTypeTrolly" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label style="text-align:left;">Project</label>
                        <input id="txtProject" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label style="text-align:left;">Qty</label>
                        <input id="txtQty" class="form-control" readonly />
                    </div>
                </div>
                <div class="form-group">
                    <label style="text-align:left;">Inventory Id</label>
                    <input id="txtInvtId" class="form-control" autofocus />
                </div>
                <div class="table-container" style="overflow-x:auto">
                    <table class="table" id="tblTrollyPasscard" style="border-color:black;width:100%">
                        <thead>
                            <tr style="border-color:black">
                                <th style="display:none;text-align:center;vertical-align:middle;border-color:black">No</th>
                                <th style="text-align:center;vertical-align:middle;border-color:black">Invt Id</th>
                                <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Part No</th>
                                <th style="text-align:center;vertical-align:middle;border-color:black">Part Name</th>
                                <th style="text-align:center;vertical-align:middle;border-color:black">Qty</th>
                                <th style="text-align:center;vertical-align:middle;border-color:black"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnProses" class="btn btn-primary" onclick="return Proses()" style="width:100px">Proses</button>&nbsp;
            </div>
        </div>
    </div>
</div>

