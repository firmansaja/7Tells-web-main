@using BusinessObjects;
@{
    ViewBag.Title = "Report Trolly Out Depo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="box box-primary">
    <div class="box-body">
        <div class="row">
            <div class="col-xs-12">
                <table>
                    <tr>
                        <td>
                            <div class="form-group row" style="margin:0">
                                @*<label>Dari Tanggal</label>*@
                                <div class="input-group date" id="dtDari">
                                    <span class="input-group-addon" style="font-weight: 700; background-color: #eee">
                                        Dari Tanggal
                                    </span>
                                    <input type="text" class="form-control" />
                                    <span class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                        </td>
                        <td width="5%"></td>
                        <td>
                            <div class="form-group  row" style="margin:0">
                                @*<label>Sampai</label>*@
                                <div class="input-group date" id="dtSampai">
                                    <span class="input-group-addon" style="font-weight: 700; background-color: #eee">
                                        Sampai
                                    </span>
                                    <input type='text' class="form-control" />
                                    <span class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                        </td>
                        <td width="5%"></td>
                        <td><button type="button" class="btn btn-primary" id="BtnViewTrolly"><span class="bold fa fa-refresh"></span>&nbsp;&nbsp;Load</button></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ListTrollyOutDepo")

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        $(document).ready(function () {
            var menuItem = $('#trolly');
            menuItem.addClass('active');
            var subMenuItem = menuItem.find('#laptrollyindepo');
            subMenuItem.addClass('active');

            const today = new Date();

            $('#dtDari').datepicker({
                useCurrent: false,
                autoclose: true,
                format: 'dd/mm/yyyy'
            });

            $('#dtSampai').datepicker({
                useCurrent: false,
                autoclose: true,
                format: 'dd/mm/yyyy'
            });

            $('#dtDari').datepicker('setDate', today);
            $('#dtSampai').datepicker('setDate', today);

            $('#cListTrollyOurDepo').show();
            DataTableTrolly(today.toISOString(), today.toISOString());
        })

        function DataTableTrolly(stDate, enDate) {
            dtTrollyOut = $('#tbTrolly').DataTable({
                "serverSide": true,
                "processing": true,
                "autoWidth": false,
                //"bInfo": false,
                //"bPaginate": false,
                "ajax": {
                    "data": {
                        DTDari: stDate,
                        DTSampai: enDate,
                    },
                    "url": "/gettrollyoutdepo",
                    "type": 'POST'
                },
                "columns": [
                    {
                        "data": "NoTrans", title: "Action", "orderable": false, "render": function (data) {
                            return '<button class="btn btn-xs btn-info" title="Lihat" id="btnLihat" style="margin-right:5px"> <span class="fa fa-eye"></span></button>';
                        }
                    },
                    { "title": "No Surat Jalan", "data": "NoTrans" },
                    {
                        "title": "Tanggal", "data": "TglTrans",
                        "render": function (value) {
                            if (value === null) return "";
                            return moment(value).format('DD/MM/YYYY');
                        }
                    },
                    { "title": "No Mobil", "data": "NoMobil" },
                    { "title": "Nama Supir", "data": "NamaSupir" },
                ],
                "columnDefs": [
                    { "width": "30px", "searchable": false, "orderable": false, "targets": [0] },
                    { "className": "text-center custom-middle-align", "targets": [0] },
                    //{ "visible": false, "targets": [0] },
                ],
            });
        }

        $(document).on('click', '#btnLihat', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbTrolly').dataTable().fnGetData(row);
            var _NoTrans = data.NoTrans;
            $.ajax({
                type: "POST",
                url: '@Url.Action("ViewReportTrolleyOut", "TrollyDepo", new { area ="User"})',
                data: { NoTrans: _NoTrans, RptName: 'RptTrollyOutDepo' },
                success: function (data) {
                    if (!data.result) {
                        alert("Error");
                    }
                    else {
                        window.open("/Reports/ReportTrolly.aspx", '_blank');
                    }
                }
            });
        });

        $(document).on('click', '#BtnViewTrolly', function (event) {
            event.preventDefault();
            var stDate = $('#dtDari').datepicker("getDate");
            var enDate = $('#dtSampai').datepicker("getDate");
            $("#tbTrolly").dataTable().fnDestroy();
            DataTableTrolly(stDate.toISOString(), enDate.toISOString());
        });

        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }

    </script>
}

