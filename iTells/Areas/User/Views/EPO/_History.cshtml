
@using BusinessObjects;
@{
    List<ComboList> ListSupplier = (List<ComboList>)ViewData["ListSupplier"];
}

<div id="chistory" class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">PO HISTORY</h3>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-xs-12">
                        <table>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Dari Tanggal</label>
                                        <div class="input-group date" id="dtDari">
                                            <input type="text" class="form-control" />
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>Sampai</label>
                                        <div class="input-group date" id="dtSampai">
                                            <input type='text' class="form-control" />
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>

                                    <div class="form-group">
                                        <label>PO Number</label>
                                        <input type="text" class="form-control" value="All" id="txtPO">
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>PR Number</label>
                                        <input type="text" class="form-control" value="All" id="txtPR">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Approval Level</label>
                                        <select id="txtApprove" class="form-control select2" style="width:100%">
                                            <option value="All">-- All --</option>
                                            <option value="0">0</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                        </select>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td>
                                    <div class="form-group">
                                        <label>File Name</label>
                                        <input type="text" class="form-control" value="PO-Excel" id="txtFileName">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="form-group">
                                        <label>Supplier</label>
                                        <select id="txtSupplier" class="form-control select2" style="width:100%">
                                            <option value="All">-- All --</option>
                                            @foreach (var item in ListSupplier)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td width="5%"></td>
                                <td><button type="button" class="btn btn-primary" id="BtnViewHistory"><span class="bold fa fa-eye"></span>&nbsp;&nbsp;Preview</button>&nbsp;&nbsp<button type="button" class="btn btn-success" id="BtnDownloadHistory" onclick="ExportExcel()"><span class="bold fa fa-download"></span>&nbsp;&nbsp;Download</button></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="box-footer" style="overflow-x:auto">
                <div class="row">
                    <div class="col-xs-12">
                        <table class="table table-bordered table-striped table-condensed table-responsive table-hover" id="tbPOHistory"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function ExportExcel(e) {
        var stDate = $('#dtDari').datepicker("getDate");
        var enDate = $('#dtSampai').datepicker("getDate");
        $.ajax({
            url: '@Url.Action("ExportExcel", "EPO", new { area ="User"})',
            //contentType: "application/json; charset=utf-8",
            dataType: "JSON",
            type: "POST",
            data: {
                DTDari: stDate.toISOString(),
                DTSampai: enDate.toISOString(),
                PONumber: $('#txtPO').val(),
                PRNumber: $('#txtPR').val(),
                Level: $('#txtApprove').val(),
                FileName: $('#txtFileName').val(),
                Supplier: $('#txtSupplier').val(),
            },
            beforeSend: function () {
                $('#BtnDownloadHistory').attr('disabled',true);
            },
            success: function (data) {
                if (data.success) {
                    window.location.href = "@Url.RouteUrl(new { Controller = "PR", Action = "Download" })/?fileName=" + $('#txtFileName').val() + ".xlsx";
                }
            },
            complete: function () {
                $('#BtnDownloadHistory').attr('disabled', false);
            },
            error: function (xhr) {
                alert(xhr.responseText);
            }
        });
    }
</script>