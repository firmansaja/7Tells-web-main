@* Popup history harga per InvtID (data dari SP PR_V_GetHistoryPrice) *@
<div class="modal fade no-print" id="_popUpHistoryPrice" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title" id="_titleHistoryPrice"></h4>
            </div>
            <div class="modal-body" style="max-height:60vh;overflow:auto">
                <table id="tblHistoryPrice" class="table table-bordered table-striped table-condensed" style="font-size:12px">
                    <thead></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal" style="width:100px">Kembali</button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {
            SetFooter();

        });

        // ===== Popup History Harga (klik InvtID) =====
        function escapeHtml(text) {
            return String(text)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
        }

        function formatHistoryValue(v) {
            if (v === null || v === undefined) return { text: "", cls: "" };
            if (typeof v === "number") {
                var text = Number.isInteger(v)
                    ? v.toLocaleString("en-US")
                    : v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                return { text: text, cls: "text-right" };
            }
            return { text: escapeHtml(v), cls: "" };
        }

        $(document).on('click', '.lnkInvtID', function (event) {
            event.preventDefault();
            var invtId = $(this).data('invtid');

            $("#_titleHistoryPrice").html("History Harga : " + escapeHtml(invtId));
            $("#tblHistoryPrice thead").empty();
            $("#tblHistoryPrice tbody").html('<tr><td class="text-center">Loading...</td></tr>');
            $("#_popUpHistoryPrice").modal({ backdrop: 'static' });

            $.ajax({
                url: '@Url.Action("GetHistoryPrice", "EPO", new { area = "User" })',
                type: "POST",
                dataType: "json",
                cache: false,
                data: { InvtID: invtId },
                success: function (data) {
                    if (!data.success) {
                        $("#tblHistoryPrice tbody").html('<tr><td class="text-center text-danger">' + escapeHtml(data.message || "Gagal mengambil data") + '</td></tr>');
                        return;
                    }
                    if (!data.rows || data.rows.length === 0) {
                        $("#tblHistoryPrice tbody").html('<tr><td class="text-center">Tidak ada data history harga</td></tr>');
                        return;
                    }

                    var head = '<tr>';
                    for (var c = 0; c < data.columns.length; c++) {
                        head += '<th class="text-center" style="vertical-align:middle">' + escapeHtml(data.columns[c]) + '</th>';
                    }
                    head += '</tr>';

                    var body = '';
                    for (var r = 0; r < data.rows.length; r++) {
                        body += '<tr>';
                        for (var k = 0; k < data.columns.length; k++) {
                            var cell = formatHistoryValue(data.rows[r][data.columns[k]]);
                            body += '<td class="' + cell.cls + '">' + cell.text + '</td>';
                        }
                        body += '</tr>';
                    }

                    $("#tblHistoryPrice thead").html(head);
                    $("#tblHistoryPrice tbody").html(body);
                },
                error: function (xhr) {
                    $("#tblHistoryPrice tbody").html('<tr><td class="text-center text-danger">Error mengambil data history harga</td></tr>');
                }
            });
        });

        function SetFooter()
        {
            const today = new Date();
            //var TglCetak = ((today.getMonth() > 8) ? (today.getMonth() + 1) : ('0' + (today.getMonth() + 1))) + '-' + ((today.getDate() > 9) ? today.getDate() : ('0' + today.getDate())) + '-' + today.getFullYear();
            var TglCetak = ((today.getDate() > 9) ? today.getDate() : ('0' + today.getDate())) + '-' +((today.getMonth() > 8) ? (today.getMonth() + 1) : ('0' + (today.getMonth() + 1)))  + '-' + today.getFullYear();
            $("#dtCetak").html(TglCetak);

		    var xValue = JSON.parse('@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewData["ListApproval"]))');
		    for (var i = 0; i < xValue.length; i++) {
                if (xValue[i].Kol == 1) {
				    $("#prApproveBy1").html(xValue[i].Status + " by " + xValue[i].UserName);
                    $("#prApproveAt1").html("Tanggal : " + xValue[i].Tanggal);
                    var userLvl1 = (xValue[i].UserName || "").trim().toLowerCase();
                    $("#prLvl1").html(userLvl1 === "kusmiyati" ? "Purchasing Section Head" : "Purchasing GL");
                    } else if (xValue[i].Kol == 2) {
				    $("#prApproveBy2").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt2").html("Tanggal : " + xValue[i].Tanggal);
                    } else if (xValue[i].Kol == 3) {
				    $("#prApproveBy3").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt3").html("Tanggal : " + xValue[i].Tanggal);
                }

                //if (xValue[i].UserName.trim().toLowerCase() == "Kusmiyati") {
                //    $("#prLvl1").html(" Purchasing Section Head ");
                //} else {
                //    $("#prLvl1").html(" Purchasing Staff ");
                //}

            }

		    if (@Kol == 1) {
