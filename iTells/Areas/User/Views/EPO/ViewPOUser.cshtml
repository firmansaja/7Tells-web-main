        $(document).on('click', '#btnApprovePO', function (event) {
            event.preventDefault();
            if (confirm('Apakah Yakin Ingin Approve  ?')) {
                var PODetail = [];
                $("#tblPoDetailUser tr").each(function () {
                    var currentRow = $(this);

                    var No = currentRow.find("td:eq(2)").text();
                    var LD = currentRow.find("td:eq(0)").text();
                    var obj = {};
                    obj.PONumber = '@POHeader.PONumber';  
                    obj.No = No;
                    obj.LineID = LD;
                    obj.Komentar = "";

                    PODetail.push(obj);
                });
               

                PODetail.splice((PODetail.length - 9), 9);
                PODetail.splice(0, 1);
                for (var i = 0; i < PODetail.length; i++) {
                    PODetail[i].Komentar = $('#txtComment_' + PODetail[i].No).val();
                }

                PODetail = JSON.stringify({ 'PODetail': PODetail });
                console.log(PODetail);

                 $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    type: 'POST',
                    url: '@Url.Action("ApproveApproval", "EPO", new { area ="User"})',
                    data: PODetail ,
                    success: function (data) {
                        if (data.success) {
                            alert(data.message);
                            window.location = "/user/EPO";
                            //localStorage.setItem("message", data.message)
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
               
            } else {
                return false
            }
        })


