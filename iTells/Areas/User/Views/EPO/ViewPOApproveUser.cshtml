@using BusinessObjects;
@{
    ViewBag.Title = "Approved PO";
    // Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "PO Detail";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "E-PO";
    //ViewBag.Link = "/User/PR";
    BO_PO POHeader = (BO_PO)ViewData["POHeader"];
    BO_PO POTotal = (BO_PO)ViewData["POTotalAmount"];
    List<BO_PODetail> ListPODetail = (List<BO_PODetail>)ViewData["ListPODetail"];
    POAksesUser AkseUser = (POAksesUser)ViewData["AksesUser"];



    double Taxf = Convert.ToDouble(POHeader.TaxF);
    double Total = Convert.ToDouble(POTotal.TotalAmount);
    double Tax = (Taxf / 100) * Total;

    double GTotal = Tax + Total;

    double Tx = Convert.ToDouble(Tax);
    double GT = Convert.ToDouble(GTotal);

    string Termin = "";

    if (@POHeader.Terms == "0")
    {
        Termin = "Cash";
    }
    else
    {
        Termin = "Term of Payment :  " + @POHeader.Terms + " Hari Setelah terima Invoice, Pembayaran dilakukan setiap akhir bulan";
    }

    int Kol = @AkseUser.Kol;

}

