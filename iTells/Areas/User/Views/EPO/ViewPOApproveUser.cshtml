@section scripts{
<script>
        $(document).ready(function () {
            SetFooter();

        });

        function SetFooter()
        {
            const today = new Date();
            //var TglCetak = ((today.getMonth() > 8) ? (today.getMonth() + 1) : ('0' + (today.getMonth() + 1))) + '-' + ((today.getDate() > 9) ? today.getDate() : ('0' + today.getDate())) + '-' + today.getFullYear();
            var TglCetak = ((today.getDate() > 9) ? today.getDate() : ('0' + today.getDate())) + '-' +((today.getMonth() > 8) ? (today.getMonth() + 1) : ('0' + (today.getMonth() + 1)))  + '-' + today.getFullYear();
            $("#dtCetak").html(TglCetak);

		    var xValue = JSON.parse('@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewData["ListApproval"]))');
		    for (var i = 0; i < xValue.length; i++) {
			    if (xValue[i].Kol == 1) {
				    $("#prApproveBy1").html(xValue[i].Status + " by " + xValue[i].UserName);
                    $("#prApproveAt1").html("Tanggal : " + xValue[i].Tanggal);
                    var userLvl1 = (xValue[i].UserName || "").trim().toLowerCase();
                    $("#prLvl1").html(userLvl1 === "kusmiyati" ? "Purchasing Section Head" : "Purchasing Staff");
                    } else if (xValue[i].Kol == 2) {
				    $("#prApproveBy2").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt2").html("Tanggal : " + xValue[i].Tanggal);
                    } else if (xValue[i].Kol == 3) {
				    $("#prApproveBy3").html(xValue[i].Status + " by " + xValue[i].UserName);
				    $("#prApproveAt3").html("Tanggal : " + xValue[i].Tanggal);
                }

                //if (xValue[i].UserName == "Kusmiyati") {
                //    $("#prLvl1").html(" Purchasing Section Head ");
                //} else {
                //    $("#prLvl1").html(" Purchasing Staffx ");
                //}
            }

		    if (@Kol == 1) {
                $("#btnUpdatePO").addClass('disabled');
			    $('#selectall').prop('checked', true);
			    $('#selectall').prop('disabled', true);
			    $('.singlechkbox').prop('checked', true);
			    $('.singlechkbox').prop('disabled', true);
		    }
        }

        function AutoGrow(obj) {
            $(obj).css('height', 'auto').css('height', obj.scrollHeight + (obj.offsetHeight - obj.clientHeight));
        }


         $(document).on('click', '#btnApprovePO', function (event) {
            event.preventDefault();
            if (confirm('Apakah Yakin Ingin Reject ?')) {
                $.ajax({
                    url: '@Url.Action("RejectPO", "EPO", new { area ="User"})',
                    dataType: "json",
                    type: "POST",
                    cache: false,
                    data: { PONo: '@POHeader.PONumber'} ,
                    success: function (data) {
                        if (data.success) {
                           // window.location.href = "@Url.RouteUrl(new { Controller = "EPO", Action = "GetModelPOByUser" })";
                            window.location = "/user/EPO";
                            localStorage.setItem("message", data.message)
                        }
                    },
                    error: function (xhr) {
                        alert("Error");
                    }
                });
            } else {
                return false;
            }
        });



</script>
}