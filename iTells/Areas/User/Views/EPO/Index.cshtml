<div id="message"></div>
<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-body">
                <div class="row">
                    <div class="col-xs-12">
                        <table>
                            <tr>
                                <td>
                                    @*<div class="form-group">*@
                                    @* <label>Filter</label>*@
                                    <select id="filterType" class="form-control select2" style="width:100%">
                                        <option value=0>Non Approval</option>
                                        <option value=1>Approved By User</option>
                                        <option value=2>Approved By Div Head</option>
                                        <option value=3>Non Confirm</option>
                                        @*<option value=4>Supplier Approval</option>*@
                                        <option value=5>PO History</option>
                                    </select>
                                    @*</div>*@
                                </td>
                                <td width="2%"></td>
                                <td>
                                    <div class="input-group date" id="dtDaricari">
                                        <input type="text" class="form-control" />
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </span>
                                    </div>


                                </td>
                                <td width="2%"></td>
                                <td>



                                    <div class="input-group date" id="dtSampaicari">
                                        <input type='text' class="form-control" />
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </span>
                                    </div>


                                </td>
                                <td width="2%"></td>
                                <td><button type="button" class="btn btn-primary" id="BtnCari">Cari</button></td>
                                <td width="2%"></td>
                                <td><button type="button" class="btn btn-primary" id="BtnRefresh">Refresh</button></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_NonApproval")
@Html.Partial("_ApprovalByUser")
@Html.Partial("_ApprovalSM")
@Html.Partial("_NonConfirm")
@Html.Partial("_History")
@Html.Partial("_Supplier")

<div class="modal fade" id="_popUp" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content panel-primary">
            <div class="panel-heading">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h2 class="modal-title" id="_title"></h2>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 col-md-4 control-label" style="text-align:left;">Nomor PR</label>
                        <label class="col-sm-1 col-md-1 control-label">:</label>
                        <div class="col-sm-8 col-md-7">
                            <input id="txtPRNo" class="form-control" autofocus />
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnProses" class="btn btn-primary" onclick="return ProsesOverBudget()" style="width:100px">Proses</button>&nbsp;
                <button type="button" class="btn btn-primary" data-dismiss="modal" style="width:100px">Kembali</button>
            </div>
        </div>
    </div>
</div>


