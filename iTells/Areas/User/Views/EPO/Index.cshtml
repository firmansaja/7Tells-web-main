        $(document).on('change', '#filterType', function (event) {
            event.preventDefault();
            filter = $('#filterType').val();
            filtertext = $('#filterType').text();
            HideNShow();
            if (filter == 1) {
                ShowCari();
            } else {
                HideCari();
            }

        });

         function HideNShow() {
           filter = $('#filterType').val();
            if (filter == 0) {
                HidePartial();
                $('#tbNonApproval').DataTable().ajax.reload();
                $('#parnonapproval').show();
            } else if (filter == 1) {
                HidePartial();
                $('#tbPOByUser').DataTable().ajax.reload();
                $('#clistbyuser').show();
            } else if (filter == 2) {
                HidePartial();
                $('#tbPOBySM').DataTable().ajax.reload();
                $('#clistBySM').show();
            } else if (filter == 3) {
                HidePartial();
                $('#tbPONonConfirm').DataTable().ajax.reload();
                $('#clistNonConfirm').show();
            } else if (filter == 4) {
                HidePartial();
                $('#tbPOSupplierApproval').DataTable().ajax.reload();
                $('#clistSupplierApproval').show();
            } else if (filter == 5) {
                HidePartial();
                $('#chistory').show();
            //} else if (filter == 6) {
            //    HidePartial();
            //    $('#cbudget').show();
            }
        }

        $(document).on('click', '#BtnRejectUser', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbPOByUser').dataTable().fnGetData(row);
            var _PONo = data.PONumber;
            if (confirm('Anda yakin akan Reject PO ?')) {
                UpdateReject(_PONo);
            } else {
                return false;
            }
        });

        $(document).on('click', '#BtnReject', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbNonApproval').dataTable().fnGetData(row);
            var _PONo = data.PONumber;
            if (confirm('Anda yakin akan Reject PO ?')) {
                UpdateRejectNon(_PONo);
            } else {
                return false;
            }
        });

        function UpdateRejectNon(_PONo) {
            $.ajax({
                url: '@Url.Action("RejectPO", "EPO", new { area ="User"})',
                dataType: "json",
                type: "POST",
                cache: false,
                data: { PONo: _PONo} ,
                success: function (data) {
                    if (data.success) {
                        $('#tbNonApproval').DataTable().ajax.reload();
                        alert(data.message);
                        //var message = '<h3 class=\"alert alert-success fade in\">' + data.message + '</h3>';
                        //$('#message').html(message);
                        //$("#message").slideDown(1000).slideUp(2000);
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText)
                }
            });
        };

        function UpdateReject(_PONo) {
            $.ajax({
                url: '@Url.Action("RejectPO", "EPO", new { area ="User"})',
                dataType: "json",
                type: "POST",
                cache: false,
                data: { PONo: _PONo} ,
                success: function (data) {
                    if (data.success) {
                        $('#tbPOByUser').DataTable().ajax.reload();
                        alert(data.message);

                        //var message = '<h3 class=\"alert alert-success fade in\">' + data.message + '</h3>';
                        //$('#message').html(message);
                        //$("#message").slideDown(1000).slideUp(2000);
                    }
                },
                error: function (xhr) {
                    alert(xhr.responseText);
                }
            });
        };



        $(document).on('click', '#BtnApprove', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
            var data = $('#tbNonApproval').dataTable().fnGetData(row);
            var _PONo = data.PONumber;
            if (confirm('Anda yakin akan Approve PO ?')) {
                ApprovePO(_PONo);
            } else {
                return false;
            }
        });

        function ApprovePO(_PONo) {
            $.ajax({
                url: '@Url.Action("ApprovePO", "EPO", new { area ="User"})',
                dataType: "json",
                type: "POST",
                cache: false,
                data: { PONo: _PONo} ,
                success: function (data) {
                    if (data.success) {
                        $('#tbNonApproval').DataTable().ajax.reload();
                        //var message = '<h3 class=\"alert alert-success fade in\">' + data.message + '</h3>';
                        //$('#message').html(message);
                        //$("#message").slideDown(1000).slideUp(2000);
                        alert(data.message);
                    }
                },
