@using BusinessObjects;



@{
    ViewBag.Title = "Electronic Purchase Order (e-PO)";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.SubTitle = "Home";
    ViewBag.SubTitle1 = "";
    List<ComboList> Years = (List<ComboList>)ViewData["FiscalYear"];
    POAksesUser AkseUser = (POAksesUser)ViewData["AksesUser"];
    //var Dept = @AkseUser.Dept;
    //int Kol = @AkseUser.Kol;

    //string Site = @AkseUser.Site;
    int Kol = @AkseUser.Kol;
    string Site = "Test";
