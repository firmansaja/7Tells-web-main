
@{
    ViewBag.Title = "Scan Part Punch";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .grid_center {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-column-gap: 10px;
            grid-row-gap: 5px;
        }

        .container_barcode {
            display: grid;
            justify-content: center;
            align-items: center;
            grid-auto-flow: row;
            grid-row-gap: 5px;
            background-color: #CCCCCC;
            padding: 5px;
            margin: 5px 0px;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 0px;
        }

        .form-control {
            border-radius: 5px;
        }

        .box-header {
            padding: 10px 10px 0px 10px;
        }

        @@media only screen and (max-width:640px) {
            .box-header {
                padding: 5px 5px 0px 5px;
            }

            .c-header {
                font-size: 14px;
            }

            .col-xs-12 {
                padding: 0px;
            }

            .grid_center {
                grid-gap: 5px;
                font-size: 10px;
            }

            .form-control {
                border-radius: 5px;
                padding: 2px 8px;
                font-size: 10px;
                height: 20px;
            }

            .btn {
                padding: 2px 8px;
                font-size: 10px;
            }

            h4.small {
                font-size: 10px;
            }

            .container_barcode {
                display: grid;
                grid-auto-flow: column;
                grid-gap: 5px;
                align-items: center;
                justify-content: space-around;
            }

            .table-container {
                font-size: 10px;
            }

            .main-header .logo {
                display: none;
            }

            .fixed .content-wrapper, .fixed .right-side {
                padding-top: 50px;
            }
        }
    </style>
</head>

<div class="box box-primary">
    <div class="box-header with-border header-font">
        <div class="col-xs-12">
            <div align="center" class="row">
                <h1 class="c-header" style="margin:0; font-weight:bold; color:#0288E1">SCAN PART PUNCHING</h1>
            </div>
        </div>
    </div>
    <div class="box-body">
        <div class="col-xs-12">
            <div class="grid_center">
                <div class="form-group">
                    <label style="margin:0">Tanggal</label>
                    <input type="text" class="form-control" value="" id="dtTgl" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">Jam</label>
                    <input type="text" class="form-control" value="" id="txtJam" disabled>
                </div>
                <div class="form-group">
                    <label style="margin:0">Shift</label>
                    <select id="txtShift" class="form-control select2">
                        <option value=1>1</option>
                        <option value=2>2</option>
                    </select>
                </div>
                @*<div class="form-group">
                    <label style="margin:0">Line</label>
                    <select id="txtLine" class="form-control select2" disabled>
                        <option value=1>1</option>
                        <option value=2>2</option>
                    </select>
                </div>*@
            </div>

            <div class="container_barcode">
                <div align="center">
                    <h4 class="small" style="margin:0; font-weight:bold">PASS CARD</h4>
                </div>
                <div>
                    <input style="max-width:400px;" type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtBarcode">
                </div>
                <div>
                    <input style="max-width:400px;" type="text" class="form-control" oninput="this.value = this.value.toUpperCase()" value="" id="txtBarcodePunch">
                </div>
                <div align="center">
                    <button id="btnSubmit" class="btn btn-primary" onclick="return SimpanScanPartPunch()">Submit</button>
                </div>
            </div>

            <div class="table-container" style="overflow-x:auto">
                <table class="table" id="tblScanPart" style="border-color:black;width:100%">
                    <thead>
                        <tr style="border-color:black">
                            <th style="text-align:center;vertical-align:middle;border-color:black">Invt Id</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Part No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Invt Id Punch</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" hidden>Part Name</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Job No</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black">Qty</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        let listPasscard = [];

        $(document).ready(function () {
            var menuItem = $('#linestore');
            menuItem.addClass('active');
            var subMenuItem = menuItem.find('#scanpartpunch');
            subMenuItem.addClass('active');

            //$('#dtTgl').val(FormatDateTime('DD/MM/YYYY', new Date('@ViewBag.Tanggal')));
            //$('#dtTgl').val('@ViewBag.Tanggal');
            $('#txtShift').val(@ViewBag.Shift);
            //$('#txtLine').val(@ViewBag.Line);

            setInterval(function () {
                let today = new Date();

                $('#dtTgl').val(FormatDateTime('DD/MM/YYYY', today));
                $('#txtJam').val(FormatDateTime('HH:mm:ss', today));
            }, 1000)

            var msg = localStorage.getItem("message");
            var scs = localStorage.getItem("success");
            if (msg != null) {
                //var msg1 = '<h3 class=\"alert alert-success fade in\">' + msg + '</h3>';
                //$('#message').html(msg1);
                //$("#message").slideDown(1000).slideUp(2000);
                PopupMessage(scs, msg);
                localStorage.removeItem("message");
                localStorage.removeItem("success");
            }

            $('#txtBarcode').focus();
        })

        // Input Pass Card
        $(document).on('focus', '#txtBarcode', function (event) {
            //event.preventDefault();
            $('#txtBarcode').val('');
        });

        $(document).on('keypress', '#txtBarcode', function (event) {
            var kodeQR = $('#txtBarcode').val();

            if (kodeQR !== '' && event.key === "Enter") {
                event.preventDefault();
                if ($('#txtBarcodePunch').val() === '') {
                    $('#txtBarcodePunch').focus();
                } else {
                    CheckPart(kodeQR);
                }
            }
        });

        // Input Pass Card Punch
        $(document).on('focus', '#txtBarcodePunch', function (event) {
            //event.preventDefault();
            $('#txtBarcodePunch').val('');
        });

        $(document).on('keypress', '#txtBarcodePunch', function (event) {
            var kodeQRPunch = $('#txtBarcodePunch').val();

            if (kodeQRPunch !== '' && event.key === "Enter") {
                event.preventDefault();
                if ($('#txtBarcode').val() === '') {
                    $('#txtBarcode').focus();
                } else {
                    CheckPart(kodeQRPunch);
                }
            }
        });

        // Hapus Pass Card
        $("#tblScanPart").on('click', '.btnHapus', function () {
            $(this).closest('tr').remove();
        });

        function CheckPart(invtId_) {
            //var invtIdFrom = $('#txtBarcode').val().substring(0, 14);
            //var invtIdTo = $('#txtBarcodePunch').val().substring(0, 14);
            var passcard = $('#txtBarcode').val();
            var passcardPunch = $('#txtBarcodePunch').val();

            var invtIdFrom = getInvtIdByIndex($('#txtBarcode').val(), "-", 1);
            var invtIdTo = getInvtIdByIndex($('#txtBarcodePunch').val(), "-", 1);

            if (invtIdFrom === invtIdTo) {
                alert("Passcard sebelum & sesudah punching tidak boleh sama!")
            } else {
                $.ajax({
                    url: '@Url.Action("CheckPart", "LineStore", new { area ="User"})',
                    dataType: "json",
                    type: "GET",
                    data: {
                        invtId: invtIdFrom
                    },
                    async: false,
                    success: function (data) {
                        if (!data.success) {
                            alert(data.message)
                            //PopupMessage(false, data.message);
                            $('#txtBarcode').focus();
                        } else {
                            $.ajax({
                                url: '@Url.Action("CheckPart", "LineStore", new { area ="User"})',
                                dataType: "json",
                                type: "GET",
                                data: {
                                    invtId: invtIdTo
                                },
                                async: false,
                                success: function (data) {
                                    if (!data.success) {
                                        alert(data.message)
                                        //PopupMessage(false, data.message);
                                        $('#txtBarcodePunch').focus();
                                    } else {
                                        var table = document.getElementById("tblScanPart").getElementsByTagName('tbody')[0];
                                        var rowCount = table.rows.length;

                                        var isReady = false;

                                        var passcard_ = listPasscard.find((e) => e === passcard);
                                        var passcardPunch_ = listPasscard.find((e) => e === passcardPunch);

                                        if (passcard_ === passcard) {
                                            alert(`Passcard ${passcard} sudah discan!`);
                                            $('#txtBarcode').focus();
                                            isReady = true;
                                        } else if (passcardPunch_ === passcardPunch) {
                                            alert(`Passcard ${passcardPunch} sudah discan!`);
                                            $('#txtBarcodePunch').focus();
                                            isReady = true;
                                        } else {
                                            listPasscard.push(passcard);
                                            listPasscard.push(passcardPunch);
                                        }

                                        if (!isReady) {
                                            for (var i = 0; i < rowCount; i++) {
                                                var invtId_ = table.rows[i].cells[0].textContent.trim();
                                                var invtId_P = table.rows[i].cells[2].textContent.trim();
                                                var Qty = table.rows[i].cells[5].textContent.trim();
                                                if (invtId_ === invtIdFrom && invtId_P === invtIdTo) {
                                                    table.rows[i].cells[5].innerHTML = parseInt(Qty) + data.part.QtyPassCard;
                                                    $('#txtBarcode').focus();
                                                    isReady = true;
                                                    break;
                                                }
                                            }
                                        }                                        

                                        if (!isReady) {
                                            var newRow = table.insertRow(rowCount);
                                            newRow.setAttribute("style", "text-align:center;vertical-align:middle");

                                            var cInvtID = newRow.insertCell(0);
                                            var cPartNo = newRow.insertCell(1);
                                            var cInvtIDP = newRow.insertCell(2);
                                            var cPartName = newRow.insertCell(3);
                                            var cJobNo = newRow.insertCell(4);
                                            var cQty = newRow.insertCell(5);
                                            var cPilihan = newRow.insertCell(6);
                                            cInvtID.innerHTML = invtIdFrom;
                                            cPartNo.innerHTML = data.part.PartNo;
                                            cInvtIDP.innerHTML = invtIdTo;
                                            cPartNo.setAttribute("style", "display:none");
                                            cPartName.innerHTML = data.part.PartName;
                                            cPartName.setAttribute("style", "display:none");
                                            cJobNo.innerHTML = data.part.JobNo;
                                            cQty.innerHTML = data.part.QtyPassCard;
                                            //cQty.innerHTML = 1;
                                            cPilihan.innerHTML = '<button class="btn btn-xs btnHapus" title="Hapus" style="color:red"><span class="fa fa-trash"></span></button>';
                                        }
                                        $('#txtBarcode').val('');
                                        $('#txtBarcodePunch').val('');
                                    }
                                },
                                error: function (xhr) {
                                    alert(xhr.responseText);
                                }
                            });
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseText);
                    }
                });
            }            
        }

        function getInvtIdByIndex(input, delimiter, posisi) {
            let parts = input.split(delimiter);

            if (posisi <= 0 || posisi > parts.length) {
                return "";
            }

            return parts[posisi - 1].trim();
        }

        function SimpanScanPartPunch() {
            var table = document.getElementById("tblScanPart").getElementsByTagName('tbody')[0];;
            var rowCount = table.rows.length;

            if (rowCount == 0) {
                alert("Data tidak boleh kosong!")
            } else {
                if (confirm('Yakin ingin simpan data?')) {

                    $('#btnSubmit').prop('disabled', true);

                    var Data = [];
                    $("#tblScanPart tbody tr").each(function () {
                        var currentRow = $(this);
                        var shift = $('#txtShift').val();
                        var invtId = currentRow.find("td:eq(0)").text();
                        var partNo = currentRow.find("td:eq(1)").text();
                        var invtIdPunch = currentRow.find("td:eq(2)").text();
                        var partName = currentRow.find("td:eq(3)").text();
                        var jobNo = currentRow.find("td:eq(4)").text();
                        var qty = currentRow.find("td:eq(5)").text();
                        //var qty = currentRow.find('td:eq(4) input[type=number]').val();
                        var obj = {};
                        obj.NoTrans = "";
                        obj.TglShift = '@ViewBag.Tanggal';
                        obj.Shift = shift;
                        obj.InvtId = invtId;
                        obj.InvtIdPunch = invtIdPunch;
                        obj.PartNo = partNo;
                        obj.PartName = partName;
                        obj.JobNo = jobNo;
                        obj.Qty = qty;

                        Data.push(obj);
                    });
                    Data = JSON.stringify({ 'Data': Data });
                    //console.log(Data);
                    $.ajax({
                        contentType: 'application/json; charset=utf-8',
                        url: '@Url.Action("SimpanScanPartPunch", "LineStore", new { area ="User"})',
                        dataType: "json",
                        type: "POST",
                        cache: false,
                        data: Data,
                        success: function (data) {
                            if (data.success) {
                                $("#tblScanPart").find("tr:gt(0)").remove();
                                //PopupMessage(true, data.message);
                                alert(data.message);
                                $('#btnSubmit').prop('disabled', false);
                            } else {
                                //PopupMessage(false, data.message);
                                //console.log(data.message);
                                alert(data.message);

                                $('#btnSubmit').prop('disabled', false);
                            }
                        },
                        error: function (xhr) {
                            alert(xhr.responseText);
                            $('#btnSubmit').prop('disabled', false);
                        }
                    });
                } else {
                    return false;
                }
            }
        }

        function PopupMessage(success, msg) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            })

            //Toast.fire({
            //    icon: 'success',
            //    title: msg
            //})
            if (success) {
                Toast.fire({
                    icon: 'success',
                    title: msg
                })
            } else {
                Toast.fire({
                    icon: 'error',
                    title: msg
                })
            }
        }

        function FormatDateTime(format, today) {
            //const today = new Date();

            var datetime = moment(today).format(format)
            return datetime
        }

    </script>
}

