


@using BusinessObjects

@{

    List<BO_MaterialKontrol> ListPRBudget = (List<BO_MaterialKontrol>)ViewData["StokMaterial"];
    int i = 0;

}

<div id="Quarter2" class="row">
    <div class="col-xs-12">
            <div class="box-body">
                <table id="TBQ2" style="border-color:black" class="table table-bordered">
                    <thead>
                        <tr style="background-color:lightgreen;border-color:black">
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">No</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Invt</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Desc</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Unit</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Site</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 apr">April</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 mei">Mei</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 jun">Juni</th>
                        </tr>
                        <tr style="background-color:lightgreen">

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 apr">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 apr">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 apr">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 apr">PR</th>

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mei">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mei">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mei">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mei">PR</th>

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jun">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jun">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jun">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jun">PR</th>




                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in @ListPRBudget)
                        {
                            i++;
                        <tr>
                            <td style="text-align:center;border-color:black; vertical-align:middle" class="style2">@i</td>
                            <td style="vertical-align:middle;border-color:black" class="style2">@item.InvtID</td>
                            <td style="vertical-align:middle;border-color:black" class="style2">@item.Desc</td>
                            <td style="vertical-align:middle;border-color:black" class="style2">@item.Unit</td>
                            <td style="vertical-align:middle;border-color:black" class="style2">@item.Site</td>


                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 apr">@String.Format("{0,14:n0}", @item.FC04)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 apr">@String.Format("{0,14:n0}", 0)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 apr">@String.Format("{0,14:n0}", @item.PR04)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 apr">@String.Format("{0,14:n0}", @item.PO04)</td>


                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mei">@String.Format("{0,14:n0}", @item.FC05)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mei">@String.Format("{0,14:n0}", 0)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mei">@String.Format("{0,14:n0}", @item.PR05)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mei">@String.Format("{0,14:n0}", @item.PO05)</td>



                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jun">@String.Format("{0,14:n0}", @item.FC06)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jun">@String.Format("{0,14:n0}", 0)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jun">@String.Format("{0,14:n0}", @item.PR06)</td>
                            <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jun">@String.Format("{0,14:n0}", @item.PO06)</td>


                        </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>












