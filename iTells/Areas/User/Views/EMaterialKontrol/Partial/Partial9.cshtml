
@using BusinessObjects

@{

    List<BO_MaterialKontrol> ListPRBudget = (List<BO_MaterialKontrol>)ViewData["September"];
    int i = 0;

}

<div id="september" class="row">
    <div class="col-xs-12">
        <div class="box-body">
            <table id="TB9" style="border-color:black" class="table table-bordered">
                <thead>
                    <tr style="background-color:lightgreen;border-color:black">
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">No</th>
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Invt</th>
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Desc</th>
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Unit</th>
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Site</th>
                        <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Min</th>
                        <th colspan="7" style="text-align:center;vertical-align:middle;border-color:black" class="style3 sep">September</th>
                    </tr>
                    <tr style="background-color:lightgreen">


                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">FC</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">ST Awal</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">Masuk</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">Keluar</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">Balance</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">PR</th>
                        <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 sep">PO</th>




                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in @ListPRBudget)
                    {
                        i++;
                    <tr>
                        <td style="text-align:center;border-color:black; vertical-align:middle" class="style2">@i</td>
                        <td style="vertical-align:middle;border-color:black" class="style2">@item.InvtID</td>
                        <td style="vertical-align:middle;border-color:black" class="style2">@item.Desc</td>
                        <td style="vertical-align:middle;border-color:black" class="style2">@item.Unit</td>
                        <td style="vertical-align:middle;border-color:black" class="style2">@item.Site</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.STMin09)</td>


                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n0}", @item.FC09)</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.STAwal09)</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.STIN09)</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.STOut09)</td>
                        @*<td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n0}", 0)</td>*@
                        @if (@item.ST09 < @item.STMin09)
                        {
                            <td style=" background:red; text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.ST09)</td>
                        }
                        else
                        {
                            <td style=" text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n2}", @item.ST09)</td>
                        }
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n0}", @item.PR09)</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 sep">@String.Format("{0,14:n0}", @item.PO09)</td>


                    </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>













