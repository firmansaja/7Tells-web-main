
@using BusinessObjects

@{

    List<BO_Fifo_Stok> ListStok = (List<BO_Fifo_Stok>)ViewData["DataStok"];
    int i = 0;


}

<div class="row">
    <div class="col-xs-12">
        <table id="TBFIFO" style="border-color:black;width:100%" class="table table-condensed table-striped table-responsive display">
            <thead>
                <tr style="background-color:#3C8EBE;border-color:black;color:white">
                    <th style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">No</th>
                    <th style="text-align:left;vertical-align:middle;border-color:black" class="style3 ">Invt</th>
                    @*<th style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">Tanggal</th>*@
                    @*<th style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">NoLot</th>*@
                    <th style="text-align:left;vertical-align:middle;border-color:black" class="style2 jan">Gudang</th>
                    <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jan">Stok</th>
            </thead>
            <tbody>

                @foreach (var item in @ListStok)
                {
                    i++;
                    <tr>
                        <td style="text-align:center;border-color:black; vertical-align:middle" class="style2">@i</td>
                        <td style="text-align:left;border-color:black; vertical-align:middle" class="style2">@item.InvtID</td>
                        @*<td style="text-align:left;border-color:black; vertical-align:middle" class="style2">@item.Tgl</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@item.nolot</td>*@
                        <td style="text-align:left;border-color:black; vertical-align:middle" class="style2 jan">@item.gudang</td>
                        <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@String.Format("{0,14:n2}", @item.stok)</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>















