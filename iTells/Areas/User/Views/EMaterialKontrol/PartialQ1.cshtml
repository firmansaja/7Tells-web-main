


@using BusinessObjects

@{

    List<BO_MaterialKontrol> ListPRBudget = (List<BO_MaterialKontrol>)ViewData["StokMaterial"];
    int i = 0;

}

<div  id="Quarter1" class="row">
    <div class="col-xs-12">
            <div class="box-body">
                <table id="TBQ1" style="border-color:black" class="table table-bordered">
                    <thead>
                        <tr style="background-color:lightgreen;border-color:black">
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3 ">No</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Invt</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Desc</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Unit</th>
                            <th rowspan="2" style="text-align:center;vertical-align:middle;border-color:black" class="style3">Site</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 jan">Januari</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 feb">Februari</th>
                            <th colspan="4" style="text-align:center;vertical-align:middle;border-color:black" class="style3 mar">Maret</th>
                        </tr>
                        <tr style="background-color:lightgreen">

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jan">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jan">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jan">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 jan">PR</th>

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 feb">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 feb">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 feb">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 feb">PR</th>

                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mar">FC</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mar">Stok</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mar">PO</th>
                            <th style="text-align:center;vertical-align:middle;border-color:black" class="style2 mar">PR</th>

                            


                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in @ListPRBudget)
                        {
                            i++;
                            <tr>
                                <td style="text-align:center;border-color:black; vertical-align:middle" class="style2">@i</td>
                                <td style="vertical-align:middle;border-color:black" class="style2">@item.InvtID</td>
                                <td style="vertical-align:middle;border-color:black" class="style2">@item.Desc</td>
                                <td style="vertical-align:middle;border-color:black" class="style2">@item.Unit</td>
                                <td style="vertical-align:middle;border-color:black" class="style2">@item.Site</td>


                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@String.Format("{0,14:n0}", @item.FC01)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@String.Format("{0,14:n0}", 0)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@String.Format("{0,14:n0}", @item.PR01)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 jan">@String.Format("{0,14:n0}", @item.PO01)</td>



                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 feb">@String.Format("{0,14:n0}", @item.FC02)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 feb">@String.Format("{0,14:n0}", 0)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 feb">@String.Format("{0,14:n0}", @item.PR02)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 feb">@String.Format("{0,14:n0}", @item.PO02)</td>


                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mar">@String.Format("{0,14:n0}", @item.FC03)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mar">@String.Format("{0,14:n0}", 0)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mar">@String.Format("{0,14:n0}", @item.PR03)</td>
                                <td style="text-align:right;border-color:black; vertical-align:middle" class="style2 mar">@String.Format("{0,14:n0}", @item.PR03)</td>


                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>












