        function View(e) {

            var _TglAwal = $('#dtDari').datepicker("getDate");
            var _TglAkhir = $('#dtSampai').datepicker("getDate");
            var _Site = $('#filterSite').val();
            var _Fifo = $('#filterFifo').val();
            var _Account = $('#filterAccount').val();

            if (_Fifo == "") {
                alert("Select Report Fifo");
            } else if (_Site == "") {
                alert("Select Site");
            } else if (_Account == "") {
                alert("Select Account");
            } else if (_TglAwal > _TglAkhir) {
                alert("Periode Not Valid");
            } else {
                $("#tbFifo").dataTable().fnDestroy();
                DataTableFifo(_Fifo, _Site, _TglAwal, _TglAkhir, _Account)
            }
           
        }

        function ExportExcel(e) {


            var _TglAwal = $('#dtDari').datepicker("getDate");
            var _TglAkhir = $('#dtSampai').datepicker("getDate");
            var _Site = $('#filterSite').val();
            var _Fifo = $('#filterFifo').val();
            var _Account = $('#filterAccount').val();
            var _FileName = "";

            if (_Fifo == "IN") {
                _FileName = "Report_Fifo_IN.xlsx"
            }
            else {
                _FileName = "Report_Fifo_OUT.xlsx"
            }

            if (_Fifo == "") {
                alert("Select Report Fifo");
            } else if (_Site == "") {
                alert("Select Site");
            } else if (_Account == "") {
                alert("Select Account");
            } else if (_TglAwal > _TglAkhir) {
                alert("Periode Not Valid");
            } else {
                 $.ajax({
                    url: '@Url.Action("ExportExcel", "EMaterialKontrol", new { area ="User"})',
                    //contentType: "application/json; charset=utf-8",
                    dataType: "JSON",
                    type: "POST",
                    data: {
                        TglAwal: _TglAwal.toISOString(),
                        TglAkhir: _TglAkhir.toISOString(),
                        Site: _Site,
                        Fifo: _Fifo,
                        Account : _Account,
                    },
                    beforeSend: function () {
                        $('#BtnDownloadHistory').attr('disabled',true);
                    },
                    success: function (data) {
                        if (data.success) {
                            window.location.href = "@Url.RouteUrl(new { Controller = "EMaterialKontrol", Action = "Download" })/?fileName=" + _FileName;
                        }
                    },
                    complete: function () {
                        $('#BtnDownloadHistory').attr('disabled', false);
                    },
                    error: function (xhr) {
                        alert(xhr.responseText);
                    }
        });
            }

       
    }

    
        </script>
    }

