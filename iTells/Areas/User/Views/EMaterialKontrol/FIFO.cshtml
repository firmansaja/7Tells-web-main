
@{
    ViewBag.Title = "FIFO";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}




<section style="margin-bottom :0px; margin-top :0px">

    <div class="row" style="margin-bottom:0px">

        <div class="form-group col-md-12">
            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">FIFO</label>
            <div class="col-sm-2 col-md-2">

                <select id="filterFifo" class="form-control select2" style="width:100%">
                    <option value="">-Select Report-</option>
                    <option value="IN">IN</option>
                    <option value="OUT">OUT</option>
                </select>
            </div>
            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">Account</label>
            <div class="col-sm-2 col-md-2">
                <select id="filterAccount" class="form-control select2" style="width:100%">
                    <option value="">-Select Account-</option>
                    <option value="All">All</option>
                    <option value="11620">Mat Plastik</option>
                    <option value="11621">Mat Painting</option>
                    <option value="11630">Child Part</option>
                </select>
            </div>
            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">Site</label>
            <div class="col-sm-2 col-md-2">
                <select id="filterSite" class="form-control select2" style="width:100%">
                    <option value="">-Select Site-</option>
                    <option value="All">All</option>
                    <option value="TSC1">TSC1</option>
                    <option value="TSC3">TSC3</option>
                </select>
            </div>
        </div>
        <div class="form-group col-md-12">

            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">From Date</label>
            <div class="col-sm-2 col-md-2">
                <div class="input-group date" id="dtDari">
                    <input type="text" class="form-control" />
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-calendar"></span>
                    </span>
                </div>
            </div>
            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">End Date</label>
            <div class="col-sm-2 col-md-2">
                <div class="input-group date" id="dtSampai">
                    <input type="text" class="form-control" />
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-calendar"></span>
                    </span>
                </div>
            </div>
            <label class="col-sm-1 col-md-1 control-label text-muted" style="text-align:left; ">&nbsp;&nbsp;&nbsp;&nbsp;</label>
            <div class="col-lg-1">
                <button class="btn btn-success pull-right" id="btnFifo" onclick="View()"><span class="bold fa fa-search"></span>&nbsp;&nbsp;View&nbsp;&nbsp;</button>
            </div>
            <div class="col-lg-1">
                <button class="btn btn-success pull-right" id="btnExport" onclick="ExportExcel()"><span class="bold fa fa-file-excel-o"></span>&nbsp;&nbsp;Export&nbsp;&nbsp;</button>
            </div>

        </div>
    </div>

    @Html.Partial("Partial/Partial11")


</section>


