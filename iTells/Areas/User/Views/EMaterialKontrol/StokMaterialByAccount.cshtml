@section Scripts
{
    <script src="~/Scripts/aes.js"></script>
    <script type="text/javascript">


        $(document).on('click', '#BtnPlastik', function (event) {
            event.preventDefault();
            //var _tahun = "2022";
            var _tahun = $("#th_Plastik").text();
            var _account = "11620";



            //var Dept_ = EncryptURL(_Dept)
            var url = "/StokMaterial/" + EncryptURL(_tahun) + "/account/" + EncryptURL(_account);
            window.location.href = url;

        });

        $(document).on('click', '#BtnPainting', function (event) {
            event.preventDefault();
            //var _tahun = "2022";
            var _tahun = $("#th_Plastik").text();
            var _account = "11621";

            var url = "/StokMaterial/" + EncryptURL(_tahun) + "/account/" + EncryptURL(_account);
            window.location.href = url;

        });

        $(document).on('click', '#BtnChildPart', function (event) {
            event.preventDefault();
            //var _tahun = "2022";
            var _tahun = $("#th_Plastik").text();
            var _account = "11630";

            var url = "/StokMaterial/" + EncryptURL(_tahun) + "/account/" + EncryptURL(_account);
            window.location.href = url;

        });

        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }



    </script>
}
