            padding: 5px;
            border-radius: 5px;
            grid-gap: 5px;
        }

        .btn1 {
            grid-area: btn1;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .btn2 {
            grid-area: btn2;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .judul {
            grid-area: judul;
            display: flex;
            align-items: center;
            padding-left: 5px;
        }

        .packaging label {
            color: white;
        }

        .packaging button {
            border-radius: 5px;
            padding-left: 5px;
        }



        @@media (max-width:600px) {
            .packaging {
                display: grid;
                grid-template-columns: 1fr 1fr;
                grid-template-areas: 'btn1 btn2' 'judul judul';
                grid-gap: 5px;
            }
        }

    </style>
