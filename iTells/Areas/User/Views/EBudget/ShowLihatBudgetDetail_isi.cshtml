@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script>

                $(document).ready(function () {
                    $(document).ready(function () {
                        $("body").addClass("sidebar-collapse");

                        $('#tbDetailBudget').DataTable({
                            "destroy": true,
                            scrollY: "70vh",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: false,
                            //search: false,
                            bFilter: false,
                            fixedColumns: true,
                            fixedColumns: {
                                leftColumns: 2
                            }
                        });
                    })
                })

                function tdclick(data) {
                    //var Id = data.closest("tr").find("._id").val();
                    console.log(data)
                    var url = "/ShowEditData/" + data;
                    window.location.href = url;
                };

                $(document).on('click', '#btnbaru', function (event) {
                    event.preventDefault();
                    //var url = "/tambahbudget";
                    var url = "/tambahbudget/" + @AcctId + "/AcctName/" + '@AcctName' + "/Tahun/" + @Tahun + "/DeptId/" + '@dept' + "/SideID/" + '@SiteID';
                    window.location.href = url;
                });

        $(document).on('click', '#btnkembali', function (event) {
            event.preventDefault();
            var _tahun = EncryptURL(@Tahun) ;
            $.ajax({
                type: "POST",
                url: '/loadbudgetisi',
                data: { Tahun: _tahun },
                datatype: "json",
                success: function (data) {
                    window.location.href = data.redirectUrl;
                }

            });
        });

         $(document).on('click', '#btnLihat', function (event) {
            event.preventDefault();
            var row = $(this).closest('tr');
             var _keterangan = $(this).closest('tr').find('.TKet').val();
             var _TIdNo = $(this).closest('tr').find('.TIdNo').val();
             var _TTahun = $(this).closest('tr').find('.TTahun').val();
             var _TDeptID = $(this).closest('tr').find('.TDeptID').val();
             var _TAcctId = $(this).closest('tr').find('.TAcctId').val();

             var url = "/ShowEditData/" + EncryptURL(_TIdNo) + "/tahun/" + EncryptURL(_TTahun) + "/dept/" + EncryptURL(_TDeptID) + "/acctid/" + EncryptURL(_TAcctId) + "/semester/" + '@Semester';

              @*var url = "/ShowEditData/@item.IdNo/tahun/@item.Tahun/dept/@item.DeptID/acctid/@AcctId/semester/@Semester";*@
              window.location.href = url;

        });


        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }

    </script>
}









