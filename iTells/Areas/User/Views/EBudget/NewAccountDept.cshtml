            </div>

            <div class="t_dept">
                <select id="idDept" class="form-control select2" placeholder="Pilih Dept Id">

                    @foreach (var item in comboDept)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>


            <div class="l_account">
                <label class="control-label text-muted">Account</label>
            </div>

            <div class="t_account">
                <select id="acctid" class="form-control select2" placeholder="Pilih Account">
