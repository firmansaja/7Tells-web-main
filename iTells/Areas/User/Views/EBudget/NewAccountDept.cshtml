    <head>
        <style>

            /* Header Grid*/

            .hpack {
                display: grid;
                /*grid-template-columns: 100px auto 100px auto 100px;*/
                grid-template-columns: 0.3fr 0.5fr 0.3fr 1fr 0.5fr 1.3fr 0.3fr 0.7fr;
                grid-template-areas: 'judul judul judul judul judul judul judul judul' 'l_dept t_dept l_account t_account l_ket t_ket l_satuan t_satuan';
                margin-bottom: 8px;
                width: 100%;
                grid-gap: 5px;
            }

            .judul {
                grid-area: judul;
                padding-left: 6px;
                display: flex;
                align-items: center;
                justify-content:center;
                border-bottom:2px;
                border-bottom-style:solid;
            }
            .hpack .judul label{
                font-size:20px;
            }

            .l_dept {
                grid-area: l_dept;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_dept {
                grid-area: t_dept;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_account {
                grid-area: l_account;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_account {
                grid-area: t_account;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_ket {
                grid-area: l_ket;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_ket {
                grid-area: t_ket;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_satuan {
                grid-area: l_satuan;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_satuan {
                grid-area: t_satuan;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            /*Grid Table*/

            .packaging {
                display: grid;
                grid-template-columns: 1fr;
                grid-template-areas: 'contab';
                margin-bottom: 8px; /*background-color: #2E86C1;*/
                width: 100%;
                overflow: auto;
            }

            .contab {
                grid-area: contab;
                padding-left: 6px;
            }


            @@media (max-width:900px) {
                .hpack {
                    display: grid;
                    grid-template-columns: 0.5fr 0.5fr 0.5fr 1fr;
                    grid-template-areas: 'judul judul judul judul ' 'l_dept t_dept l_account t_account'' l_satuan t_satuan l_ket t_ket';
                    margin-bottom: 5px; /*background-color: #2E86C1;*/
                    width: 100%;
                    grid-gap: 5px;
                }
            }

            @@media (max-width:500px) {
                .hpack {
                    display: grid;
                    grid-template-columns: 0.35fr 1fr;
                    grid-template-areas: 'judul judul ' 'l_dept t_dept '' l_account t_account'' l_satuan t_satuan '' l_ket t_ket';
                    margin-bottom: 5px; /*background-color: #2E86C1;*/
                    width: 100%;
                    grid-gap: 5px;
                }
            }

        </style>
    </head>

