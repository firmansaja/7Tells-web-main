    var SiteID = "";
    var Tahun = "";
    var TahunOld = 0;
    var Keterangan = "";
    var Unit = "";
    var jan_qty = 0.0;
    var feb_qty = 0.0;
    var mar_qty = 0.0;
    var apr_qty = 0.0;
    var mei_qty = 0.0;
    var jun_qty = 0.0;
    var jul_qty = 0.0;
    var agt_qty = 0.0;
    var sep_qty = 0.0;
    var okt_qty = 0.0;
    var nov_qty = 0.0;
    var des_qty = 0.0;
    var jan_harga = 0.0;
    var feb_harga = 0.0;
    var mar_harga = 0.0;
    var apr_harga = 0.0;
    var mei_harga = 0.0;
    var jun_harga = 0.0;
    var jul_harga = 0.0;
    var agt_harga = 0.0;
    var sep_harga = 0.0;
    var okt_harga = 0.0;
    var nov_harga = 0.0;
    var des_harga = 0.0;

    foreach (var BudgetOpenItem in BudgetOpen)
    {
        Semester = BudgetOpenItem.OpenSemester;
        tahunopen = BudgetOpenItem.OpenTahun;
        statusOpen = BudgetOpenItem.OpenStatus;
    }


    foreach (var budget in Budget)
    {
        AcctID = budget.AcctID;
        AcctName = budget.AcctName;
        DeptID = budget.DeptID;
        Tahun = budget.Tahun;
        SiteID = budget.SiteID;
        Tahun = budget.Tahun;
        //TahunOld = Convert.ToInt32(budget.Tahun);
