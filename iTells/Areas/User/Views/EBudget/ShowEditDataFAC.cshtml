    @section scripts{
        <script src="~/Scripts/aes.js"></script>
        <script type="text/javascript">

            $(document).ready(function () {
                $("body").addClass("sidebar-collapse");
                $("#btnsimpan").addClass("hidden");
                var Deptlogin = "";
                Deptlogin = '@Cuserdept';
                if (Deptlogin == '1FAC' || Deptlogin == '1MIS') {
                    $("#btnsimpan").removeClass("hidden");
                }

                $('.price').trigger('keyup');
                var CekStatus = '@OpenStatus';
                if (CekStatus == 'Close') {
                    alert("Budget Sudah ditutup")
                    var url = '@Url.Action("Index", "EBudget", new { area = "User" })';
                    window.location.href = url;
                }
                else {
                      if (@Semester == 2) {

                    $("#jan_harga").prop("readonly", true);
                    $("#jan_qty").prop("readonly", true);

                    $("#feb_harga").prop("readonly", true);
                    $("#feb_qty").prop("readonly", true);

                    $("#mar_harga").prop("readonly", true);
                    $("#mar_qty").prop("readonly", true);

                    $("#apr_harga").prop("readonly", true);
                    $("#apr_qty").prop("readonly", true);

                    $("#mei_harga").prop("readonly", true);
                    $("#mei_qty").prop("readonly", true);

                    $("#jun_harga").prop("readonly", true);
                    $("#jun_qty").prop("readonly", true);
                }
                }
            });


            $(document).on('click', '#btnsimpan', function (event) {
                event.preventDefault();
                var barang = $("#barang").val();
                var satuan = $("#satuan").val();

                if (barang == "") {
                    alert("Description Jangan Kosong")
                }
                else if (satuan == "") {
                    alert("Satuan Jangan Kosong")
                }

                else {


                    var data = {};

                    data.AcctID = '@AcctID';
                    data.AcctName = '@AcctName';
                    data.Tahun = '@Tahun';
                    data.DeptID = '@DeptID';
                    data.Keterangan = barang;
                    data.Unit = satuan;
                    data.IdNo = @IdNo;
                    data.SiteID = '@SiteID';


                    data.jan_qty = $("#jan_qty").val().replace(/\,/g, '');
                    data.jan_harga = $("#jan_harga").val().replace(/\,/g, '');

                    data.feb_qty = $("#feb_qty").val().replace(/\,/g, '');
                    data.feb_harga = $("#feb_harga").val().replace(/\,/g, '');

                    data.mar_qty = $("#mar_qty").val().replace(/\,/g, '');
                    data.mar_harga = $("#mar_harga").val().replace(/\,/g, '');

                    data.apr_qty = $("#apr_qty").val().replace(/\,/g, '');
                    data.apr_harga = $("#apr_harga").val().replace(/\,/g, '');

                    data.mei_qty = $("#mei_qty").val().replace(/\,/g, '');
                    data.mei_harga = $("#mei_harga").val().replace(/\,/g, '');

                    data.jun_qty = $("#jun_qty").val().replace(/\,/g, '');
                    data.jun_harga = $("#jun_harga").val().replace(/\,/g, '');

                    data.jul_qty = $("#jul_qty").val().replace(/\,/g, '');
                    data.jul_harga = $("#jul_harga").val().replace(/\,/g, '');

                    data.agt_qty = $("#agt_qty").val().replace(/\,/g, '');
                    data.agt_harga = $("#agt_harga").val().replace(/\,/g, '');

                    data.sep_qty = $("#sep_qty").val().replace(/\,/g, '');
                    data.sep_harga = $("#sep_harga").val().replace(/\,/g, '');

                    data.okt_qty = $("#okt_qty").val().replace(/\,/g, '');
                    data.okt_harga = $("#okt_harga").val().replace(/\,/g, '');

                    data.nov_qty = $("#nov_qty").val().replace(/\,/g, '');
                    data.nov_harga = $("#nov_harga").val().replace(/\,/g, '');

                    data.des_qty = $("#des_qty").val().replace(/\,/g, '');
                    data.des_harga = $("#des_harga").val().replace(/\,/g, '');

                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("SimpanBudget_FAC", "EBudget", new { area ="User"})',
                        data: { data: data },
                        //datatype: "json",
                        success: function (data_) {
                            //console.log(data_);
                            if (data_.success) {
                                alert(data_.message)
                                var url = "/showBudgetDetail/" + EncryptURL(data_.account) + "/Tahun/" + EncryptURL(data_.tahun) + "/Dept/" + EncryptURL(data_.dept);
                                window.location.href = url;
                            }
                            else {
                                alert(data_.message)
                                var url = "/showBudgetDetail/" + EncryptURL(data_.account) + "/Tahun/" + EncryptURL(data_.tahun) + "/Dept/" + EncryptURL(data_.dept);
                                window.location.href = url;
                            }
                        }

                    });
                }
            });



            $(document).on('click', '#btnkembali', function (event) {
                event.preventDefault();
                var url = "/showBudgetDetail/" + EncryptURL('@AcctID') + "/Tahun/" + EncryptURL('@Tahun') + "/Dept/" + EncryptURL('@DeptID');
                window.location.href = url;
            });



            $('.price').on('keyup', function () {


                var val = +$(this).val().replace(/\,/g, '');
                var valSibling = +$(this).parent().siblings('td').find('.price').val().replace(/\,/g, '');

                if (isNaN(val) || isNaN(valSibling))
                    return;
                var n = val * valSibling

                console.log(n.toLocaleString());
                $(this).parent().siblings('td').find('.total').val(n.toLocaleString());

                var jan = Number($('#totaljan').val().replace(/\,/g, ''));
                var feb = Number($('#totalfeb').val().replace(/\,/g, ''));
                var mar = Number($('#totalmar').val().replace(/\,/g, ''));
                var apr = Number($('#totalapr').val().replace(/\,/g, ''));
                var mei = Number($('#totalmei').val().replace(/\,/g, ''));
                var jun = Number($('#totaljun').val().replace(/\,/g, ''));

                var jul = Number($('#totaljul').val().replace(/\,/g, ''));
                var ags = Number($('#totalagt').val().replace(/\,/g, ''));
                var sept = Number($('#totalsep').val().replace(/\,/g, ''));
                var okt = Number($('#totalokt').val().replace(/\,/g, ''));
                var nov = Number($('#totalnov').val().replace(/\,/g, ''));
                var des = Number($('#totaldes').val().replace(/\,/g, ''));

                var semester1 = jan + feb + mar + apr + mei + jun;
                var semester2 = jul + ags + sept + okt + nov + des;

                $('.totalS1').val(semester1.toLocaleString());
                $('.totals2').val(semester2.toLocaleString());
                $('.finaltotal').val((semester1 + semester2).toLocaleString());

            });

            $(function () {
                $('.number').each(function () { $(this).attr('type', 'number'); });
            });

            function format(inp) {
                var start = inp.selectionStart,  // get the selection start
                    end = inp.selectionEnd;    // and end, as per the linked post
                var s1 = inp.value.split(",").length - 1; //count the commas before edit
                inp.value = numberWithCommas(inp.value.replace(/,|[^\d.]/g, ''));
                var s2 = inp.value.split(",").length - s1 - 1; //count the commas after edit so as to know where to place the cursor, as the position changes, if there are new commas or some commas have been removed
                inp.setSelectionRange(start + s2, end + s2); // set the selection start and end, as per the linked post
            }
            function numberWithCommas(str) {
                var a = str.split('.');
                var p = /\B(?=(\d{3})+(?!\d))/g;
                if (a.length > 1)
                    return a[0].toString().replace(p, ",") + "." + a[1];
                else
                    return str.toString().replace(p, ",");
            }

            function EncryptURL(obj) {
                var key = CryptoJS.enc.Utf8.parse("8080808080808080");
                var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

                var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                    {
                        keySize: 128 / 8,
                        iv: iv,
                        mode: CryptoJS.mode.CBC,
                        padding: CryptoJS.pad.Pkcs7
                    });
                var encryptedString = encrypted.toString(CryptoJS.format.Hex);
                encryptedString = encryptedString.replace(/\//g, " ");
                encryptedString = encryptedString.replace(/\+/g, "-");
                return encryptedString
            }


        </script>

    }
