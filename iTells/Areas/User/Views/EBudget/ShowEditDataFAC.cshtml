    <head>


        <style>

            /* Header Grid*/

            .hpack {
                display: grid;
                grid-template-columns: 100px 1fr 100px 1.5fr 100px 100px;
                grid-template-areas: 'judul judul judul judul judul judul' 'l_account t_account l_ket t_ket l_satuan t_satuan';
                margin-bottom: 8px; /*background-color: #2E86C1;*/
                width: 100%;
                grid-gap: 5px;
            }

            .judul {
                grid-area: judul;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_account {
                grid-area: l_account;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_account {
                grid-area: t_account;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_ket {
                grid-area: l_ket;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_ket {
                grid-area: t_ket;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .l_satuan {
                grid-area: l_satuan;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            .t_satuan {
                grid-area: t_satuan;
                padding-left: 6px;
                display: flex;
                align-items: center;
                color: white;
            }

            /*Grid Table*/

            .packaging {
                display: grid;
                grid-template-columns: 1fr;
                grid-template-areas: 'contab';
                margin-bottom: 8px; /*background-color: #2E86C1;*/
                width: 100%;
                overflow: auto;
            }

            .contab {
                grid-area: contab;
                padding-left: 6px;
            }


            @@media (max-width:900px) {
                .hpack {
                    display: grid;
                    grid-template-columns: 90px 1fr;
                    grid-template-areas: 'judul judul' 'l_account t_account' ' l_ket t_ket' 'l_satuan t_satuan';
                    margin-bottom: 5px; /*background-color: #2E86C1;*/
                    width: 100%;
                    grid-gap: 5px;
                }
            }
        </style>
    </head>

