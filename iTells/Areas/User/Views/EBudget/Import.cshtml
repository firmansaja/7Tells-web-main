@section scripts{
    <script>

        $(document).ready(function () {
            $("body").addClass("sidebar-collapse");
                $(document).ready(function () {
                    $('#loading').hide()
                    $('#LB').DataTable({
                        "destroy": true,
                        scrollY: "400px",
                        scrollX: true,
                        scrollCollapse: false,
                        paging: false,
                        //search: false,
                        bFilter: false,
                        fixedColumns: true,
                        fixedColumns: {
                            leftColumns: 2
                        }
                    });
                })
            })

            function tdclick(data) {
                //var Id = data.closest("tr").find("._id").val();
                console.log(data)
                var url = "/ShowEditData/" + data;
                window.location.href = url;
            };

            $(document).on('click', '#btnsimpan', function (event) {
                event.preventDefault();
                //mloading();
                var cek = true;

                $("#LB TBODY TR").each(function () {
                    var row = $(this);
                    if (row.find("TD").eq(2).html().toString().trim() == ""
                        || row.find("TD").eq(3).html().toString().trim() == ""
                        || row.find("TD").eq(4).html().toString().trim() == ""
                        || row.find("TD").eq(5).html().toString().trim() == ""
                        || row.find("TD").eq(6).html().toString().trim() == ""
                        || row.find("TD").eq(6).html() != '@tahun'
                        || row.find("TD").eq(7).html().toString().trim() == ""
                        //|| row.find("TD").eq(8).html().toString().trim() == ""
                        || (row.find("TD").eq(9).html()).match(/\d/g) == null
                        || (row.find("TD").eq(10).html()).match(/\d/g) == null
                        || (row.find("TD").eq(11).html()).match(/\d/g) == null
                        || (row.find("TD").eq(12).html()).match(/\d/g) == null
                        || (row.find("TD").eq(13).html()).match(/\d/g) == null
                        || (row.find("TD").eq(14).html()).match(/\d/g) == null
                        || (row.find("TD").eq(15).html()).match(/\d/g) == null
                        || (row.find("TD").eq(16).html()).match(/\d/g) == null
                        || (row.find("TD").eq(17).html()).match(/\d/g) == null
                        || (row.find("TD").eq(18).html()).match(/\d/g) == null
                        || (row.find("TD").eq(19).html()).match(/\d/g) == null
                        || (row.find("TD").eq(20).html()).match(/\d/g) == null
                        || (row.find("TD").eq(21).html()).match(/\d/g) == null
                        || (row.find("TD").eq(22).html()).match(/\d/g) == null
                        || (row.find("TD").eq(23).html()).match(/\d/g) == null
                        || (row.find("TD").eq(24).html()).match(/\d/g) == null
                        || (row.find("TD").eq(25).html()).match(/\d/g) == null
                        || (row.find("TD").eq(26).html()).match(/\d/g) == null
                        || (row.find("TD").eq(26).html()).match(/\d/g) == null
                        || (row.find("TD").eq(27).html()).match(/\d/g) == null
                        || (row.find("TD").eq(28).html()).match(/\d/g) == null
                        || (row.find("TD").eq(29).html()).match(/\d/g) == null
                        || (row.find("TD").eq(30).html()).match(/\d/g) == null
                        || (row.find("TD").eq(31).html()).match(/\d/g) == null
                        || (row.find("TD").eq(32).html()).match(/\d/g) == null )
                    {
                        cek = false;
                        return;
                    }
                });
                console.log(@tahun);
                if (cek == true) {
                    var Budget = new Array();

                    $("#LB TBODY TR").each(function () {
                        var row = $(this);
                        var data = {};
                        data.IdNo = (row.find("TD").eq(1).html()).replace(/^\s+|\s+$/gm, '');
                        data.AcctID = (row.find("TD").eq(2).html()).replace(/^\s+|\s+$/gm, '');
                        data.AcctName = (row.find("TD").eq(3).html()).replace(/^\s+|\s+$/gm, '');
                        data.DeptID = (row.find("TD").eq(4).html()).replace(/^\s+|\s+$/gm, '');
                        data.SiteID = (row.find("TD").eq(5).html()).replace(/^\s+|\s+$/gm, '');
                        data.Tahun = (row.find("TD").eq(6).html()).replace(/^\s+|\s+$/gm, '');
                        data.Keterangan = (row.find("TD").eq(7).html()).replace(/^\s+|\s+$/gm, '');
                        data.Unit = (row.find("TD").eq(8).html()).replace(/^\s+|\s+$/gm, '');

                        data.jan_qty = row.find("TD").eq(9).html();
                        data.feb_qty = row.find("TD").eq(10).html();
                        data.mar_qty = row.find("TD").eq(11).html();
                        data.apr_qty = row.find("TD").eq(12).html();
                        data.mei_qty = row.find("TD").eq(13).html();
                        data.jun_qty = row.find("TD").eq(14).html();
                        data.jul_qty = row.find("TD").eq(15).html();
                        data.agt_qty = row.find("TD").eq(16).html();
                        data.sep_qty = row.find("TD").eq(17).html();
                        data.okt_qty = row.find("TD").eq(18).html();
                        data.nov_qty = row.find("TD").eq(19).html();
                        data.des_qty = row.find("TD").eq(20).html();

                        data.jan_harga = row.find("TD").eq(21).html();
                        data.feb_harga = row.find("TD").eq(22).html();
                        data.mar_harga = row.find("TD").eq(23).html();
                        data.apr_harga = row.find("TD").eq(24).html();
                        data.mei_harga = row.find("TD").eq(25).html();
                        data.jun_harga = row.find("TD").eq(26).html();
                        data.jul_harga = row.find("TD").eq(27).html();
                        data.agt_harga = row.find("TD").eq(28).html();
                        data.sep_harga = row.find("TD").eq(29).html();
                        data.okt_harga = row.find("TD").eq(30).html();
                        data.nov_harga = row.find("TD").eq(31).html();
                        data.des_harga = row.find("TD").eq(32).html();

                        Budget.push(data);
                    });
                    var data = {
                        BD : Budget,
                        OpenTahun: '@tahun',
                        OpenSemester : '@semester'

                    }
                    //console.log(data);
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("Simpan_Upload", "EBudget", new { area ="User"})',
                        data: { data: data },
                        success: function (r) {
                            alert("Update Berhasil");
                            window.location.href = "/ebudget_import/" + @tahun + "/Semester/" + @semester;
                        }
                    });
                } else {
                    alert("Inputan Ada yang Salah")
                }

            })

        //$(document).on('click', '#btnupload', function (event) {
        //    event.preventDefault();
        //    mloading();
        //})

        function mloading() {
            $("#mloading").modal({ backdrop: 'static' });
        }

    </script>
}










