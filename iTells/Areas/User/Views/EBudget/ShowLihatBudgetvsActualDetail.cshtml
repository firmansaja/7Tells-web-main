@section scripts{
    <script src="~/Scripts/aes.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $("body").addClass("sidebar-collapse");
                $('#LB').DataTable({
                    "destroy": true,
                    scrollY: "70vh",
                    scrollX: true,
                    scrollCollapse: true,
                    paging: false,
                    info: false,
                    search: false,
                    autoWidth: false,
                    columnDefs: [
                        { width: '5%', targets: 1 }
                    ],
                    fixedColumns: true,
                    fixedColumns: {
                        leftColumns: 2
                    }
                });
            $("#btnExportDetailByAccout").addClass("hidden");
            var Deptlogin = "";
            Deptlogin = '@Cuserdept';
            if (Deptlogin == '1FAC' || Deptlogin == '3FAC' || Deptlogin == '1MIS') {
                $("#btnExportDetailByAccout").removeClass("hidden");
            }
        })

        $(document).on('click', '#btnExport', function (event) {
            event.preventDefault();

             var _tahun = '@Tahun';
             var _dept = '@dept'
            var _Account = '@AcctId'

            $.ajax({
                    type: "POST",
                    url: '@Url.Action("CreateDataToExcel_BudgetDetail", "EBudget", new { area ="User"})',
                data: {
                    tahun: _tahun,
                    dept: _dept,
                    account: _Account },
                    //datatype: "json",
                    success: function (data_) {
                        console.log(data_);
                        if (data_.success) {
                            window.location.href = "@Url.RouteUrl(new { Controller = "EBudget", Action = "Download" })/?fileName=" + data_.namafile;
                        }
                        else {
                            alert("Download GAGAL")
                        }
                    }

                });

        });


         $(document).on('click', '#btnExportDetail', function (event) {
            event.preventDefault();

            var tahun = @Tahun;

            $.ajax({
                    type: "POST",
                    url: '@Url.Action("CreateDataToExcel_SummaryDept_Detail", "EBudget", new { area ="User"})',
                data: { tahun : tahun  },
                    //datatype: "json",
                    success: function (data_) {
                        console.log(data_);
                        if (data_.success) {
                            window.location.href = "@Url.RouteUrl(new { Controller = "EBudget", Action = "Download" })/?fileName=" + data_.namafile;
                        }
                        else {
                            alert("Download GAGAL")
                        }
                    }

                });

         });

         $(document).on('click','#btnExportDetailByAccout', function (event) {
             event.preventDefault();

            var _tahun = '@Tahun';
            var _dept = '@dept'
            var _Account = '@AcctId'

            $.ajax({
                    type: "POST",
                    url: '@Url.Action("CreateDataToExcel_Detail_ByAccount", "EBudget", new { area ="User"})',
                data: {
                    tahun: _tahun,
                    dept: _dept,
                    account: _Account
                    },
                    //datatype: "json",
                    success: function (data_) {
                        console.log(data_);
                        if (data_.success) {
                            window.location.href = "@Url.RouteUrl(new { Controller = "EBudget", Action = "Download" })/?fileName=" + data_.namafile;
                        }
                        else {
                            alert("Download GAGAL")
                        }
                    }

                });

         });

         $(document).on('click', '#btnKembali', function (event) {
            event.preventDefault();
             var _tahun = '@Tahun';
             var _dept = '@dept'
             var _Account = '@AcctId'

             var url = "@Url.RouteUrl(new { Controller = "EBudget", Action = "LihatBudgetPresentasi"})/?Tahun=" + EncryptURL(_tahun) + "&DeptId=" + EncryptURL(_dept);
            window.location.href = url;
         });

        function EncryptURL(obj) {
            var key = CryptoJS.enc.Utf8.parse("8080808080808080");
            var iv = CryptoJS.enc.Utf8.parse("8080808080808080");

            var encrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(obj), key,
                {
                    keySize: 128 / 8,
                    iv: iv,
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });
            var encryptedString = encrypted.toString(CryptoJS.format.Hex);
            encryptedString = encryptedString.replace(/\//g, " ");
            encryptedString = encryptedString.replace(/\+/g, "-");
            return encryptedString
        }
    </script>
}

