@using BusinessObjects;
@model List<BO_EBudget>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    List<CurrentLogin> Userlogin = (List<CurrentLogin>)ViewData["userlogin"];
    List<BO_EBudget> BudgetOpen = (List<BO_EBudget>)ViewData["ListBudgetOpen"];

    int i = 0;
    var AcctId = "";
    var AcctName = "";
    var Tahun = "";
    var dept = "";
    var SiteID = "";
    var Semester = "";
    var status = "";
    var Cuserlogin = "";
    var Cuserdept = "";
}

@foreach (var CurrentLogin in Userlogin)
{
    Cuserlogin = CurrentLogin.UserName;
    Cuserdept = CurrentLogin.Dept;
}

@foreach (var H_item in Model)
{
    AcctId = H_item.AcctID;
    AcctName = H_item.AcctName;
    Tahun = H_item.Tahun;
    dept = H_item.DeptID;
    SiteID = H_item.SiteID;
}

@foreach (var BudgetOpenItem in BudgetOpen)
{
    Semester = BudgetOpenItem.OpenSemester;
    status = BudgetOpenItem.OpenStatus;
}

<head>
    <style>
        .packaging {
            display: grid;
            grid-template-columns: 100px 100px 100px 100px 1fr;
            grid-template-areas: 'btn1 btn2 btn3 btn4 judul';
            margin-bottom: 5px;
            background-color: #2E86C1;
            padding: 5px;
            border-radius: 5px;
            grid-gap: 5px;
        }

        .btn1 {
            grid-area: btn1;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .btn2 {
            grid-area: btn2;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .btn3 {
            grid-area: btn3;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .btn4 {
            grid-area: btn4;
            padding-left: 6px;
            display: flex;
            align-items: center;
            color: white;
        }

        .judul {
            grid-area: judul;
            display: flex;
            align-items: center;
            padding-left: 5px;
        }

        .packaging button {
            border-radius: 5px;
            padding-left: 5px;
        }

        .packaging .judul {
            color: white;
        }

        @@media (max-width:600px) {
            .packaging {
                display: grid;
                grid-template-columns: 1fr 1fr;
                grid-template-areas: 'btn1 btn2' 'btn3 btn4' 'judul judul';
                grid-gap: 5px;
            }
        }

        th {
            font-size: 16px;
        }

        td {
            font-size: 16px;
        }
    </style>
</head>

<div id="MainForm">
    <div class="row">
        <div class="col-md-12 " id="div2">
            <div class="packaging">
                <button class="btn1 btn btn-warning margin-r-5" id="btnKembali">Kembali</button>
                <button class="btn2 btn btn-success margin-r-5" id="btnExport">Export</button>
                <button class="btn3 btn btn-success margin-r-5" id="btnExportDetail">All</button>
                <button class="btn4 btn btn-success margin-r-5" id="btnExportDetailByAccout">All By Acct</button>
                <label class="judul control-label text-muted">@ViewBag.title</label>
            </div>
        </div>
    </div>
</div>

