                            { "title": "DeptID", "data": "DeptID", "width": "70px", "class": "text-center dept" },
                            { "title": "Jan Budget", "data": "JanBudget", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Jan Actual", "data": "JanActual", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Feb Budget", "data": "FebBudget", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Feb Actual", "data": "FebActual", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Mar Budget", "data": "MarBudget", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Mar Actual", "data": "MarActual", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Apr Budget", "data": "AprBudget", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Apr Actual", "data": "AprActual", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
                            { "title": "Mei Budget", "data": "MeiBudget", "class": "text-right", render: $.fn.dataTable.render.number(',', '.', 0)},
